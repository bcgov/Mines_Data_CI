{
  "properties": {
    "jobMode": "Batch",
    "source": {
      "type": "{{.source_type}}Table",
      "connectionSettings": {
        "type": "{{.source_type}}",
        "typeProperties": {
          "database": "{{.source_database}}"
        },
        "externalReferences": {
          "connection": "{{.source_connection_id}}"
        }
      }
    },
    "destination": {
      "type": "DataWarehouseTable",
      "connectionSettings": {
        "type": "DataWarehouse",
        "typeProperties": {
          "workspaceId": "{{.sink_workspace_id}}",
          "artifactId": "{{.sink_warehouse_id}}"
        }
      }
    },
    "policy": {
      "timeout": "0.12:00:00",
      "retry": 0
    }
  },
  "activities": {{.activities_json}}
}