      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "definition": {
              "pipeline-content.json": {
                "parameters": null,
                "processing_mode": "GoTemplate",
                "source": "../modules/azure/fabric_data_pipeline/pipeline-content.json.tmpl",
                "source_content_sha256": "ab72e2ee87af253bd70569bc71e5ce36478a697ef0d910da0fae0458296dfc3b",
