      "module": "module.pipeline_raw_to_bronze",
      "mode": "managed",
      "type": "fabric_data_pipeline",
      "name": "this",
      "provider": "provider[\"registry.terraform.io/microsoft/fabric\"].auth",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "definition": {
              "pipeline-content.json": {
                "parameters": null,
                "processing_mode": "GoTemplate",
                "source": "../modules/azure/fabric_data_pipeline/pipeline-content.json.tmpl",
                "source_content_sha256": "0cc2e69a55e9b8cb158c4ca1c4be05ae2699430019b0c35eddccc27988d43701",
                "tokens": {
                  "activities_json": "[{\"dependsOn\":[],\"name\":\"Lookup_ControlTable\",\"policy\":{\"retry\":0,\"retryIntervalInSeconds\":30,\"secureInput\":false,\"secureOutput\":false,\"timeout\":\"0.12:00:00\"},\"type\":\"Lookup\",\"typeProperties\":{\"datasetSettings\":{\"annotations\":[],\"externalReferences\":{\"connection\":\"a69f69eb-19e0-4878-99b8-c47080ba64d2\"},\"schema\":[],\"type\":\"AzureSqlTable\",\"typeProperties\":{\"database\":\"mines-data-platform-fabwh1\",\"schema\":\"app\",\"table\":\"pipeline_control\"}},\"firstRowOnly\":false,\"source\":{\"datasetSettings\":{\"annotations\":[],\"externalReferences\":{\"connection\":\"a69f69eb-19e0-4878-99b8-c47080ba64d2\"},\"schema\":[],\"type\":\"DataWarehouseTable\",\"typeProperties\":{\"schema\":\"app\",\"table\":\"pipeline_control\"}},\"partitionOption\":\"None\",\"queryTimeout\":\"02:00:00\",\"sqlReaderQuery\":{\"type\":\"Expression\",\"value\":\"@concat('SELECT control_id, pipeline_name, source_system, source_entity, target_schema, target_table, source_query_template, watermark_column, last_watermark, load_type, priority, from_date, to_date FROM [app].[pipeline_control] WHERE [pipeline_name] = ''', pipeline().parameters.pipeline_name, ''' AND [is_active] = 1 ', if(empty(pipeline().parameters.table_filter_csv), '', concat('AND [target_table] IN (''', replace(pipeline().parameters.table_filter_csv, ',', ''','''), ''') ')), 'ORDER BY [priority] ASC')\"},\"type\":\"AzureSqlSource\"}}},{\"dependsOn\":[{\"activity\":\"Lookup_ControlTable\",\"dependencyConditions\":[\"Succeeded\"]}],\"name\":\"ForEach_ControlRows\",\"type\":\"ForEach\",\"typeProperties\":{\"activities\":[{\"dependsOn\":[],\"externalReferences\":{\"connection\":\"a69f69eb-19e0-4878-99b8-c47080ba64d2\"},\"name\":\"Log_Start\",\"policy\":{\"retry\":5,\"retryIntervalInSeconds\":30,\"secureInput\":false,\"secureOutput\":false,\"timeout\":\"0.00:05:00\"},\"type\":\"Script\",\"typeProperties\":{\"scriptBlockExecutionTimeout\":\"02:00:00\",\"scripts