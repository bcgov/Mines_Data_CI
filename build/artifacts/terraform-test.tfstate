                "tokens": {
                  "activities_json": "[{\"dependsOn\":[],\"description\":\"Raw parquet (pl_ingest_mds / pl_ingest_mto) -\\u003e bronze delta tables\",\"name\":\"Bronze_Load\",\"policy\":{\"retry\":0,\"retryIntervalInSeconds\":30,\"secureInput\":false,\"secureOutput\":false,\"timeout\":\"0.12:00:00\"},\"type\":\"TridentNotebook\",\"typeProperties\":{\"notebookId\":\"96eb9b83-2d9d-4578-876c-45cdb9d5cb0f\",\"workspaceId\":\"f278f380-2e39-4a1b-96d8-43f653ebc043\"}},{\"dependsOn\":[{\"activity\":\"Bronze_Load\",\"dependencyConditions\":[\"Succeeded\"]}],\"description\":\"Rebuild app.object_registry from app.pipeline_control\",\"name\":\"Silver_Registry\",\"policy\":{\"retry\":0,\"retryIntervalInSeconds\":30,\"secureInput\":false,\"secureOutput\":false,\"timeout\":\"0.12:00:00\"},\"type\":\"TridentNotebook\",\"typeProperties\":{\"notebookId\":\"22b44748-b4a7-44e9-8edb-d26e5c62606d\",\"workspaceId\":\"f278f380-2e39-4a1b-96d8-43f653ebc043\"}},{\"dependsOn\":[{\"activity\":\"Silver_Registry\",\"dependencyConditions\":[\"Succeeded\"]}],\"description\":\"Bronze -\\u003e silver (dedupe, types, primary keys)\",\"name\":\"Silver_Build\",\"policy\":{\"retry\":0,\"retryIntervalInSeconds\":30,\"secureInput\":false,\"secureOutput\":false,\"timeout\":\"0.12:00:00\"},\"type\":\"TridentNotebook\",\"typeProperties\":{\"notebookId\":\"91ab54b2-1e72-4642-ac2c-1565e0c58cb4\",\"workspaceId\":\"f278f380-2e39-4a1b-96d8-43f653ebc043\"}},{\"dependsOn\":[{\"activity\":\"Silver_Build\",\"dependencyConditions\":[\"Succeeded\"]}],\"description\":\"Silver -\\u003e all gold dims and facts (plan in nb_gold_config)\",\"name\":\"Gold_Build\",\"policy\":{\"retry\":0,\"retryIntervalInSeconds\":30,\"secureInput\":false,\"secureOutput\":false,\"timeout\":\"0.12:00:00\"},\"type\":\"TridentNotebook\",\"typeProperties\":{\"notebookId\":\"950487e1-1bb8-49da-b10b-cbe5b232b868\",\"workspaceId\":\"f278f380-2e39-4a1b-96d8-43f653ebc043\"}}]"
                },
                "tokens_delimiter": "{{}}"
              }
            },
            "definition_update_enabled": true,
            "description": "Bronze → silver → gold → Gold model refresh. Run after pl_ingest_mds.",
