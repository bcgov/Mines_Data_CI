	partition 'NoW Application Delay-f233effa-a4c0-4978-be5d-e848af101970' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("mds-reporting-pg13-live.postgres.database.azure.com", "mds"), "select #(lf)    nad.now_application_guid,#(lf)    delay_id,#(lf)    enddate,#(lf)    startdate,#(lf)    nad.delay_type_code,#(lf)    nadt.description, #(lf)    nad.start_comment,#(lf)    Delay_Duration from (#(lf)select now_application_guid,max(now_application_delay_id) as Delay_id,max(end_date) as EndDate,min(start_date) as StartDate,sum(DATE_PART('day', end_date-start_date)) As Delay_Duration#(lf)from now_application_delay na#(lf)group by now_application_guid#(lf))  nowdelay_metric  left join now_application_delay nad on nad.now_application_delay_id=Delay_id #(lf)left join now_application_delay_type nadt on nadt.delay_type_code=nad.delay_type_code ", null, [EnableFolding=false]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"enddate", type date}, {"startdate", type date}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type",{{"delay_duration", "delay_duration (days)"}})
				in
				    #"Renamed Columns"

