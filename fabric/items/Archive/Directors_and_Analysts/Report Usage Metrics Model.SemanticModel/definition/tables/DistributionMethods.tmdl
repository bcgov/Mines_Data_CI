table DistributionMethods

	column OwnerTenantGuid
		dataType: string
		isHidden
		sourceProviderType: varchar(36)
		sourceColumn: OwnerTenantGuid

	column OwnerUserGuid
		dataType: string
		isHidden
		sourceProviderType: varchar(36)
		sourceColumn: OwnerUserGuid

	column OwnerGroupGuid
		dataType: string
		isHidden
		sourceProviderType: varchar(36)
		sourceColumn: OwnerGroupGuid

	column Name
		dataType: string
		sourceProviderType: nvarchar
		sourceColumn: Name

	partition Usage_ReportDistributionMethods = query
		dataView: full
		source
			query =
				SELECT [Viewers].[Usage_ReportDistributionMethods].*
				FROM [Viewers].[Usage_ReportDistributionMethods]
				WHERE [Viewers].[Usage_ReportDistributionMethods].[OwnerTenantGuid] IS NULL OR ([Viewers].[Usage_ReportDistributionMethods].[OwnerTenantGuid] = '6fdb5200-3d0d-4a8a-b036-d3685e359adc' AND ([Viewers].[Usage_ReportDistributionMethods].[OwnerGroupGuid] = '842a168e-d34c-4d96-b839-aba622d26cf8' OR [Viewers].[Usage_ReportDistributionMethods].[OwnerUserGuid] = ''))
			dataSource: bd7c0be5-4f36-44e9-bc91-20679d41615b

