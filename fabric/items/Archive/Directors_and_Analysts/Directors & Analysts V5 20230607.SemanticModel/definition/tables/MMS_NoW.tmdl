	partition MMS_NoW-a6f4c031-c305-4b00-898b-edca30035e25 = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("mds-reporting-pg13-live.postgres.database.azure.com", "mds", [CreateNavigationProperties=false]), "select id,application_guid ,messageid ,mms_cid ,minenumber ,noticeofworktype , #(lf)(select case #(lf)#(tab)when noticeofworktype = 'Mineral' then 'M' #(lf)#(tab)when noticeofworktype = 'Sand & Gravel' then 'G'#(tab)#(lf)#(tab)when noticeofworktype = 'Placer Operations' then 'P' end) as permit_prefix,#(lf)#(tab)(select case #(lf)#(tab)when noticeofworktype = 'Mineral' then 'MIN' #(lf)#(tab)when noticeofworktype = 'Sand & Gravel' then 'SAG'#(tab)#(lf)#(tab)when noticeofworktype = 'Placer Operations' then 'PLA' end) as noticeofworktypecode,#(lf)mmsnownumber,submitteddate , receiveddate,proposedstartdate ,proposedenddate ,typeofapplication,#(lf)status ,latitude, longitude,'MMS' Sources#(lf)from mms_now_submissions.application a#(lf)where extract(year from submitteddate) >= 2000 ", null, [EnableFolding=false]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"submitteddate", type date}, {"receiveddate", type date}, {"proposedstartdate", type date}, {"proposedenddate", type date}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

