	partition 'NoW All-3aa2eece-e4a7-45a7-90a9-12e57f586a7f' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("mds-reporting-pg13-live.postgres.database.azure.com", "mds"), "select * from(#(lf)select id,nai.now_application_guid,minenumber ,mine_guid,mmsnownumber,submitteddate , receiveddate,proposedstartdate ,proposedenddate ,typeofapplication,#(lf)status ,latitude, longitude,(select case #(lf)#(tab)when a.noticeofworktype = 'Mineral' then 'MIN' #(lf)#(tab)when a.noticeofworktype = 'Sand & Gravel' then 'SAG'#(tab)#(lf)#(tab)when a.noticeofworktype = 'Placer Operations' then 'PLA' end) as noticeofworktypecode,'MMS' Sources#(lf)from now_application_identity nai #(lf)join mms_now_submissions.application a on nai.mms_cid = a.mms_cid#(lf)--where now_application_id is null#(lf)union#(lf)select#(tab)#(lf)#(tab)na.now_application_id,#(lf)#(tab)nai.now_application_guid,#(lf)#(tab)m.mine_no ,#(lf)        m.mine_guid,#(lf)#(tab)nai.now_number,#(lf)#(tab)na.submitted_date,#(lf)#(tab)na.received_date,#(lf)#(tab)na.proposed_start_date,#(lf)#(tab)na.proposed_end_date,#(lf)#(tab)na.type_of_application,#(lf)#(tab)nas.description ,#(lf)#(tab)m.latitude ,#(lf)#(tab)m.longitude ,#(lf)#(tab)na.notice_of_work_type_code as noticeofworktypecode,#(lf)#(tab)'Core' Sources#(lf)from#(lf)#(tab)public.now_application na  #(lf)#(tab)left join public.now_application_identity nai on na.now_application_id = nai.now_application_id#(lf)#(tab)left join public.now_application_status nas on na.now_application_status_code = nas.now_application_status_code#(lf)#(tab)left join mine m on m.mine_guid =nai.mine_guid) temp #(lf)#(tab)--where extract(year from submitteddate) >= 2000 #(lf)", null, [EnableFolding=false]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"minenumber", "Mine Number"}, {"mmsnownumber", "NoW Number"}, {"submitteddate", "Submit Date"}, {"receiveddate", "Received Date"}, {"typeofapplication", "Application Type"}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns",{{"Submit Date", type date}, {"Received Date", type date}, {"proposedstartdate", type date}, {"proposedenddate", type date}}),
				    #"Removed Duplicates" = Table.Distinct(#"Changed Type", {"now_application_guid"}),
				    #"Filtered Rows" = Table.SelectRows(#"Removed Duplicates", each ([now_application_guid] <> null))
				in
				    #"Filtered Rows"

	annotation PBI_ResultType = Table

