	partition NoW_Application_Identity-b9221ccf-9dd3-4a95-b9ed-a97c89110286 = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("mds-reporting-pg13-live.postgres.database.azure.com", "mds"), "select now_application_guid ,now_application_id,messageid,mms_cid,mine_guid,now_number,application_type_code #(lf)#(tab)from now_application_identity nai ", null, [EnableFolding=false])
				in
