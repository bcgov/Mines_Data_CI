	partition 'NoW Files-10e024a7-e771-416e-8a8e-02719e46f78d' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("mds-reporting-pg13-live.postgres.database.azure.com", "mds"), "select na.now_application_id,string_agg(filename,', ') as NoWFiles, case when  string_agg(filename,', ') is null then 0 else count(*)  end as ""File Count""#(lf)#(tab)from public.now_application na #(lf)#(tab)left join  public.now_application_document_identity_xref d #(lf)#(tab)on na.now_application_id = d.now_application_id#(lf)#(tab)left join public.now_application_identity nai on nai.now_application_id =na.now_application_id #(lf)#(tab)group by na.now_application_id#(lf)#(tab)order by na.now_application_id asc ", null, [EnableFolding=false])
				in
				    Source

