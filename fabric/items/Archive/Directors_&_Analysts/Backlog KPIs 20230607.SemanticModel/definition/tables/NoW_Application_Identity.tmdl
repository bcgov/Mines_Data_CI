	partition NoW_Application_Identity-b9221ccf-9dd3-4a95-b9ed-a97c89110286 = m
		mode: import
		queryGroup: Dimentions
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("mds-reporting-pg13-live.postgres.database.azure.com", "mds"), "select nai.now_application_guid, nai.now_application_id, nai.messageid, mms_cid,mine_guid, nai.now_number,application_type_code#(lf)#(tab)  ,na.notice_of_work_type_code, na.now_application_status_code, na.application_permit_type_code, na.type_of_application#(lf)from now_application_identity nai#(lf)left join now_application na on na.now_application_id = nai.now_application_id ", null, [EnableFolding=false])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

