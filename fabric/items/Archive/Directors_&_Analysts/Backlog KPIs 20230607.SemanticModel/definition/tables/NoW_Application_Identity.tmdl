table NoW_Application_Identity
	lineageTag: ca1b306c-9bf7-4b31-8025-27ac5892f33d

	measure ColorKPI_Appcount =
			
			SWITCH(TRUE(),
			[Total Count]<[Count Last Year],"#e3a82b",
			[Total Count]>[Count Last Year],"#234075",
			[Total Count]=[Count Last Year],"#234075"
			)
		lineageTag: 98abbcb5-74c0-4b80-8fc6-12419f3822fa

	measure 'KPI Green' = if([Total Count]>[Count Last Year],1,0)
		formatString: 0
		lineageTag: 167bd843-30d6-4be7-8353-1e1ce795ed94

	measure 'KPI Red' = if([Total Count]<[Count Last Year],1,0)
		formatString: 0
		lineageTag: 3084b85d-a4fd-447b-b851-98597fd068c5

	measure 'total app count' = CALCULATE(DISTINCTCOUNT(NoW_Application_Identity[now_application_guid]),all(Mines[Mine Region]))
		formatString: 0
		lineageTag: fb9d30c9-54a5-4441-8ad4-5ed91d52c40b

