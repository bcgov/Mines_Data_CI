		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% of Total' =
			DIVIDE(
			    SELECTEDMEASURE(),CALCULATE(
			        SELECTEDMEASURE()))
		lineageTag: 81e4e53c-91a0-4e88-8228-144eadf6ee90

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Backlog Actual vs Target' = Measures_Table[Open Applications] - AVERAGE('In Progress Appication Target'[Target])
		formatString: 0
		lineageTag: b8c39455-f3cf-4f3d-9f1c-7d7890e9b732

	measure 'Application 12mon Rolling' =
			
			CALCULATE(
			    [Application Count],
			    DATESINPERIOD( SubmitDates[Date], MAX( SubmitDates[Date] ), -12,  MONTH )
			)
		formatString: 0
		lineageTag: a4d1c16b-a556-4f88-b587-8e5fe1332acb

	measure 'Application Count' =
			DISTINCTCOUNT(NoW_Application_Identity[now_application_guid])
			//CALCULATE(DISTINCTCOUNT('NoW Applications'[now_application_id]),USERELATIONSHIP(SubmitDates[Date],'NoW Applications'[submitted_date]))
		formatString: 0
		lineageTag: 24662d2a-55a5-4c0e-9ae4-512a2f6aae61

	measure 'Delay Days' = SUM('NoW Application Delay'[delay_duration (days)])
		formatString: 0
		lineageTag: 83b3e960-70f1-4182-b7de-9b9c3474fc47

	measure 'Turnaround Target' = CALCULATE(AVERAGE('Turnaround Target'[Target]),'Turnaround Target'[Year] = YEAR(TODAY()))
		formatString: 0
		lineageTag: 79d2dec2-2fc7-41df-b278-2c2f03f14f55

	measure 'Avg Turnaround' =
			
			VAR TotalTurnaround = SUM('NoW Applications NEW'[Turnaround])
			VAR COUNTOFAPPS = DISTINCTCOUNT('NoW Applications NEW'[now_application_guid])
			VAR Result = DIVIDE(TotalTurnaround, COUNTOFAPPS)
			RETURN Result
		lineageTag: 92869010-0e54-41d1-be0c-64372deacbc2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Progress Duration' = ```
			
			VAR TEMP = SUMMARIZE(NoW_Application_Identity,NoW_Application_Identity[now_number],"Turnaround", SUM('NoW Applications NEW'[Turnaround]),"Delay", SUM('NoW Application Delay'[delay_duration (days)])) 
			VAR Delay = SUM('NoW Application Delay'[delay_duration (days)])
			VAR Turnaround = SUM('NoW Applications NEW'[Turnaround])
			VAR Result = Turnaround - Delay
			RETURN Result
			```
		formatString: 0
		lineageTag: 84edfce6-dea9-4f53-b421-e453beee7770

	measure 'Turnaround Diff with Target' = AVERAGE('NoW Applications NEW'[Turnaround]) - Measures_Table[Turnaround Target]
		lineageTag: f1674ed3-248b-45a9-8f5f-282db329b18a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Turnaround Sum' = SUM('NoW Applications NEW'[Turnaround])
		formatString: 0
		lineageTag: 9ac1d2d3-8b82-47fb-906d-3ea161ac3780

	measure 'Turnaround KPI Title' = ```
			"Current Mineral Turnaround KPI, 
			Target: " & [Turnaround Target]
			```
		lineageTag: 4ab585bb-787d-47c5-bb6f-24ed2c59913c

	measure 'Turnaround Dynamic' =
			
			VAR TEMP = SUMMARIZE('NoW Applications NEW','NoW Applications NEW'[now_application_guid],
			                    "Submitted Date", MIN('NoW Applications NEW'[submitted_date]),
			                    "Status", MIN('NoW Applications NEW'[now_application_status_code]),
			                    "Turnaournd", IF(MIN('NoW Applications NEW'[submitted_date]) >= MAX('Calendar'[WeekStartDate]), 0 ,
			                                IF(MIN('NoW Applications NEW'[now_application_status_code]) in {"REJ", "NPR", "AIA", "WDN"}
			                                    && MIN('NoW Applications NEW'[status_updated_date]) <= MAX('Calendar'[WeekStartDate]),
			                                    DATEDIFF(MIN('NoW Applications NEW'[submitted_date]), MIN('NoW Applications NEW'[status_updated_date]),DAY),
			                                    DATEDIFF(MIN('NoW Applications NEW'[submitted_date]), MAX('Calendar'[WeekStartDate]),DAY))
			                                    )
			)
			VAR SUBDATE = MAXX(ALLSELECTED('NoW Applications NEW'), 'NoW Applications NEW'[submitted_date])
			VAR TEST = IF(MIN('NoW Applications NEW'[submitted_date]) <= MAX('Calendar'[WeekStartDate]), 0 , 1)
			VAR RESULT = AVERAGEX(TEMP, [Turnaournd])
			RETURN RESULT
		formatString: 0
		lineageTag: a32b1904-520e-40e0-a4ab-365d1ca04ff5

	measure 'Open Applications' = ```
			
			VAR ONEYEARAGO = MAX('Calendar'[Last Year Date])
			VAR RESULT = CALCULATE(DISTINCTCOUNT('NoW Applications NEW'[now_application_guid]),
			                        FILTER('NoW Applications NEW', 
			                               'NoW Applications NEW'[submitted_date] <= ONEYEARAGO 
			                            && ('NoW Applications NEW'[now_application_status_code] in {"REJ", "NPR", "AIA", "WDN"} 
			                                && 'NoW Applications NEW'[status_updated_date] > ONEYEARAGO
			                                || NOT('NoW Applications NEW'[now_application_status_code] in {"REJ", "NPR", "AIA", "WDN"})
			                                )
			                            )
			                    )
			VAR TEST = MAX('NoW Applications NEW'[submitted_date]) <= ONEYEARAGO 
			        && MAX('NoW Applications NEW'[now_application_status_code]) in {"REJ", "NPR", "AIA", "WDN"} 
			        && MAX('NoW Applications NEW'[status_updated_date]) > ONEYEARAGO
			
			RETURN RESULT
			```
		formatString: 0
		lineageTag: 602c53bd-795d-4975-881b-d3480813b976

	measure 'Open Applications Title' =
			"Open Applications
			" & FORMAT(MAX('Calendar'[Last Year Date]), "MMM DD, YYYY")
		lineageTag: 48ec748b-22b6-4cfe-9189-966766702f28

	measure 'Decision Made Avg Turnaround' =
			
			VAR DM_APPS = FILTER('NoW Applications NEW', 'NoW Applications NEW'[now_application_status_code] in {"REJ", "NPR", "AIA", "WDN"} && YEAR('NoW Applications NEW'[status_updated_date]) = YEAR(MAX('Calendar'[Date])))
			VAR RESULT = AVERAGEX(DM_APPS, 'NoW Applications NEW'[Turnaround])
			RETURN RESULT
		lineageTag: 0403e4ac-4f85-48b5-b46b-ced640da3658

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Decision Made Applications' =
			
			VAR DM_APPS = FILTER('NoW Applications NEW', 'NoW Applications NEW'[now_application_status_code] in {"REJ", "NPR", "AIA", "WDN"} && YEAR('NoW Applications NEW'[status_updated_date]) = YEAR(MAX('Calendar'[Date])))
			VAR RESULT = calculate(DISTINCTCOUNT('NoW Applications NEW'[now_application_guid]), DM_APPS)
			RETURN RESULT
		formatString: 0
		lineageTag: 062fff03-b991-4da5-890c-62ad86b046a9

	measure 'Application Received' =
			
			CALCULATE(DISTINCTCOUNT('NoW Applications NEW'[now_application_guid]),
			DATESBETWEEN('NoW Applications NEW'[received_date], MIN('Calendar'[Date]),MAX('Calendar'[Date])))
		formatString: 0
		lineageTag: 1d4d0179-1081-4b71-8c1e-626dbf9a97e7

	measure 'Application Closed' =
			
			CALCULATE(DISTINCTCOUNT('NoW Applications NEW'[now_application_guid]),
			DATESBETWEEN('NoW Applications NEW'[status_updated_date], MIN('Calendar'[Date]),MAX('Calendar'[Date])),
			'NoW Applications NEW'[now_application_status_code] in {"REJ", "NPR", "AIA", "WDN"})
		formatString: 0
		lineageTag: 2b85df2b-c131-4f8d-9e89-1a37a801b5f7

