	measure Draft_Target = 5
		formatString: 0
		lineageTag: 6951569e-23c0-4f31-9f86-626acbf21418

	measure DraftGuage =
			
			SWITCH(
			    TRUE(),
			    MAX('Processing Dates'[draftpermitdurationnum]) <= 5, "#234075",
			    MAX('Processing Dates'[draftpermitdurationnum]) > 5, "#e3a82b")
		lineageTag: 125f15a7-f90b-4788-bac7-2a30abd86347

	measure Intake_Target = 7
