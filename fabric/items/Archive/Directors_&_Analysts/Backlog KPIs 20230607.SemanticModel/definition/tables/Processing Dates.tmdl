	partition 'Processing Dates-dafefb63-7406-4c97-8695-cfe40e9db2ff' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("mds-reporting-pg13-live.postgres.database.azure.com", "mds", [CreateNavigationProperties=false]), "with cte_processingdate as #(lf)(SELECT nid.now_application_guid,#(lf)    --m.mine_guid,#(lf)    --m.mine_no,#(lf)    nid.now_number,#(lf)    (row_number() over (partition by nid.now_application_guid order by pa.create_timestamp desc))::numeric as RNum ,#(lf)    pa.create_timestamp ,#(lf)    m.mine_name,#(lf)    concat_ws(' '::text, pmt.first_name, pmt.party_name) AS permittee,#(lf)    COALESCE(nowt.description, sub.noticeofworktype, msub.noticeofworktype) AS Type,#(lf)    app.type_of_application AS TypeofApplication,#(lf)    pinsp.party_guid ,#(lf)    concat_ws(' '::text, pinsp.first_name, pinsp.party_name) AS Inspector,#(lf)    COALESCE(nows.description, sub.status) AS Status,#(lf)    --COALESCE(app.received_date, sub.receiveddate, msub.receiveddate) AS received_date,#(lf)    app.submitted_date AS ""Submit Date"",#(lf)    (select (current_date-app.submitted_date) from now_application app where app.now_application_id = nid.now_application_id) AS in_progress_duration,#(lf)    app.received_date AS vFCBCtoMEM,#(lf)    --app.NOTSURE AS Accepted,#(lf)    (select nap.start_date from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'REV') AS TechReview,#(lf)    (select nap.end_date from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'REV') AS TechReviewComplete,#(lf)    (select CASE WHEN nap.end_date IS NULL AND nap.start_date IS NOT NULL THEN 'In Progress' WHEN nap.start_date IS NULL AND nap.end_date IS NULL THEN 'Not Started' ELSE DATE_PART('day',nap.end_date-nap.start_date)::varchar END from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'REV') AS TechReviewDuration,#(lf)    (select nap.start_date from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'REF') AS Referral,#(lf)    (select nap.start_date + INTERVAL '30 days' from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'REF') AS ReferralResponse,#(lf)    (select nap.end_date from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'REF') AS ReferralComplete,#(lf)    (select nap.start_date from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'CON') AS ConsultationStart,#(lf)    (select nap.end_date from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'CON') AS ConsultationComplete,#(lf)    (select nap.start_date from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'PUB') AS PublicComment,#(lf)    (select nap.end_date from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'PUB') AS PublicCommentComplete,#(lf)    (select nap.start_date from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'DFT') AS DraftPermit,#(lf)    (select nap.end_date from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'DFT') AS DraftPermitComplete,#(lf)    (select CASE WHEN nap.end_date IS NULL AND nap.start_date IS NOT NULL THEN 'In Progress' WHEN nap.start_date IS NULL AND nap.end_date IS NULL THEN 'Not Started' ELSE DATE_PART('day',nap.end_date-nap.start_date)::varchar END from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'REF') AS ReferralDuration,#(lf)    (select CASE WHEN nap.end_date IS NULL AND nap.start_date IS NOT NULL THEN 'In Progress' WHEN nap.start_date IS NULL AND nap.end_date IS NULL THEN 'Not Started' ELSE DATE_PART('day',nap.end_date-nap.start_date)::varchar END from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'CON') AS ConsultationDuration,#(lf)    (select CASE WHEN nap.end_date IS NULL AND nap.start_date IS NOT NULL THEN DATE_PART('day',current_date-nap.start_date) WHEN nap.start_date IS NULL AND nap.end_date IS NULL THEN null ELSE DATE_PART('day',nap.end_date-nap.start_date) END from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'CON') AS ConsultationDuration_num,#(lf)    (select CASE WHEN nap.end_date IS NULL AND nap.start_date IS NOT NULL THEN DATE_PART('day',current_date-nap.start_date) WHEN nap.start_date IS NULL AND nap.end_date IS NULL THEN null ELSE DATE_PART('day',nap.end_date-nap.start_date) END from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'REV') AS TechReviewDuration_num,#(lf)(select #(lf)     CASE #(lf)    #(tab)WHEN nap.end_date IS NULL AND nap.start_date IS NOT NULL THEN #(lf)    #(tab)#(tab)case #(lf)    #(tab)#(tab)#(tab)when DATE_PART('day',current_date-nap.start_date)<5 then 'met' #(lf)    #(tab)#(tab)#(tab)else 'not met' #(lf)    #(tab)#(tab)end  #(lf)    #(tab)WHEN nap.start_date IS NULL AND nap.end_date IS NULL THEN 'Not Started' #(lf)    #(tab)ELSE #(lf)    #(tab)#(tab)case #(lf)    #(tab)#(tab)#(tab)when DATE_PART('day',nap.end_date-nap.start_date)<5 then 'met' #(lf)    #(tab)#(tab)#(tab)else 'not met' #(lf)    #(tab)#(tab)end #(lf)    #(tab)END #(lf)    from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'DFT') AS DraftPermitDuration_num,#(lf)    (select CASE WHEN nap.end_date IS NULL AND nap.start_date IS NOT NULL THEN 'In Progress' WHEN nap.start_date IS NULL AND nap.end_date IS NULL THEN 'Not Started' ELSE DATE_PART('day',nap.end_date-nap.start_date)::varchar END from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'PUB') AS PublicCommentDuration,#(lf)    (select CASE WHEN nap.end_date IS NULL AND nap.start_date IS NOT NULL THEN 'In Progress' WHEN nap.start_date IS NULL AND nap.end_date IS NULL THEN 'Not Started' ELSE DATE_PART('day',nap.end_date-nap.start_date)::varchar END from now_application_progress nap where now_application_id = app.now_application_id and application_progress_status_code = 'DFT') AS DraftPermitDuration -- should be always populated#(lf)    --(select current_date-app.submitted_date-(COALESCE((select SUM(DATE_PART('day', nad.end_date-nad.start_date)) from  now_application_delay nad where nad.now_application_guid = nid.now_application_guid), 0))#(lf)   FROM (((((((now_application_identity nid#(lf)     JOIN mine m ON ((nid.mine_guid = m.mine_guid)))#(lf)     LEFT JOIN now_submissions.application sub ON ((nid.messageid = sub.messageid)))#(lf)     LEFT JOIN mms_now_submissions.application msub ON ((nid.mms_cid = msub.mms_cid)))#(lf)     LEFT JOIN now_application app ON ((nid.now_application_id = app.now_application_id)))#(lf)     LEFT JOIN party pinsp ON ((app.lead_inspector_party_guid = pinsp.party_guid)))#(lf)     LEFT JOIN now_party_appointment pa ON ((app.now_application_id = pa.now_application_id))#(lf)     LEFT JOIN party pmt ON ((pa.party_guid  = pmt.party_guid))#(lf)     LEFT JOIN notice_of_work_type nowt ON (((app.notice_of_work_type_code)::text = (nowt.notice_of_work_type_code)::text)))#(lf)     LEFT JOIN now_application_status nows ON (((app.now_application_status_code)::text = (nows.now_application_status_code)::text)))#(lf)     --where pa.mine_party_appt_type_code = 'PMT'#(lf))select * from cte_processingdate where RNum=1 ", null, [EnableFolding=false]),
