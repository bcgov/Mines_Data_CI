	column Turnaround = ```
			
			VAR DecisionMade = 'NoW Applications NEW'[now_application_status_code] in {"REJ", "NPR", "AIA", "WDN"} 
			VAR EndDate = IF(DecisionMade, 'NoW Applications NEW'[status_updated_date], TODAY())
			VAR RESULT = DATEDIFF('NoW Applications NEW'[submitted_date], EndDate, DAY)
			RETURN RESULT
			```
		formatString: 0
		lineageTag: c6862e96-1d8f-47ac-8bff-4a2a5c58699b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Turnaround Lastmonth' =
			
			VAR DecisionMade = 'NoW Applications NEW'[now_application_status_code] in {"REJ", "NPR", "AIA", "WDN"}
			VAR LM = MAX(_DATE[LastMonth])
			VAR EndDate = IF(DecisionMade && LM >= 'NoW Applications NEW'[status_updated_date], 'NoW Applications NEW'[status_updated_date], LM)
			VAR RESULT = DATEDIFF('NoW Applications NEW'[submitted_date], EndDate, DAY)
			RETURN RESULT
		formatString: 0
		lineageTag: 878d12de-a14a-42c3-8544-128b3b434bad
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition 'NoW Applications NEW-d075c2cf-d9dc-4efd-b218-5d0c5ce59747' = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("mds-reporting-pg13-live.postgres.database.azure.com", "mds"), "select naid.now_number, naid.now_application_guid#(lf), wt.description as application_type#(lf), na.submitted_date, na.received_date, na.work_plan#(lf), CONCAT(p.first_name, ' ', p.party_name) as inspector#(lf),na.now_application_status_code#(lf)--,apps.description as application_status#(lf), status_updated_date,status_reason#(lf)from now_application_identity naid#(lf)left join now_application na on na.now_application_id = naid.now_application_id#(lf)left join notice_of_work_type wt on wt.notice_of_work_type_code = na.notice_of_work_type_code#(lf)--left join now_application_status apps on apps.now_application_status_code = na.now_application_status_code#(lf)left join party p on p.party_guid = na.lead_inspector_party_guid ", null, [EnableFolding=false]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"submitted_date", type date}, {"received_date", type date}, {"status_updated_date", type date}}),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each ([now_application_status_code] <> null))
				in
				    #"Filtered Rows"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

