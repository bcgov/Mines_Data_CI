		mode: import
		queryGroup: Facts
		source = ```
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("mds-reporting-pg13-live.postgres.database.azure.com", "mds"), "select naid.now_application_guid, nad.now_application_delay_id as Delay_id#(lf)#(tab)  ,nad.delay_type_code, nadt.description#(lf)#(tab)  ,start_date as startdate, end_date as enddate#(lf)#(tab)  ,lead(start_date,1) over (PARTITION BY naid.now_application_guid order by naid.now_application_guid, start_date) next_startdate#(lf)#(tab)  ,lead(end_date,1) over (PARTITION BY naid.now_application_guid order by naid.now_application_guid, start_date) next_enddate#(lf)#(tab)  ,start_comment#(lf)from now_application_delay nad#(lf)left join now_application_identity naid on naid.now_application_guid = nad.now_application_guid#(lf)left join now_application na on na.now_application_id = naid.now_application_id#(lf)left join now_application_delay_type nadt on nadt.delay_type_code = nad.delay_type_code#(lf)order by now_application_guid, startdate ", null, [EnableFolding=false]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"startdate", type date}, {"enddate", type date}, {"next_startdate", type date}, {"next_enddate", type date}}),
				    //preprocessing， if a delay only one day and that date already existed in another record then remove that delay
				    #"Added Custom4" = Table.AddColumn(#"Changed Type", "Single Existed Date Flag", each if [enddate] = null then false 
				else[enddate] = [next_startdate] and Duration.Days([enddate]-[startdate]) = 0),
				    #"Filtered Rows1" = Table.SelectRows(#"Added Custom4", each ([Single Existed Date Flag] = false)),
				    #"Removed Columns1" = Table.RemoveColumns(#"Filtered Rows1",{"Single Existed Date Flag", "next_startdate", "next_enddate"}),
				    #"Replaced Value" = Table.ReplaceValue(#"Removed Columns1",null,Date.From(DateTime.LocalNow()),Replacer.ReplaceValue,{"enddate"}),
				    //Removing Overlapping Period
				    //Step 1 Creating date range list
				    #"Added Custom" = Table.AddColumn(#"Replaced Value", "dateList", each List.Dates([startdate],
				           Duration.Days([enddate]-[startdate])+1,
				           #duration(1,0,0,0)
				           )),
				    #"Sorted Rows1" = Table.Sort(#"Added Custom",{{"enddate", Order.Descending}, {"startdate", Order.Descending}}),
				    #"Grouped to get SubIndex" = Table.Group(#"Sorted Rows1", {"now_application_guid"}, {{"All", each _, type table [now_application_guid=nullable text, delay_id=nullable number, delay_type_code=nullable text, description=nullable text, startdate=nullable date, enddate=nullable date, start_comment=nullable text, dateList=list]}}),
				    SubIndex = Table.AddColumn(#"Grouped to get SubIndex", "SubIndex", each Table.AddIndexColumn([All], "Index", 1,1)),
				    #"Removed Other Columns" = Table.SelectColumns(SubIndex,{"SubIndex"}),
				    #"Expanded SubIndex1" = Table.ExpandTableColumn(#"Removed Other Columns", "SubIndex", {"now_application_guid", "delay_id", "delay_type_code", "description", "startdate", "enddate", "start_comment", "dateList", "Index"}, {"now_application_guid", "delay_id", "delay_type_code", "description", "startdate", "enddate", "start_comment", "dateList", "Index"}),
				    #"Changed Type4" = Table.TransformColumnTypes(#"Expanded SubIndex1",{{"delay_type_code", type text}, {"now_application_guid", type text}, {"description", type text}, {"start_comment", type text}, {"enddate", type date}, {"startdate", type date}, {"delay_id", Int64.Type}, {"Index", Int64.Type}}),
				    #"Grouped Rows" = Table.Group(#"Changed Type4", {"now_application_guid"}, {{"All", each _, type table [now_application_guid=nullable text, delay_id=nullable number, delay_type_code=nullable text, description=nullable text, startdate=nullable date, enddate=nullable date, start_comment=nullable text, dateList=list, Index=nullable number]}, {"delay_id", each List.Max([delay_id]), type nullable number}, {"delay_type_code", each List.Max([delay_type_code]), type nullable text},
				    {"combinedDates", each List.Distinct(List.Combine([dateList])), type list}, 
				    {"startToEnd", each List.Dates(List.Min([startdate]),
				                                Duration.Days(List.Max([enddate])-List.Min([startdate]))+1,
				                                #duration(1,0,0,0))}
				}),
				    //Step 2 Comparing date list with date range, if true then means has overlapping date
				    #"Added Custom1" = Table.AddColumn(#"Grouped Rows", "Custom", each List.IsEmpty(List.Difference([startToEnd],[combinedDates]))),
				    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "startdate", each if [Custom] = false then null 
				                else List.Min([combinedDates])),
				    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "enddate", each if [Custom] = false then null 
				                else List.Max([combinedDates])),
				
				    //Step 3 For those overlapping records, use min start and max end
				    #"Filtered Rows True" = Table.SelectRows(#"Added Custom3", each ([Custom] = true)),
				    #"Expanded All1" = Table.ExpandTableColumn(#"Filtered Rows True", "All", {"delay_id", "description", "Index", "start_comment"}, {"delay_id.1", "description", "Index", "start_comment"}),
				    #"Filtered Rows" = Table.SelectRows(#"Expanded All1", each ([delay_id] = [delay_id.1])),
				    #"Removed Columns" = Table.RemoveColumns(#"Filtered Rows",{"combinedDates", "startToEnd", "Custom", "delay_id.1"}),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Removed Columns",{{"startdate", type date}, {"enddate", type date}, {"now_application_guid", type text}, {"delay_type_code", type text}, {"delay_id", Int64.Type}}),
				
				    //Step 4 For those good records, just expand details columns
				    #"Filtered Rows False" = Table.SelectRows(#"Added Custom3", each ([Custom] = false)),
				    #"Expanded All" = Table.ExpandTableColumn(#"Filtered Rows False", "All", {"delay_id", "delay_type_code", "description", "startdate", "enddate", "start_comment", "Index"}, {"delay_id.1", "delay_type_code.1", "description", "startdate.1", "enddate.1", "start_comment", "Index"}),
				    #"Removed Columns False" = Table.RemoveColumns(#"Expanded All",{"combinedDates", "startToEnd", "Custom", "startdate", "enddate", "delay_id", "delay_type_code"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns False",{{"startdate.1", "startdate"}, {"enddate.1", "enddate"}, {"delay_id.1", "delay_id"}, {"delay_type_code.1", "delay_type_code"}}),
				    
				    //Combine Step 3 and 4 together to get full dataset
				    comb = Table.Combine({#"Changed Type1", #"Renamed Columns"}),
				    #"Changed Type2" = Table.TransformColumnTypes(comb,{{"now_application_guid", type text}, {"delay_id", Int64.Type}, {"delay_type_code", type text}}),
				    #"Sorted Rows" = Table.Sort(#"Changed Type2",{{"now_application_guid", Order.Ascending}}),
				    DelayDuration = Table.AddColumn(#"Sorted Rows", "delay_duration (days)", each Duration.TotalDays([enddate]-[startdate])+1, Int64.Type)
				in
				    DelayDuration
				```

