	partition 'pulse reports-c1647f42-ac03-446f-a237-b16d7d40857d' = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("mds-reporting-pg13-live.postgres.database.azure.com", "mds", [CreateNavigationProperties=false]), "select #(lf) p.permit_no#(lf),pamd.issue_date ,pamd.authorization_end_date ,pamd.create_user ,pamd.permit_amendment_type_code ,pamd.description ,pamd.received_date ,pamd.update_timestamp ,pamd.update_user ,pamd.liability_adjustment ,pamd.issuing_inspector_title ,pamd.regional_office ,pamd.security_received_date ,pamd.security_not_required ,pamd.deleted_ind ,pamd.security_not_required_reason ,pamd.permit_conditions_last_updated_by ,pamd.permit_conditions_last_updated_date#(lf),m.mine_no,m.mine_name,/*m.create_user, m.deleted_ind,*/m.exemption_fee_status_code,m.exemption_fee_status_note,/*m.geom,*/m.latitude,m.legacy_mms_mine_status,m.longitude,m.mine_region,m.mine_guid,m.mine_location_description,m.mine_note,m.mms_alias#(lf)from mine m#(lf)left join permit_amendment pamd on pamd.mine_guid = m.mine_guid#(lf)left join permit p on p.permit_id = pamd.permit_id ", null, [EnableFolding=false])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

