table ViewersRanking

	column OwnerTenantGuid
		dataType: string
		isHidden
		sourceProviderType: varchar
		sourceColumn: OwnerTenantGuid

	column OwnerUserGuid
		dataType: string
		isHidden
		sourceProviderType: varchar
		sourceColumn: OwnerUserGuid

	column OwnerGroupGuid
		dataType: string
		isHidden
		sourceProviderType: varchar
		sourceColumn: OwnerGroupGuid

	column ReportGuid
		dataType: string
		sourceProviderType: varchar
		sourceColumn: ReportGuid

	column ViewersRank
		dataType: int64
		formatString: 0
		sourceProviderType: bigint
		sourceColumn: Rank

	partition Usage_ReportViewersRanking_V1 = query
		dataView: full
		source
			query =
				SELECT [Viewers].[Usage_ReportViewersRanking_V1].*
				FROM [Viewers].[Usage_ReportViewersRanking_V1]
				WHERE [Viewers].[Usage_ReportViewersRanking_V1].[OwnerTenantGuid] = '6fdb5200-3d0d-4a8a-b036-d3685e359adc' AND ([Viewers].[Usage_ReportViewersRanking_V1].[OwnerGroupGuid] = '842a168e-d34c-4d96-b839-aba622d26cf8' OR [Viewers].[Usage_ReportViewersRanking_V1].[OwnerUserGuid] = '')
			dataSource: bd7c0be5-4f36-44e9-bc91-20679d41615b

