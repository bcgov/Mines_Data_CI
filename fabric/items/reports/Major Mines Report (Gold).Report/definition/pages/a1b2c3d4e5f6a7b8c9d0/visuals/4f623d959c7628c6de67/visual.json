                  {
                    "value": "WHY TWO OPERATING NUMBERS?",
                    "textStyle": {
                      "fontSize": "12px",
                      "color": "#013366",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "   Analyst note",
                    "textStyle": {
                      "fontSize": "11px",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "MDS calls a mine Operating once it holds an active permit and isn't closed. That pulls in mines still being built, seasonal sites, and industrial sites. The CIM & CPO report counts mines that actually produced.",
                    "textStyle": {
                      "fontSize": "11px",
                      "color": "#252423"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Lead with 17, and let people drill to 34.",
                    "textStyle": {
                      "fontSize": "11px",
                      "color": "#013366",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "   The 17 is a published figure, not yet verified against MDS; confirm with Raj before quoting it.",
                    "textStyle": {
                      "fontSize": "11px",
                      "color": "#605E5C"
                    }
                  }
                ]
              }
            ]
          }
        }
