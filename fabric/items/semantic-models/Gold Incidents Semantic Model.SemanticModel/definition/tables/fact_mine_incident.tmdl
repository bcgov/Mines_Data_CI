	measure 'Rolling 30 Pill Color' = VAR c = [Incidents Rolling 30 Days] VAR p = [Incidents Prior 30 Days] RETURN IF ( ISBLANK ( p ) || c = p, "#605E5C", IF ( c > p, "#CE3E39", "#2E8540" ) )
		displayFolder: Enhanced
