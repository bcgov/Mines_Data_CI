table fact_inspection
	lineageTag: 23b32cd6-cb03-4d41-b142-017e180a7fdf
	sourceLineageTag: [gold].[fact_inspection]

	/// All-time distinct count of inspections. Base measure.
	measure 'Inspections Total' = DISTINCTCOUNT(fact_inspection[inspection_id])
		formatString: #,##0
		displayFolder: Inspections KPIs
		lineageTag: b704fa70-290d-4ac4-b33a-7376a1ccdaa9

	/// Inspections FYTD: current BC fiscal year (Apr 1 -> today, inclusive of all of today regardless of time-of-day), auto-detects current FY from today's date. Per Method Statement handout item 1.
	measure 'Inspections FYTD' = VAR CurrentDate = TODAY() VAR FYStartYear = IF ( MONTH ( CurrentDate ) >= 4, YEAR ( CurrentDate ), YEAR ( CurrentDate ) - 1 ) VAR FYStart = DATE ( FYStartYear, 4, 1 ) RETURN CALCULATE ( DISTINCTCOUNT ( fact_inspection[inspection_id] ), fact_inspection[inspection_date] >= FYStart, fact_inspection[inspection_date] < CurrentDate + 1 )
		formatString: #,##0
		displayFolder: Inspections KPIs
		lineageTag: 310b24ee-f5f4-4613-83ba-967539d14d27

	/// Inspections same time last FY: previous FY window Apr 1 (FY-1) to exactly one year ago from today (inclusive of that full day). Per Method Statement handout item 2.
	measure 'Inspections Same Time Last FY' = VAR CurrentDate = TODAY() VAR FYStartYear = IF ( MONTH ( CurrentDate ) >= 4, YEAR ( CurrentDate ), YEAR ( CurrentDate ) - 1 ) VAR LastFYStart = DATE ( FYStartYear - 1, 4, 1 ) VAR LastFYSameDate = DATE ( YEAR ( CurrentDate ) - 1, MONTH ( CurrentDate ), DAY ( CurrentDate ) ) RETURN CALCULATE ( DISTINCTCOUNT ( fact_inspection[inspection_id] ), fact_inspection[inspection_date] >= LastFYStart, fact_inspection[inspection_date] < LastFYSameDate + 1 )
		formatString: #,##0
		displayFolder: Inspections KPIs
		lineageTag: f0bdb947-cb2e-4ace-a367-37588dad19d1

	/// Inspections in the rolling PREVIOUS 30 DAYS (>= TODAY-30 and < TODAY), matching Rajneesh's Metabase 'Inspection Date Previous 30 Days' filter. NOTE: reads low until the gold pipeline is current, since it only counts inspection dates present in gold.
	measure 'Inspections Last Month' = VAR CurrentDate = TODAY() RETURN CALCULATE ( DISTINCTCOUNT ( fact_inspection[inspection_id] ), fact_inspection[inspection_date] >= CurrentDate - 30, fact_inspection[inspection_date] < CurrentDate )
		formatString: #,##0
		displayFolder: Inspections KPIs
		lineageTag: b13c9a17-ddf6-43d9-bde7-1a5e3c9940b3

	/// Inspections per fiscal year trend. About 7 fiscal years back up to (exclusive of) Apr 1 of the current in-progress fiscal year. Per Method Statement handout item 4. Use with dim_date[fiscal_year_label] on the axis.
	measure 'Inspections per Fiscal Year' = VAR CurrentDate = TODAY() VAR CurrentFYStartYear = IF ( MONTH ( CurrentDate ) >= 4, YEAR ( CurrentDate ), YEAR ( CurrentDate ) - 1 ) VAR CutoffDate = DATE ( CurrentFYStartYear, 4, 1 ) VAR WindowStart = DATE ( CurrentFYStartYear - 7, 4, 1 ) RETURN CALCULATE ( DISTINCTCOUNT ( fact_inspection[inspection_id] ), fact_inspection[inspection_date] >= WindowStart, fact_inspection[inspection_date] < CutoffDate )
		formatString: #,##0
		displayFolder: Inspections Trend
		lineageTag: eb979d2f-1d2f-4c68-9706-43ccde249acd

	/// Inspections per fiscal month and type, last ~5 fiscal years (Apr 1 of CurrentFY-4) to today inclusive. Window starts Apr 2022 to match Rajneesh's Metabase bar chart. Use with dim_date[fiscal_year_label]/[fiscal_month_label] on axis and dim_inspection_type[inspection_type_name] as legend.
	measure 'Inspections per Fiscal Month and Type' = VAR CurrentDate = TODAY() VAR CurrentFYStartYear = IF ( MONTH ( CurrentDate ) >= 4, YEAR ( CurrentDate ), YEAR ( CurrentDate ) - 1 ) VAR WindowStart = DATE ( CurrentFYStartYear - 4, 4, 1 ) RETURN CALCULATE ( DISTINCTCOUNT ( fact_inspection[inspection_id] ), fact_inspection[inspection_date] >= WindowStart, fact_inspection[inspection_date] < CurrentDate + 1 )
		formatString: #,##0
		displayFolder: Inspections Trend
		lineageTag: 49a67126-e61d-4646-81e5-2db9273af700

	/// Dynamic KPI card label for FYTD, auto-updates fiscal year.
	measure 'Lbl FYTD' = VAR d = TODAY() VAR s = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fy = RIGHT ( FORMAT ( s, "0000" ), 2 ) & "/" & RIGHT ( FORMAT ( s + 1, "0000" ), 2 ) RETURN "Number of Inspections FYTD " & fy
		displayFolder: Card Labels
		lineageTag: 0e23c59e-8595-4c14-8880-ce19d8153443

	/// Dynamic KPI card label for same-time-last-FY.
	measure 'Lbl Same Last FY' = VAR d = TODAY() VAR s = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fyp = FORMAT ( s - 1, "0000" ) & "/" & RIGHT ( FORMAT ( s, "0000" ), 2 ) RETURN "Number of Inspections same time Last FY " & fyp
		displayFolder: Card Labels
		lineageTag: 2e1e68bf-2b0c-4f14-b05b-04d1a51a0164

	/// Dynamic KPI card label for the rolling previous-30-days KPI.
	measure 'Lbl Last Month' = VAR d = TODAY() VAR s = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fy = RIGHT ( FORMAT ( s, "0000" ), 2 ) & "/" & RIGHT ( FORMAT ( s + 1, "0000" ), 2 ) RETURN "Number of Inspections (Previous 30 Days) FY " & fy
		displayFolder: Card Labels
		lineageTag: 4e4e03e9-2df6-4734-b69b-b827c25510a5

	/// Annual Service Plan target for inspections (static 1,600/yr as of FY26/27). OPEN: confirm whether static every year or tied to Service Plan cycle.
	measure 'Inspections Service Plan Target' = 1600
		formatString: #,0
		displayFolder: Inspections KPIs
		lineageTag: dcca6c58-2b1d-47ee-ab29-8b485adf5ac3

	/// Dynamic flag (1/0): 1 when the current context's fiscal year is within the most recent 7 fiscal years (CurrentFY-6..CurrentFY), else 0. Uses TODAY() so it rolls forward automatically. Used as a visual-level filter to drive the dynamic last-7-fiscal-years window on the Inspection Report.
	measure 'Is Last 7 FY' = VAR CurFY = YEAR(TODAY()) - IF(MONTH(TODAY())>=4,0,1) VAR FY = SELECTEDVALUE(dim_date[fiscal_year]) RETURN IF(NOT ISBLANK(FY) && FY >= CurFY-6 && FY <= CurFY, 1, 0)
		formatString: 0
		isHidden
		lineageTag: fac82391-39cc-42b7-b8ca-af1d9f786228

	/// Year-over-year change: FYTD minus same-time-last-FY (apples-to-apples comparable windows).
	measure 'Inspections YoY Delta' = [Inspections FYTD] - [Inspections Same Time Last FY]
		formatString: +#,0;-#,0;0
		displayFolder: Inspections KPIs
		lineageTag: 3c36a88d-0e9d-4b65-9f13-323e84222cab

	/// Year-over-year percentage change vs same time last FY.
	measure 'Inspections YoY Delta %' = DIVIDE([Inspections YoY Delta], [Inspections Same Time Last FY])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Inspections KPIs
		lineageTag: 39b69dbc-8a71-4542-8f00-87d577145c59

	/// Dynamic data-freshness label = latest inspection date in the gold data. Auto-updates when the pipeline refreshes.
	measure 'Data As Of Label' = "Data current through " & FORMAT(MAX(fact_inspection[inspection_date]), "d MMM yyyy")
		displayFolder: Card Labels
		lineageTag: 59c9a0e9-92f7-4993-ac70-8b2e8874ad3d

	/// Total inspections in the last completed fiscal year. Feeds the hub 'what changed' narrative.
	measure 'Inspections Prev FY Total' = VAR d = TODAY() VAR s = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN CALCULATE ( DISTINCTCOUNT ( fact_inspection[inspection_id] ), fact_inspection[inspection_date] >= DATE ( s - 1, 4, 1 ), fact_inspection[inspection_date] < DATE ( s, 4, 1 ) )
		formatString: #,0
		displayFolder: Hub
		lineageTag: 07b186af-8609-47af-96ca-0d044c3e2b40

	/// Freshness pill on the hub intro tile. Latest inspection date in gold - never typed in.
	measure 'Hub Data As At' = "Data as at " & FORMAT ( MAX ( fact_inspection[inspection_date] ), "d MMMM yyyy" )
		displayFolder: Hub
		lineageTag: 99752c34-26c7-4c09-9b38-462fc63748c7

	/// Interim next-refresh line on the hub intro tile (monthly cadence until the pipeline runs daily).
	measure 'Hub Next Refresh' = "Next refresh: " & FORMAT ( EOMONTH ( TODAY (), 0 ) + 1, "d MMMM yyyy" )
		displayFolder: Hub
		lineageTag: 46a4015d-4f37-4d31-9de5-bd0b6bf373b9

	/// Footer line on the Inspections report card in the hub.
	measure 'Hub Updated Inspections' = "Updated " & FORMAT ( MAX ( fact_inspection[inspection_date] ), "d MMM yyyy" )
		displayFolder: Hub
		lineageTag: 2be42d0f-39b6-47f3-8c6a-9aab9c724fa6

	/// Trust-tag state for the Inspections card. Single point of change until the validation/metadata layer lands.
	measure 'Hub Trust Inspections' = "Certified"
		displayFolder: Hub
		lineageTag: 15d9043d-cdf7-4180-8ac9-cb1c5bc782ce

	/// Hub 'what changed this month' narrative for Inspections. Every figure is a live measure. Computes last calendar month itself so the month name and the number always agree, and says so plainly when nothing has landed yet.
	measure 'Hub Changed Inspections' = VAR d = TODAY () VAR f = [Inspections FYTD] VAR p = [Inspections Same Time Last FY] VAR pf = [Inspections Prev FY Total] VAR t = [Inspections Service Plan Target] VAR mStart = DATE ( YEAR ( d ), MONTH ( d ), 1 ) VAR lmStart = EDATE ( mStart, -1 ) VAR lm = CALCULATE ( DISTINCTCOUNT ( fact_inspection[inspection_id] ), fact_inspection[inspection_date] >= lmStart, fact_inspection[inspection_date] < mStart ) VAR mth = FORMAT ( lmStart, "MMMM" ) VAR dlt = f - p VAR pct = DIVIDE ( dlt, p ) VAR dir = SWITCH ( TRUE (), ABS ( pct ) < 0.02, "effectively flat against", dlt > 0, "up from", "down from" ) VAR sy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR pfy = "FY" & FORMAT ( sy - 1, "0000" ) & "/" & RIGHT ( FORMAT ( sy, "0000" ), 2 ) VAR vt = IF ( pf >= t, "at or above", "below" ) VAR mthTxt = IF ( COALESCE ( lm, 0 ) = 0, "No inspections have landed for " & mth & " yet - the source is behind. ", mth & " contributed " & FORMAT ( lm, "#,0" ) & ". " ) RETURN FORMAT ( f, "#,0" ) & " completed FYTD, " & dir & " " & FORMAT ( p, "#,0" ) & " at the same point last year. " & mthTxt & pfy & " finished at " & FORMAT ( pf, "#,0" ) & ", " & vt & " the " & FORMAT ( t, "#,0" ) & " Service Plan target."
		displayFolder: Hub
		lineageTag: 7d044269-be38-46a4-889e-acb56de01493

	/// Trust-tag state for the Incidents card. Provisional until the Incidents report is built and validated.
	measure 'Hub Trust Incidents' = "Provisional"
		displayFolder: Hub
		lineageTag: 4daf75d5-6ebc-4300-a91e-19d3d980bb0d

	/// Trust-tag state for the Notice of Work card. Provisional while the now_application source extract is stale.
	measure 'Hub Trust NoW' = "Provisional"
		displayFolder: Hub
		lineageTag: ee5f6af2-7120-4f63-87e1-dbb4f5ac4d2b

	/// Footer line on the Incidents report card in the hub.
	measure 'Hub Updated Incidents' = "Monthly corporate report"
		displayFolder: Hub
		lineageTag: 3070ba27-16dd-4a15-a360-37ce0f613d4c

	/// Footer line on the Notice of Work report card in the hub.
	measure 'Hub Updated NoW' = "Monthly corporate report"
		displayFolder: Hub
		lineageTag: 7573e029-7a1b-496b-a6fa-13b328678615

	/// Hub 'what changed' text for Incidents. Honest placeholder rather than an empty card.
	measure 'Hub Changed Incidents' = "Now live. Incidents by effective date (24-hour rule), with dangerous occurrences, injuries and fatalities by month - open the report for current figures."
		displayFolder: Hub
		lineageTag: 76758f22-8a28-445b-86a1-c586681836ac

	/// Hub 'what changed' text for Notice of Work. Honest placeholder rather than an empty card.
	measure 'Hub Changed NoW' = "Now live. New permits and amendments issued by fiscal year and month, excluding administrative amendments - open the report for current figures."
		displayFolder: Hub
		lineageTag: b40ef8d5-d493-4287-aa9b-c141ff10a9b4

	/// Trust-badge label - validated and approved.
	measure 'Hub Badge Certified' = "Certified"
		displayFolder: Hub
		lineageTag: 18eff42a-c2c5-4911-8226-5b67ecc7801b

	/// Trust-badge label - owner recommends, not yet certified.
	measure 'Hub Badge Promoted' = "Promoted"
		displayFolder: Hub
		lineageTag: 01dc123c-2c20-4a49-b539-94e3dfd47294

	/// Trust-badge label - visible but not yet validated.
	measure 'Hub Badge Provisional' = "Provisional"
		displayFolder: Hub
		lineageTag: 07d04935-79cf-407f-b538-6527bd6c8ffa

	/// Trust-badge label - ad-hoc or user-built content.
	measure 'Hub Badge Not Validated' = "Not validated"
		displayFolder: Hub
		lineageTag: dd104d71-3ef1-429f-93e4-f0408d4baae5

	/// Trust state for the Inspection planning map card.
	measure 'Hub Trust Planning Map' = [Hub Badge Provisional]
		displayFolder: Hub
		lineageTag: 608d8013-f5b7-453c-b82e-1606350ac884

	/// Trust state for the Permit turnaround card.
	measure 'Hub Trust Permit Turnaround' = [Hub Badge Provisional]
		displayFolder: Hub
		lineageTag: 9f210646-d332-4593-b928-71233b2774b8

	/// Trust state for the Mineral Titles extract card.
	measure 'Hub Trust Mineral Titles' = [Hub Badge Provisional]
		displayFolder: Hub
		lineageTag: d12aaed9-fde3-4fe0-9bd9-016386b4d634

	/// Trust state for the Dictionary and lineage card.
	measure 'Hub Trust Dictionary' = [Hub Badge Provisional]
		displayFolder: Hub
		lineageTag: 9a93d5bb-2da4-45ec-8b44-72c58235e4e6

	/// Footer line on the Inspection planning map card.
	measure 'Hub Updated Planning Map' = "In design - GIS team"
		displayFolder: Hub
		lineageTag: 78d606ad-e120-4944-92b6-828091f23aae

	/// Trust state for the NoW Received card in the hub.
	measure 'Hub Trust NoW Received' = [Hub Badge Provisional]
		displayFolder: Hub
		lineageTag: 2bf97aac-8f38-493f-90c0-c1d11e52949d

	/// Footer line on the NoW Received card in the hub.
	measure 'Hub Updated NoW Received' = "Monthly corporate report"
		displayFolder: Hub
		lineageTag: 5a309977-46c2-43a6-968e-1957086220e4

	/// Footer line on the Permit turnaround card.
	measure 'Hub Updated Permit Turnaround' = "In design"
		displayFolder: Hub
		lineageTag: 2e1e6ee0-5367-4384-b3df-eecf18f7a6a1

	/// Footer line on the Mineral Titles extract card.
	measure 'Hub Updated Mineral Titles' = "Source: Mineral Titles Online"
		displayFolder: Hub
		lineageTag: 3965db98-4b28-4c4f-814d-a87e723d1bef

	/// Footer line on the Dictionary and lineage card.
	measure 'Hub Updated Dictionary' = "Maintained by MDS"
		displayFolder: Hub
		lineageTag: 4b99223e-5959-402a-8b58-95d45f20d9ab

	/// Hub what-changed line for Inspections, written for field and planning use.
	measure 'Hub Changed Inspections Ops' = VAR d = TODAY () VAR sy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR pfy = "FY" & FORMAT ( sy - 1, "0000" ) & "/" & RIGHT ( FORMAT ( sy, "0000" ), 2 ) RETURN FORMAT ( [Inspections FYTD], "#,0" ) & " completed FYTD against " & FORMAT ( [Inspections Same Time Last FY], "#,0" ) & " at the same point last year. " & pfy & " closed at " & FORMAT ( [Inspections Prev FY Total], "#,0" ) & " against a " & FORMAT ( [Inspections Service Plan Target], "#,0" ) & " target - the planning map is what steers which sites are visited next."
		displayFolder: Hub
		lineageTag: cdd90d85-1b08-41d7-9008-e6f888458906

	/// Hub what-changed line for the Inspection planning map.
	measure 'Hub Changed Planning Map' = "Provisional. Risk criteria are not yet agreed, so the tile is visible and labelled rather than hidden - the operational tier explicitly rejected hiding unvalidated metrics."
		displayFolder: Hub
		lineageTag: a03f3563-517c-4a8f-b414-7d2abac1a518

	/// Hub what-changed line for Notice of Work, written for permitting staff.
	measure 'Hub Changed NoW Permitting' = "Now live. New permits and amendments issued by fiscal year and month, excluding administrative amendments - open the report for current figures."
		displayFolder: Hub
		lineageTag: 3e46207b-14a6-448c-8cdd-d7d913482227

	/// Hub what-changed line for administrative amendments.
	measure 'Hub Changed Admin Amendments' = "Administrative amendments are excluded from the headline permit count and carried as a separate series. Worth separating in any turnaround measure rather than folding them in."
		displayFolder: Hub
		lineageTag: 63623fc5-a1cd-47f6-8b0f-541261c3199f

	/// Hub what-changed line for the Mineral Titles extract.
	measure 'Hub Changed Mineral Titles' = "Provisional. Sourced from Mineral Titles Online - the join to permitted sites is not yet certified, so the tile is labelled rather than hidden."
		displayFolder: Hub
		lineageTag: b64f2f02-5f52-47bf-9de8-0bb14c64d9d7

	/// Saved audit window - current fiscal year to date. Dates recalculate.
	measure 'Hub Window FYTD' = VAR d = TODAY () VAR sy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN "1 April " & FORMAT ( sy, "0000" ) & " to " & FORMAT ( d, "d MMMM yyyy" ) & " - all three reports, applied at page level and overridable per visual."
		displayFolder: Hub
		lineageTag: d6bce1de-4f1c-4fb7-908b-6e349692621f

	/// Saved audit window - same period last fiscal year. Dates recalculate.
	measure 'Hub Window Same Last FY' = VAR d = TODAY () VAR sy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN "1 April " & FORMAT ( sy - 1, "0000" ) & " to " & FORMAT ( DATE ( YEAR ( d ) - 1, MONTH ( d ), DAY ( d ) ), "d MMMM yyyy" ) & " - the comparison behind every same time last FY figure on the executive view."
		displayFolder: Hub
		lineageTag: e40b4a3a-6a14-4d77-849f-21fd4cf1168e

	/// Saved audit window - rolling five fiscal years. Dates recalculate.
	measure 'Hub Window Rolling 5' = VAR d = TODAY () VAR sy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN "FY" & FORMAT ( sy - 5, "0000" ) & "/" & RIGHT ( FORMAT ( sy - 4, "0000" ), 2 ) & " to FY" & FORMAT ( sy - 1, "0000" ) & "/" & RIGHT ( FORMAT ( sy, "0000" ), 2 ) & " - the window behind the Service Plan target trend and the NoW type mix."
		displayFolder: Hub
		lineageTag: 610220d1-ab30-4396-aff1-a11767042329

	/// Definitions page - the DEFINITION line of the worked example.
	measure 'Hub Def Inspections FYTD' = VAR d = TODAY () VAR sy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fy = RIGHT ( FORMAT ( sy, "0000" ), 2 ) & "/" & RIGHT ( FORMAT ( sy + 1, "0000" ), 2 ) RETURN "Inspections FYTD " & fy & ": count of distinct inspection records with a completed date falling in the current fiscal year to date. Includes Site Visit, Compliance Review, Inspection, Desktop and Meeting types."
		displayFolder: Hub
		lineageTag: a14d0751-06c1-4ffa-a597-e18273295779

	/// Definitions page - the SOURCE line of the worked example.
	measure 'Hub Def Source' = "CORE and NRIS to bronze to silver to gold.fact_inspection, served through the Gold Inspections Semantic Model in Direct Lake mode."
		displayFolder: Hub
		lineageTag: 4e5f8b1d-435b-4b27-b6ba-fd51e31176d7

	/// Definitions page - the LAST REFRESH line. Reads the data, not a typed date.
	measure 'Hub Def Last Refresh' = "Data current through " & FORMAT ( MAX ( fact_inspection[inspection_date] ), "d MMMM yyyy" ) & ". Refresh cadence is monthly until the pipeline runs daily."
		displayFolder: Hub
		lineageTag: 10815d6c-2996-4b57-be0a-9095af96a2e0

	/// Definitions page - the VALIDATED BY line.
	measure 'Hub Def Validated By' = "Reconciled against the Ministry corporate report before publication. Fabric Certify is admin-gated, so Promoted is the highest endorsement we can set today."
		displayFolder: Hub
		lineageTag: 7a535d55-192c-4087-8303-052f84f9fed8

	/// Definitions page - fiscal calendar rule. Recalculates each year.
	measure 'Hub Rule Fiscal Year' = VAR d = TODAY () VAR sy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN "April to March. FY" & RIGHT ( FORMAT ( sy, "0000" ), 2 ) & "/" & RIGHT ( FORMAT ( sy + 1, "0000" ), 2 ) & " runs 1 April " & FORMAT ( sy, "0000" ) & " to 31 March " & FORMAT ( sy + 1, "0000" ) & ". Every FYTD figure is measured to today within that window."
		displayFolder: Hub
		lineageTag: 6991e367-20ae-481d-ae64-67c7330aa8ee

	/// Definitions page - inspection counting rule.
	measure 'Hub Rule Inspections' = "Distinct inspection_id counted on inspection_date. No de-duplication by mine or inspector - one inspection record is one inspection."
		displayFolder: Hub
		lineageTag: dba24731-9e4e-476c-b61e-3efe9437d08a

	/// Definitions page - Notice of Work counting rule.
	measure 'Hub Rule NoW' = "Distinct permit_id counted on issue_date, filtered to permit-side ACT status. Administrative amendments are excluded from the headline and reported as a separate series."
		displayFolder: Hub
		lineageTag: ccd692d5-85ad-4600-95bc-509be7c97a02

	/// Definitions page - Service Plan target rule.
	measure 'Hub Rule Target' = "Service Plan target of " & FORMAT ( [Inspections Service Plan Target], "#,0" ) & " inspections per fiscal year, drawn as a reference line rather than a data series so it never enters a count."
		displayFolder: Hub
		lineageTag: a3d49061-64d9-4754-9da8-a93253b1966f

	/// Access state - the line under the request-access buttons.
	measure 'Hub Access Note' = "Access is granted by audience, not by report. Rajneesh Gulati or Nhung Nguyen can add you to the right one."
		displayFolder: Hub
		lineageTag: 39366f03-b735-454e-a847-675a1674c874

	/// Stale-refresh state - the warning banner. Dates come from the data.
	measure 'Hub Stale Warning' = "The " & FORMAT ( EOMONTH ( TODAY (), 0 ) + 1, "d MMMM" ) & " refresh has not completed. Figures below are still as at " & FORMAT ( MAX ( fact_inspection[inspection_date] ), "d MMMM yyyy" ) & " and should not be quoted as current. MDS is notified automatically."
		displayFolder: Hub
		lineageTag: c13ea8f3-7406-423c-8b8c-b64d4ab6ccb4

	/// Object page - DEFINITION line for Inspections Total.
	measure 'Obj Def Total' = "Every inspection ever recorded. Distinct count of inspection_id, all types, no date filter."
		displayFolder: Object
		lineageTag: 0b1e0000-0000-4000-8000-000000000000

	/// Object page - DEFINITION line for Inspections FYTD.
	measure 'Obj Def FYTD' = "Inspections whose inspection_date falls in the current BC fiscal year, up to and including today. Distinct inspection_id, all types."
		displayFolder: Object
		lineageTag: 0b1e0001-0000-4000-8000-000000000001

	/// Object page - DEFINITION line for Inspections Same Time Last FY.
	measure 'Obj Def Same Last FY' = "The same window one year earlier, so the comparison is like-for-like: 1 April of last fiscal year to this date last year."
		displayFolder: Object
		lineageTag: 0b1e0002-0000-4000-8000-000000000002

	/// Object page - DEFINITION line for Inspections Last Month.
	measure 'Obj Def Last Month' = "Inspections in the rolling previous 30 days. Matches the Metabase ""Inspection Date Previous 30 Days"" filter - it is NOT last calendar month."
		displayFolder: Object
		lineageTag: 0b1e0003-0000-4000-8000-000000000003

	/// Object page - DEFINITION line for Inspections Prev FY Total.
	measure 'Obj Def Prev FY' = "Every inspection in the last completed fiscal year, 1 April to 31 March."
		displayFolder: Object
		lineageTag: 0b1e0004-0000-4000-8000-000000000004

	/// Object page - the actual date window behind Inspections Total.
	measure 'Obj Win Total' = VAR a = MIN ( fact_inspection[inspection_date] ) VAR b = MAX ( fact_inspection[inspection_date] ) RETURN IF ( ISBLANK ( a ), "No inspection dates present", FORMAT ( a, "d MMMM yyyy" ) & " to " & FORMAT ( b, "d MMMM yyyy" ) & "  (all data)" )
		displayFolder: Object
		lineageTag: 0b1e0005-0000-4000-8000-000000000005

	/// Object page - the exact date window behind Inspections FYTD. Recalculates daily.
	measure 'Obj Win FYTD' = VAR d = TODAY () VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN FORMAT ( DATE ( fy, 4, 1 ), "d MMMM yyyy" ) & " to " & FORMAT ( d, "d MMMM yyyy" ) & "  (inclusive)"
		displayFolder: Object
		lineageTag: 0b1e0006-0000-4000-8000-000000000006

	/// Object page - the exact date window behind Inspections Same Time Last FY.
	measure 'Obj Win Same Last FY' = VAR d = TODAY () VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN FORMAT ( DATE ( fy - 1, 4, 1 ), "d MMMM yyyy" ) & " to " & FORMAT ( EDATE ( d, -12 ), "d MMMM yyyy" ) & "  (inclusive)"
		displayFolder: Object
		lineageTag: 0b1e0007-0000-4000-8000-000000000007

	/// Object page - the exact date window behind Inspections Last Month.
	measure 'Obj Win Last Month' = VAR d = TODAY () RETURN FORMAT ( d - 30, "d MMMM yyyy" ) & " to " & FORMAT ( d - 1, "d MMMM yyyy" ) & "  (rolling 30 days)"
		displayFolder: Object
		lineageTag: 0b1e0008-0000-4000-8000-000000000008

	/// Object page - the exact date window behind Inspections Prev FY Total.
	measure 'Obj Win Prev FY' = VAR d = TODAY () VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN FORMAT ( DATE ( fy - 1, 4, 1 ), "d MMMM yyyy" ) & " to " & FORMAT ( DATE ( fy, 3, 31 ), "d MMMM yyyy" )
		displayFolder: Object
		lineageTag: 0b1e0009-0000-4000-8000-000000000009

	/// Object page - trust tag for Inspections Total. All-time count needs no window coverage.
	measure 'Obj Trust Total' = "Certified"
		displayFolder: Object
		lineageTag: 0b1e0010-0000-4000-8000-000000000010

	/// Object page - trust tag for Inspections FYTD. Drops to Provisional when gold does not cover the whole window - the automated check the 21 Jul 'blue tick' discussion asked for, in its simplest form.
	measure 'Obj Trust FYTD' = VAR mx = CALCULATE ( MAX ( fact_inspection[inspection_date] ), ALL ( fact_inspection ) ) VAR d = TODAY () VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR needed = d RETURN IF ( ISBLANK ( mx ), "Not validated", IF ( mx >= needed, "Certified", "Provisional" ) )
		displayFolder: Object
		lineageTag: 0b1e0011-0000-4000-8000-000000000011

	/// Object page - trust tag for Inspections Same Time Last FY.
	measure 'Obj Trust Same Last FY' = VAR mx = CALCULATE ( MAX ( fact_inspection[inspection_date] ), ALL ( fact_inspection ) ) VAR needed = EDATE ( TODAY (), -12 ) RETURN IF ( ISBLANK ( mx ), "Not validated", IF ( mx >= needed, "Certified", "Provisional" ) )
		displayFolder: Object
		lineageTag: 0b1e0012-0000-4000-8000-000000000012

	/// Object page - trust tag for Inspections Last Month. Reads Provisional today because gold ends 7 July.
	measure 'Obj Trust Last Month' = VAR mx = CALCULATE ( MAX ( fact_inspection[inspection_date] ), ALL ( fact_inspection ) ) VAR needed = TODAY () - 1 RETURN IF ( ISBLANK ( mx ), "Not validated", IF ( mx >= needed, "Certified", "Provisional" ) )
		displayFolder: Object
		lineageTag: 0b1e0013-0000-4000-8000-000000000013

	/// Object page - trust tag for Inspections Prev FY Total.
	measure 'Obj Trust Prev FY' = VAR mx = CALCULATE ( MAX ( fact_inspection[inspection_date] ), ALL ( fact_inspection ) ) VAR d = TODAY () VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR needed = DATE ( fy, 3, 31 ) RETURN IF ( ISBLANK ( mx ), "Not validated", IF ( mx >= needed, "Certified", "Provisional" ) )
		displayFolder: Object
		lineageTag: 0b1e0014-0000-4000-8000-000000000014

	/// Object page - plain-language statement of what the data does and does not cover.
	measure 'Obj Coverage Note' = VAR mx = CALCULATE ( MAX ( fact_inspection[inspection_date] ), ALL ( fact_inspection ) ) VAR d = TODAY () VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) RETURN IF ( ISBLANK ( mx ), "No inspection data is present in gold.", IF ( mx >= d, "Gold covers the full fiscal year to date - every window on this page is complete.", "Gold ends " & FORMAT ( mx, "d MMMM yyyy" ) & ", so windows running past that date are incomplete. Figures are shown and labelled rather than hidden." ) )
		displayFolder: Object
		lineageTag: 0b1e0015-0000-4000-8000-000000000015

	/// Object page - where this object sits in the bronze / silver / gold medallion, per the 5 Aug ask.
	measure 'Obj Layer' = "Gold  ·  lh_gold.fact_inspection"
		displayFolder: Object
		lineageTag: 0b1e0016-0000-4000-8000-000000000016

	/// Object page - the object's shape in one line, straight from the data.
	measure 'Obj Record Count' = VAR n = DISTINCTCOUNT ( fact_inspection[inspection_id] ) VAR m = DISTINCTCOUNT ( fact_inspection[mine_guid] ) VAR t = DISTINCTCOUNT ( fact_inspection[inspection_type_id] ) RETURN FORMAT ( n, "#,0" ) & " inspections  ·  " & FORMAT ( m, "#,0" ) & " mines  ·  " & FORMAT ( t, "#,0" ) & " inspection types"
		displayFolder: Object
		lineageTag: 0b1e0017-0000-4000-8000-000000000017

	/// Object page - RELATIONSHIP line, Inspection to Mine.
	measure 'Obj Rel Mine' = VAR m = DISTINCTCOUNT ( fact_inspection[mine_guid] ) RETURN "Mine  —  " & FORMAT ( m, "#,0" ) & " related mines  ·  via mine_guid"
		displayFolder: Object
		lineageTag: 0b1e0018-0000-4000-8000-000000000018

	/// Object page - RELATIONSHIP line, Inspection to Inspection Type.
	measure 'Obj Rel Type' = VAR t = DISTINCTCOUNT ( fact_inspection[inspection_type_id] ) RETURN "Inspection Type  —  " & FORMAT ( t, "#,0" ) & " types  ·  via inspection_type_id"
		displayFolder: Object
		lineageTag: 0b1e0019-0000-4000-8000-000000000019

	/// Object page - RELATIONSHIP line, Inspection to Date.
	measure 'Obj Rel Date' = VAR a = MIN ( fact_inspection[inspection_date] ) VAR b = MAX ( fact_inspection[inspection_date] ) RETURN IF ( ISBLANK ( a ), "Date  —  no dates present", "Date  —  " & FORMAT ( a, "MMM yyyy" ) & " to " & FORMAT ( b, "MMM yyyy" ) & "  ·  via inspection_date_key" )
		displayFolder: Object
		lineageTag: 0b1e0020-0000-4000-8000-000000000020

	/// Object page - IDENTITY line. inspector_idir is the field Inspection carries that Notice of Work does not.
	measure 'Obj Identity Note' = VAR ins = DISTINCTCOUNT ( fact_inspection[inspector_idir] ) RETURN "Keyed on inspection_id  ·  " & FORMAT ( ins, "#,0" ) & " distinct inspectors recorded in inspector_idir"
		displayFolder: Object
		lineageTag: 0b1e0021-0000-4000-8000-000000000021

	/// Object page - display value for Inspections Total. Falls back to an em dash rather than rendering (blank), per the 5 Aug 'never show an empty card' rule.
	measure 'Obj Val Total' = VAR v = [Inspections Total] RETURN IF ( ISBLANK ( v ), "—", FORMAT ( v, "#,0" ) )
		displayFolder: Object
		lineageTag: 0b1e0022-0000-4000-8000-000000000022

	/// Object page - display value for Inspections FYTD. Falls back to an em dash rather than rendering (blank), per the 5 Aug 'never show an empty card' rule.
	measure 'Obj Val FYTD' = VAR v = [Inspections FYTD] RETURN IF ( ISBLANK ( v ), "—", FORMAT ( v, "#,0" ) )
		displayFolder: Object
		lineageTag: 0b1e0023-0000-4000-8000-000000000023

	/// Object page - display value for Inspections Same Time Last FY. Falls back to an em dash rather than rendering (blank), per the 5 Aug 'never show an empty card' rule.
	measure 'Obj Val Same Last FY' = VAR v = [Inspections Same Time Last FY] RETURN IF ( ISBLANK ( v ), "—", FORMAT ( v, "#,0" ) )
		displayFolder: Object
		lineageTag: 0b1e0024-0000-4000-8000-000000000024

	/// Object page - display value for Inspections Last Month. Falls back to an em dash rather than rendering (blank), per the 5 Aug 'never show an empty card' rule.
	measure 'Obj Val Last Month' = VAR v = [Inspections Last Month] RETURN IF ( ISBLANK ( v ), "—", FORMAT ( v, "#,0" ) )
		displayFolder: Object
		lineageTag: 0b1e0025-0000-4000-8000-000000000025

	/// Object page - display value for Inspections Prev FY Total. Falls back to an em dash rather than rendering (blank), per the 5 Aug 'never show an empty card' rule.
	measure 'Obj Val Prev FY' = VAR v = [Inspections Prev FY Total] RETURN IF ( ISBLANK ( v ), "—", FORMAT ( v, "#,0" ) )
		displayFolder: Object
		lineageTag: 0b1e0026-0000-4000-8000-000000000026

	/// Start year of the current BC fiscal year (Apr-Mar), from today.
	measure 'Enh Current FY' = VAR d = TODAY() VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fys = DATE ( fy, 4, 1 ) RETURN fy
		formatString: 0
		isHidden
		displayFolder: Enhanced
		lineageTag: 2d67ea19-4830-5bb6-96e3-9bb36a3b310d

	/// Fiscal month number of today (Apr = 1).
	measure 'Enh Current Fiscal Month' = VAR d = TODAY() RETURN MOD ( MONTH ( d ) - 4, 12 ) + 1
		formatString: 0
		isHidden
		displayFolder: Enhanced
		lineageTag: 076e6d8a-4ab6-5fa5-9fda-8e4ca390c4b2

	/// 1 on dim_date rows in the current fiscal year. Visual filter for the month charts.
	measure 'Enh Is Current FY' = IF ( MAX ( dim_date[fiscal_year] ) = [Enh Current FY], 1, 0 )
		formatString: 0
		isHidden
		displayFolder: Enhanced
		lineageTag: b261c524-8097-5170-94ad-83fdaefda238

	/// Inspections this fiscal year to date (Apr 1 to today). Ignores date filters.
	measure 'Enh FYTD' = CALCULATE ( [Inspections FYTD], REMOVEFILTERS ( dim_date ) )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 19d345f4-d576-5253-9e75-edf19a4f8dab

	/// Inspections last fiscal year from Apr 1 to the same day one year ago.
	measure 'Enh LY Same Point' = CALCULATE ( [Inspections Same Time Last FY], REMOVEFILTERS ( dim_date ) )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 03bcb9dc-5358-519b-b963-fcfa14eaac13

	/// Inspections in the whole of last fiscal year.
	measure 'Enh LY Total' = CALCULATE ( [Inspections Prev FY Total], REMOVEFILTERS ( dim_date ) )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: b5010bd5-d856-5e8c-bb4a-331e42c34201

	/// Service Plan measure 2a: at least 1,600 inspections a year.
	measure 'Enh Target' = [Inspections Service Plan Target]
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: a54862c1-65ac-5abf-82c3-cb59259a1b26

	measure 'Enh FYTD Change %' = DIVIDE ( [Enh FYTD] - [Enh LY Same Point], [Enh LY Same Point] )
		formatString: 0%
		displayFolder: Enhanced
		lineageTag: 32b50a55-dfc6-5f23-b6d8-add66cbb52a6

	/// Inspections so far in the current calendar month.
	measure 'Enh Month To Date' = VAR d = TODAY() RETURN CALCULATE ( DISTINCTCOUNT ( fact_inspection[inspection_id] ), REMOVEFILTERS ( dim_date ), fact_inspection[inspection_date] >= DATE ( YEAR ( d ), MONTH ( d ), 1 ), fact_inspection[inspection_date] < d + 1 )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: fe55a52e-1fc6-557f-95ac-15973e102c01

	/// Inspections in the same whole month last year.
	measure 'Enh Same Month LY' = VAR d = TODAY() VAR s = DATE ( YEAR ( d ) - 1, MONTH ( d ), 1 ) RETURN CALCULATE ( DISTINCTCOUNT ( fact_inspection[inspection_id] ), REMOVEFILTERS ( dim_date ), fact_inspection[inspection_date] >= s, fact_inspection[inspection_date] < EDATE ( s, 1 ) )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: e71e521a-ecda-58d3-be5f-72dff99f6036

	measure 'Enh Month Change %' = DIVIDE ( [Enh Month To Date] - [Enh Same Month LY], [Enh Same Month LY] )
		formatString: 0%
		displayFolder: Enhanced
		lineageTag: db64b605-0222-5b4b-9197-433b53ddcaad

	/// Year-end projection: this year so far, scaled by last year's full-year to same-point ratio.
	measure 'Enh Projected Year End' = ROUND ( DIVIDE ( [Enh FYTD] * [Enh LY Total], [Enh LY Same Point] ), 0 )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 0d6bfa5e-0379-511c-8140-f1f891c1aec2

	/// Projected year end minus 1,600.
	measure 'Enh Projected Gap' = [Enh Projected Year End] - [Enh Target]
		formatString: +#,0;-#,0;0
		displayFolder: Enhanced
		lineageTag: 90ac5bea-1d4e-573f-ac1a-7c0cb8aa6055

	measure 'Enh Months Left' = 12 - [Enh Current Fiscal Month]
		formatString: 0
		isHidden
		displayFolder: Enhanced
		lineageTag: 25ffa263-aeee-5cd9-8f00-8da908ded026

	/// Inspections needed each remaining month to reach 1,600.
	measure 'Enh Needed Per Month' = VAR left = [Enh Months Left] RETURN IF ( left > 0, ROUNDUP ( DIVIDE ( MAX ( 0, [Enh Target] - [Enh FYTD] ), left ), 0 ) )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 8a67098d-85b3-5e19-b904-d8adff59beac

	/// Last year's average per month over the same remaining months.
	measure 'Enh LY Per Month Same Stretch' = VAR d = TODAY() VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fys = DATE ( fy, 4, 1 ) VAR left = [Enh Months Left] VAR cfm = [Enh Current Fiscal Month] VAR lys = DATE ( fy - 1, 4, 1 ) VAR n = CALCULATE ( DISTINCTCOUNT ( fact_inspection[inspection_id] ), REMOVEFILTERS ( dim_date ), fact_inspection[inspection_date] >= EDATE ( lys, cfm ), fact_inspection[inspection_date] < fys ) RETURN IF ( left > 0, ROUND ( DIVIDE ( n, left ), 0 ) )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 1bd6af8a-2268-59da-9cd3-b07a97fad3b5

	measure 'Enh Pace Status' = VAR r = DIVIDE ( [Enh Projected Year End], [Enh Target] ) RETURN IF ( r >= 1, "On track", IF ( r >= 0.95, "Slightly behind", "Behind" ) )
		displayFolder: Enhanced
		lineageTag: ad0f442e-328c-5c55-9b74-468333075453

	measure 'Enh K1 Value' = FORMAT ( [Enh FYTD], "#,0" )
		displayFolder: Enhanced
		lineageTag: aaab507d-0ec1-53eb-8f4f-78b03cdec0dd

	measure 'Enh K1 Pill' = VAR v = [Enh FYTD Change %] RETURN IF ( ISBLANK ( v ), BLANK (), IF ( v >= 0, UNICHAR ( 9650 ) & " " & FORMAT ( ABS ( v ), "0%" ) & " higher", UNICHAR ( 9660 ) & " " & FORMAT ( ABS ( v ), "0%" ) & " lower" ) )
		displayFolder: Enhanced
		lineageTag: 3cf42f63-9ff1-5dd0-86cf-f11bcb4997ae

	measure 'Enh K1 Pill Color' = IF ( [Enh FYTD Change %] >= 0, "#1E7B4A", "#A4262C" )
		isHidden
		displayFolder: Enhanced
		lineageTag: 4475a617-acc5-5718-8594-752ed163bfab

	measure 'Enh K1 Pill Tint' = IF ( [Enh FYTD Change %] >= 0, "#E3F2E8", "#FBE7E8" )
		isHidden
		displayFolder: Enhanced
		lineageTag: ecd7a594-4e3a-5a7c-8448-7ed7c20c57c4

	measure 'Enh K1 Compare' = "than " & FORMAT ( [Enh LY Same Point], "#,0" ) & " at this point last year"
		displayFolder: Enhanced
		lineageTag: b9cd9299-369d-5e55-af12-9b44224b4840

	measure 'Enh K2 Title' = "IN " & UPPER ( FORMAT ( TODAY (), "MMMM" ) )
		displayFolder: Enhanced
		lineageTag: ca8f22eb-0483-5108-a967-010aadb6850c

	measure 'Enh K2 Value' = FORMAT ( [Enh Month To Date], "#,0" )
		displayFolder: Enhanced
		lineageTag: 693028ef-41db-517b-ba67-b631a1727d38

	measure 'Enh K2 Pill' = VAR v = [Enh Month Change %] RETURN IF ( ISBLANK ( v ), BLANK (), IF ( v >= 0, UNICHAR ( 9650 ) & " " & FORMAT ( ABS ( v ), "0%" ) & " higher", UNICHAR ( 9660 ) & " " & FORMAT ( ABS ( v ), "0%" ) & " lower" ) )
		displayFolder: Enhanced
		lineageTag: 7f6b3a5a-5750-59ea-9101-24eb201bf0cb

	measure 'Enh K2 Pill Color' = IF ( [Enh Month Change %] >= 0, "#1E7B4A", "#A4262C" )
		isHidden
		displayFolder: Enhanced
		lineageTag: b28df502-e35c-5394-82b2-d5c05345fb6c

	measure 'Enh K2 Pill Tint' = IF ( [Enh Month Change %] >= 0, "#E3F2E8", "#FBE7E8" )
		isHidden
		displayFolder: Enhanced
		lineageTag: b2f2afc9-fe20-50f1-8814-bc85941a9c8d

	measure 'Enh K2 Compare' = "than " & FORMAT ( [Enh Same Month LY], "#,0" ) & " in " & FORMAT ( EDATE ( TODAY (), -12 ), "MMMM yyyy" ) & ". Still filling in."
		displayFolder: Enhanced
		lineageTag: 92e78e39-be77-5599-834e-ed769cf46732

	measure 'Enh K3 Value' = FORMAT ( [Enh Projected Year End], "#,0" )
		displayFolder: Enhanced
		lineageTag: 8bd5391f-9723-5eb6-83ea-f1123764a066

	measure 'Enh K3 Pill' = VAR g = [Enh Projected Gap] RETURN IF ( g >= 0, FORMAT ( g, "#,0" ) & " over", FORMAT ( -g, "#,0" ) & " short" )
		displayFolder: Enhanced
		lineageTag: 19117fcf-72ad-547b-a1cb-c12cc30f5da1

	measure 'Enh K3 Pill Color' = IF ( [Enh Projected Gap] >= 0, "#1E7B4A", "#A4262C" )
		isHidden
		displayFolder: Enhanced
		lineageTag: 7348cf02-b05c-5b16-8299-9f47468c48f9

	measure 'Enh K3 Pill Tint' = IF ( [Enh Projected Gap] >= 0, "#E3F2E8", "#FBE7E8" )
		isHidden
		displayFolder: Enhanced
		lineageTag: c6eb3951-052d-5136-b936-93d8b407dd29

	measure 'Enh K3 Compare' = "of " & FORMAT ( [Enh Target], "#,0" ) & ", following last year's pattern"
		displayFolder: Enhanced
		lineageTag: 32ff8261-9fb7-5dc7-b836-f3feaa1e44aa

	measure 'Enh K4 Value' = IF ( [Enh Months Left] > 0, FORMAT ( [Enh Needed Per Month], "#,0" ), "–" )
		displayFolder: Enhanced
		lineageTag: 8338c06e-8e5f-5152-9fd6-d0ae68784e5f

	measure 'Enh K4 Pill' = VAR g = [Enh Needed Per Month] - [Enh LY Per Month Same Stretch] RETURN IF ( [Enh Months Left] = 0, BLANK (), IF ( g > 0, FORMAT ( g, "#,0" ) & " more a month", IF ( g < 0, FORMAT ( -g, "#,0" ) & " fewer a month", "same as last year" ) ) )
		displayFolder: Enhanced
		lineageTag: 1dcd02cd-0322-5f1a-82f1-2b491c781d0b

	measure 'Enh K4 Pill Color' = IF ( [Enh Needed Per Month] > [Enh LY Per Month Same Stretch], "#6B4E00", "#1E7B4A" )
		isHidden
		displayFolder: Enhanced
		lineageTag: 6361e4e8-67b4-5b5a-81f6-6e5e5ea7e8ee

	measure 'Enh K4 Pill Tint' = IF ( [Enh Needed Per Month] > [Enh LY Per Month Same Stretch], "#FFF4D6", "#E3F2E8" )
		isHidden
		displayFolder: Enhanced
		lineageTag: 1dcc00b7-c948-53d3-9b7d-25ae0a38f2f4

	measure 'Enh K4 Compare' = "than last year's " & FORMAT ( [Enh LY Per Month Same Stretch], "#,0" ) & " over the same months"
		displayFolder: Enhanced
		lineageTag: 6fbd0a91-bc1b-5b59-8e5d-cbd1215281d8

	/// Running total of inspections this fiscal year, by month.
	measure 'Enh Cum This Year' = IF ( MAX ( dim_date[fiscal_year] ) <> [Enh Current FY], BLANK (), VAR d = TODAY() VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fys = DATE ( fy, 4, 1 ) VAR mm = MAX ( dim_date[fiscal_month] ) VAR cfm = [Enh Current Fiscal Month] RETURN IF ( mm <= cfm, CALCULATE ( DISTINCTCOUNT ( fact_inspection[inspection_id] ), REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[full_date], fys, MIN ( EDATE ( fys, mm ) - 1, d ) ) ) ) )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 06839a54-7d33-5eca-8ee3-435d9f660f38

	/// Share of last year's total done by the end of this fiscal month last year.
	measure 'Enh LY Cum Share' = VAR d = TODAY() VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fys = DATE ( fy, 4, 1 ) VAR lys = DATE ( fy - 1, 4, 1 ) VAR mm = MAX ( dim_date[fiscal_month] ) VAR lyc = CALCULATE ( DISTINCTCOUNT ( fact_inspection[inspection_id] ), REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[full_date], lys, EDATE ( lys, mm ) - 1 ) ) RETURN DIVIDE ( lyc, [Enh LY Total] )
		formatString: 0.0%
		isHidden
		displayFolder: Enhanced
		lineageTag: a2348c3a-dcf3-592b-8d6b-a2dece0db853

	/// 1,600 spread over the year in last year's monthly pattern.
	measure 'Enh Pace for 1600' = IF ( MAX ( dim_date[fiscal_year] ) <> [Enh Current FY], BLANK (), ROUND ( [Enh Target] * [Enh LY Cum Share], 0 ) )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: c0150150-7c50-5734-a648-c6bc799ecb8e

	/// Projected running total from today to year end, following last year's pattern.
	measure 'Enh Projected Cum' = IF ( MAX ( dim_date[fiscal_year] ) <> [Enh Current FY], BLANK (), VAR mm = MAX ( dim_date[fiscal_month] ) VAR cfm = [Enh Current Fiscal Month] VAR shareCur = DIVIDE ( [Enh LY Same Point], [Enh LY Total] ) VAR sh = [Enh LY Cum Share] VAR f = [Enh FYTD] RETURN IF ( mm = cfm, f, IF ( mm > cfm, ROUND ( f + ( [Enh Projected Year End] - f ) * DIVIDE ( MAX ( 0, sh - shareCur ), 1 - shareCur ), 0 ) ) ) )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 2598dc2a-27fe-5549-a939-b677d6a11268

	/// Inspections ahead (+) or behind (-) the 1,600 pace at each month end; March shows the projected year end.
	measure 'Enh Pace Gap Bar' = IF ( MAX ( dim_date[fiscal_year] ) <> [Enh Current FY], BLANK (), VAR mm = MAX ( dim_date[fiscal_month] ) VAR cfm = [Enh Current Fiscal Month] RETURN IF ( mm < cfm, [Enh Cum This Year] - [Enh Pace for 1600], IF ( mm = cfm, [Enh FYTD] - ROUND ( [Enh Target] * DIVIDE ( [Enh LY Same Point], [Enh LY Total] ), 0 ), IF ( mm = 12, [Enh Projected Gap] ) ) ) )
		formatString: +#,0;-#,0;0
		displayFolder: Enhanced
		lineageTag: 9c56e742-b954-504a-a32c-5022c586d3bf

	measure 'Enh Pace Gap Color' = IF ( MAX ( dim_date[fiscal_year] ) <> [Enh Current FY], BLANK (), VAR mm = MAX ( dim_date[fiscal_month] ) VAR cfm = [Enh Current Fiscal Month] VAR g = [Enh Pace Gap Bar] RETURN IF ( mm > cfm, IF ( g >= 0, "#9FD3AE", "#E8A3A0" ), IF ( g >= 0, "#2E8540", "#CE3E39" ) ) )
		isHidden
		displayFolder: Enhanced
		lineageTag: 30d83ddb-976f-5f00-a233-72844521fd75

	measure 'Enh Coverage Label' = "FY2019/20 to FY" & [Enh Current FY] & "/" & RIGHT ( [Enh Current FY] + 1, 2 ) & " to date"
		displayFolder: Enhanced
		lineageTag: 8e907493-b9bd-5cc0-ab84-81abb57dfcb2

	measure 'Enh Alert Label' = "! Some " & FORMAT ( TODAY (), "MMMM" ) & " inspections may still be being entered in NRIS, so the last few weeks may go up a little. Data current through " & FORMAT ( CALCULATE ( MAX ( fact_inspection[inspection_date] ), REMOVEFILTERS () ), "d MMM yyyy" ) & "."
		displayFolder: Enhanced
		lineageTag: f1e9d1b4-8b5d-56cd-8d85-111de816bb36

	measure 'Enh H1' = FORMAT ( [Enh FYTD], "#,0" ) & " inspections so far. On last year's curve that lands around " & FORMAT ( [Enh Projected Year End], "#,0" ) & ", which is " & IF ( [Enh Projected Gap] >= 0, FORMAT ( [Enh Projected Gap], "#,0" ) & " over ", FORMAT ( - [Enh Projected Gap], "#,0" ) & " short of " ) & FORMAT ( [Enh Target], "#,0" ) & "."
		displayFolder: Enhanced
		lineageTag: accb2cec-c70b-5750-96fa-ce00aef4feb0

	measure 'Enh H1 Sub' = IF ( [Enh Months Left] > 0, "Getting there means about " & FORMAT ( [Enh Needed Per Month], "#,0" ) & " a month from here. Last year we did " & FORMAT ( [Enh LY Per Month Same Stretch], "#,0" ) & " a month over the same stretch.", "Last month of the fiscal year." )
		displayFolder: Enhanced
		lineageTag: 4339c6eb-4fda-5885-9f40-2208562e786f

	/// Published inspection totals (reference values from the report design; OCI to confirm).
	measure 'Enh Published 1' = SWITCH ( SELECTEDVALUE ( dim_date[fiscal_year_label] ), "FY2025/26", 1526, "FY2024/25", 1851, "FY2023/24", 1886 )
		formatString: #,0
		isHidden
		displayFolder: Enhanced
		lineageTag: 79a45120-4e0f-50c6-98cd-d3892776a6cc

	measure 'Enh Published 2' = SWITCH ( SELECTEDVALUE ( dim_date[fiscal_year_label] ), "FY2024/25", 1878 )
		formatString: #,0
		isHidden
		displayFolder: Enhanced
		lineageTag: 992deec0-292b-5165-aa48-699a7dda1cfc

	measure 'Enh Has Published' = IF ( NOT ISBLANK ( [Enh Published 1] ), 1, 0 )
		formatString: 0
		isHidden
		displayFolder: Enhanced
		lineageTag: bf32e125-8574-5eb9-8a7c-abc8f45cdfc3

	measure 'Enh This Report' = IF ( [Enh Has Published] = 1, [Inspections Total] )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 41f60936-f037-587f-afbc-fdf6eee39775

	measure 'Enh Published' = IF ( [Enh Has Published] = 1, FORMAT ( [Enh Published 1], "#,0" ) & IF ( NOT ISBLANK ( [Enh Published 2] ), " / " & FORMAT ( [Enh Published 2], "#,0" ) ) )
		displayFolder: Enhanced
		lineageTag: 2ecbb3c4-a8f8-50e9-b213-b0d6b0afbc01

	measure 'Enh Published Where' = SWITCH ( SELECTEDVALUE ( dim_date[fiscal_year_label] ), "FY2025/26", "Annual Service Plan Report, Aug 2026", "FY2024/25", "Chief Inspector's annual report / Annual Service Plan Report", "FY2023/24", "Annual Service Plan Report" )
		displayFolder: Enhanced
		lineageTag: 957cf299-6cae-5008-b4af-367787909511

	measure 'Enh Published Gap' = VAR t = [Inspections Total] VAR p1 = [Enh Published 1] VAR p2 = [Enh Published 2] VAR g1 = IF ( t < p1, FORMAT ( p1 - t, "#,0" ) & " fewer", IF ( t > p1, FORMAT ( t - p1, "#,0" ) & " more", "same" ) ) VAR g2 = IF ( t < p2, FORMAT ( p2 - t, "#,0" ) & " fewer", IF ( t > p2, FORMAT ( t - p2, "#,0" ) & " more", "same" ) ) RETURN IF ( [Enh Has Published] = 1, g1 & IF ( NOT ISBLANK ( p2 ), " / " & g2 ) )
		displayFolder: Enhanced
		lineageTag: 21f3c376-6ef7-5424-8312-247ebe756f0e

	measure 'Enh Published Note' = VAR t = [Inspections Total] VAR p1 = [Enh Published 1] VAR pct = DIVIDE ( ABS ( t - p1 ), p1 ) RETURN IF ( [Enh Has Published] = 1, IF ( NOT ISBLANK ( [Enh Published 2] ), "Two published numbers. OCI to confirm which one counts.", IF ( pct <= 0.003, "Within " & FORMAT ( pct, "0.0%" ), "Checking late NRIS entries" ) ) )
		displayFolder: Enhanced
		lineageTag: 6a1c137f-160b-5099-876a-7faf4851f903

	measure 'Enh Published Note Color' = IF ( NOT ISBLANK ( [Enh Published 2] ), "#A4262C", IF ( DIVIDE ( ABS ( [Inspections Total] - [Enh Published 1] ), [Enh Published 1] ) <= 0.003, "#1E7B4A", "#6B4E00" ) )
		isHidden
		displayFolder: Enhanced
		lineageTag: 7f184200-a703-5032-b0e6-a70c270f6ec0

	measure 'Enh LY Published' = CALCULATE ( [Enh Published 1], FILTER ( ALL ( dim_date[fiscal_year_label] ), dim_date[fiscal_year_label] = "FY" & ( [Enh Current FY] - 1 ) & "/" & RIGHT ( [Enh Current FY], 2 ) ) )
		formatString: #,0
		isHidden
		displayFolder: Enhanced
		lineageTag: 92649584-39f3-5b4b-b5b5-15dd83855ff2

	measure 'Enh LY Published Gap' = [Enh LY Total] - [Enh LY Published]
		formatString: +#,0;-#,0;0
		isHidden
		displayFolder: Enhanced
		lineageTag: c9e80b58-8204-5d5d-bb03-cd4b9cb8cceb

	measure 'Enh H2' = VAR g = ABS ( [Enh LY Published Gap] ) RETURN IF ( ISBLANK ( [Enh LY Published] ), "No published figure for last year yet.", "Last year's total is " & FORMAT ( g, "#,0" ) & " off the published figure." & IF ( DIVIDE ( g, [Enh LY Published] ) <= 0.01, " Close. But in a briefing, quote the published one.", " In a briefing, quote the published one." ) )
		displayFolder: Enhanced
		lineageTag: a9c3a8b0-a059-5204-9d2e-b3e41549e94e

	/// Inspections this fiscal year at major mines.
	measure 'Enh FYTD Major' = CALCULATE ( [Enh FYTD], dim_mine[major_mine_ind] = TRUE () )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: c2adeb5b-3a59-5771-883a-5e12e1a24bbc

	/// Inspections this fiscal year at regional (non-major) sites.
	measure 'Enh FYTD Regional' = CALCULATE ( [Enh FYTD], dim_mine[major_mine_ind] = FALSE () )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 99603116-dc79-5e7e-9622-4cf64025e747

	measure 'Enh Regional Share' = DIVIDE ( [Enh FYTD Regional], [Enh FYTD Major] + [Enh FYTD Regional] )
		formatString: 0%
		displayFolder: Enhanced
		lineageTag: 7b5e839a-cde1-5dca-b8ac-d569ef1b3438

	measure 'Enh Top Type' = VAR t = TOPN ( 1, VALUES ( dim_inspection_type[inspection_type_name] ), [Enh FYTD], DESC ) RETURN MAXX ( t, dim_inspection_type[inspection_type_name] )
		displayFolder: Enhanced
		lineageTag: d7277b6a-19b1-5152-98dc-825c965cd9c7

	measure 'Enh H3' = VAR s = [Enh Regional Share] VAR w = IF ( s >= 0.72 && s <= 0.78, "Nearly three in four", IF ( s >= 0.62 && s < 0.72, "About two in three", FORMAT ( s, "0%" ) & " of" ) ) RETURN w & " inspections this year were at regional sites. " & [Enh Top Type] & " inspections were the biggest share."
		displayFolder: Enhanced
		lineageTag: 07cfa6bc-f575-5e34-a6f7-02b2b4c06b04

	/// Major mines in the CORE register with status Operating.
	measure 'Enh Major Sites Active' = CALCULATE ( COUNTROWS ( dim_mine ), dim_mine[dl_iscurrent] = TRUE (), dim_mine[mine_operation_status_code] = "OP", dim_mine[major_mine_ind] = TRUE () )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: d1825ae5-365d-5ab1-a7cd-4975d8f6558a

	/// Operating major mines with at least one inspection in the last 12 months.
	measure 'Enh Major Sites Visited' = VAR d = TODAY() RETURN CALCULATE ( DISTINCTCOUNT ( fact_inspection[Mine_SK] ), REMOVEFILTERS ( dim_date ), dim_mine[dl_iscurrent] = TRUE (), dim_mine[mine_operation_status_code] = "OP", dim_mine[major_mine_ind] = TRUE (), fact_inspection[inspection_date] >= d - 365, fact_inspection[inspection_date] < d + 1 )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: e2439e71-0c78-5c9d-8e42-305fde4a715e

	measure 'Enh Major Sites Visited %' = DIVIDE ( [Enh Major Sites Visited], [Enh Major Sites Active] )
		formatString: 0%
		displayFolder: Enhanced
		lineageTag: 12f707da-b246-56d0-aca2-48c408310efb

	measure 'Enh Major Sites Label' = FORMAT ( [Enh Major Sites Visited], "#,0" ) & " of " & FORMAT ( [Enh Major Sites Active], "#,0" )
		displayFolder: Enhanced
		lineageTag: 1a673e90-991e-5659-8088-1f3d510a5acb

	/// Operating major sites with no inspection in the last 12 months.
	measure 'Enh Major Sites Not Visited' = [Enh Major Sites Active] - [Enh Major Sites Visited]
		formatString: #,0
		isHidden
		displayFolder: Enhanced
		lineageTag: d08ebb31-752e-5ed3-8f7c-dd43346cc1f3

	/// Regional mines in the CORE register with status Operating.
	measure 'Enh Regional Sites Active' = CALCULATE ( COUNTROWS ( dim_mine ), dim_mine[dl_iscurrent] = TRUE (), dim_mine[mine_operation_status_code] = "OP", dim_mine[major_mine_ind] = FALSE () )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 74a65f8a-c5d1-51de-a3fd-54eb67ae3bf4

	/// Operating regional mines with at least one inspection in the last 12 months.
	measure 'Enh Regional Sites Visited' = VAR d = TODAY() RETURN CALCULATE ( DISTINCTCOUNT ( fact_inspection[Mine_SK] ), REMOVEFILTERS ( dim_date ), dim_mine[dl_iscurrent] = TRUE (), dim_mine[mine_operation_status_code] = "OP", dim_mine[major_mine_ind] = FALSE (), fact_inspection[inspection_date] >= d - 365, fact_inspection[inspection_date] < d + 1 )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 32c8b2ac-cd75-5295-a6f4-6b74ed4069b2

	measure 'Enh Regional Sites Visited %' = DIVIDE ( [Enh Regional Sites Visited], [Enh Regional Sites Active] )
		formatString: 0%
		displayFolder: Enhanced
		lineageTag: fb6ec855-f944-5ce4-967e-2e9fc11e1e3e

	measure 'Enh Regional Sites Label' = FORMAT ( [Enh Regional Sites Visited], "#,0" ) & " of " & FORMAT ( [Enh Regional Sites Active], "#,0" )
		displayFolder: Enhanced
		lineageTag: 154fef36-aa69-5975-a6a2-204ce7cf2516

	/// Operating regional sites with no inspection in the last 12 months.
	measure 'Enh Regional Sites Not Visited' = [Enh Regional Sites Active] - [Enh Regional Sites Visited]
		formatString: #,0
		isHidden
		displayFolder: Enhanced
		lineageTag: 80b1cd31-293c-535a-9538-0b9487b2febe

	/// Inspections this fiscal year old enough (10+ days) for the 7-business-day report rule to apply.
	measure 'Enh Reports Due FYTD' = VAR s = DATE ( IF ( MONTH ( TODAY () ) >= 4, YEAR ( TODAY () ), YEAR ( TODAY () ) - 1 ), 4, 1 ) VAR e = TODAY () - 9 RETURN CALCULATE ( DISTINCTCOUNT ( fact_inspection[inspection_id] ), REMOVEFILTERS ( dim_date ), fact_inspection[inspection_date] >= s, fact_inspection[inspection_date] < e )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 18d7a754-1543-5349-b617-538e264954e2

	/// Of those, reports sent within 7 business days of the inspection (weekends excluded, stat holidays not).
	measure 'Enh Reports On Time FYTD' = VAR s = DATE ( IF ( MONTH ( TODAY () ) >= 4, YEAR ( TODAY () ), YEAR ( TODAY () ) - 1 ), 4, 1 ) VAR e = TODAY () - 9 RETURN CALCULATE ( SUMX ( FILTER ( fact_inspection, NOT ISBLANK ( fact_inspection[inspection_report_sent_date] ) ), VAR a = fact_inspection[inspection_date] VAR b = fact_inspection[inspection_report_sent_date] RETURN IF ( NETWORKDAYS ( DATE ( YEAR ( a ), MONTH ( a ), DAY ( a ) ), DATE ( YEAR ( b ), MONTH ( b ), DAY ( b ) ) ) - 1 <= 7, 1, 0 ) ), REMOVEFILTERS ( dim_date ), fact_inspection[inspection_date] >= s, fact_inspection[inspection_date] < e )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 81c9c6d0-994f-5de5-be92-d64fd596f122

	measure 'Enh Reports Due LY' = VAR s = DATE ( IF ( MONTH ( TODAY () ) >= 4, YEAR ( TODAY () ), YEAR ( TODAY () ) - 1 ) - 1, 4, 1 ) VAR e = DATE ( IF ( MONTH ( TODAY () ) >= 4, YEAR ( TODAY () ), YEAR ( TODAY () ) - 1 ), 4, 1 ) RETURN CALCULATE ( DISTINCTCOUNT ( fact_inspection[inspection_id] ), REMOVEFILTERS ( dim_date ), fact_inspection[inspection_date] >= s, fact_inspection[inspection_date] < e )
		formatString: #,0
		isHidden
		displayFolder: Enhanced
		lineageTag: c5fc6cf9-05cb-53ce-bcc6-cfce46fb4632

	measure 'Enh Reports On Time LY' = VAR s = DATE ( IF ( MONTH ( TODAY () ) >= 4, YEAR ( TODAY () ), YEAR ( TODAY () ) - 1 ) - 1, 4, 1 ) VAR e = DATE ( IF ( MONTH ( TODAY () ) >= 4, YEAR ( TODAY () ), YEAR ( TODAY () ) - 1 ), 4, 1 ) RETURN CALCULATE ( SUMX ( FILTER ( fact_inspection, NOT ISBLANK ( fact_inspection[inspection_report_sent_date] ) ), VAR a = fact_inspection[inspection_date] VAR b = fact_inspection[inspection_report_sent_date] RETURN IF ( NETWORKDAYS ( DATE ( YEAR ( a ), MONTH ( a ), DAY ( a ) ), DATE ( YEAR ( b ), MONTH ( b ), DAY ( b ) ) ) - 1 <= 7, 1, 0 ) ), REMOVEFILTERS ( dim_date ), fact_inspection[inspection_date] >= s, fact_inspection[inspection_date] < e )
		formatString: #,0
		isHidden
		displayFolder: Enhanced
		lineageTag: f9bee8db-1ee2-54d7-a0fc-9ed4b820a7c1

	measure 'Enh Reports On Time %' = DIVIDE ( [Enh Reports On Time FYTD], [Enh Reports Due FYTD] )
		formatString: 0%
		displayFolder: Enhanced
		lineageTag: ed26ec79-fdbd-57c7-87ce-e5474fc463d3

	measure 'Enh Reports On Time LY %' = DIVIDE ( [Enh Reports On Time LY], [Enh Reports Due LY] )
		formatString: 0%
		displayFolder: Enhanced
		lineageTag: a43bbc5a-3d6c-58e2-8625-c8379d9a0e59

	measure 'Enh R Value' = FORMAT ( [Enh Reports On Time %], "0%" )
		displayFolder: Enhanced
		lineageTag: 9363a069-59cd-5727-9a54-7482cb919454

	measure 'Enh R Pill' = VAR v = ROUND ( ( [Enh Reports On Time %] - [Enh Reports On Time LY %] ) * 100, 0 ) RETURN IF ( ISBLANK ( v ), BLANK (), IF ( v >= 0, UNICHAR ( 9650 ) & " " & FORMAT ( ABS ( v ), "#,0" ) & " points", UNICHAR ( 9660 ) & " " & FORMAT ( ABS ( v ), "#,0" ) & " points" ) )
		displayFolder: Enhanced
		lineageTag: 6de80290-77ec-5822-b348-9705351d467f

	measure 'Enh R Pill Color' = IF ( ROUND ( ( [Enh Reports On Time %] - [Enh Reports On Time LY %] ) * 100, 0 ) >= 0, "#1E7B4A", "#A4262C" )
		isHidden
		displayFolder: Enhanced
		lineageTag: 6f9ab3a0-9b2c-5aad-a071-2c2e096d2da9

	measure 'Enh R Pill Tint' = IF ( ROUND ( ( [Enh Reports On Time %] - [Enh Reports On Time LY %] ) * 100, 0 ) >= 0, "#E3F2E8", "#FBE7E8" )
		isHidden
		displayFolder: Enhanced
		lineageTag: 031ad4e4-4749-5fd1-a5e4-332cb18d1d2c

	measure 'Enh R Compare' = FORMAT ( [Enh Reports On Time FYTD], "#,0" ) & " of " & FORMAT ( [Enh Reports Due FYTD], "#,0" ) & ". Last year: " & FORMAT ( [Enh Reports On Time LY %], "0%" ) & "."
		displayFolder: Enhanced
		lineageTag: bc0fbcc6-4ddc-552a-b9fd-33142533bc07

	measure 'Enh H4' = FORMAT ( [Enh Reports On Time %], "0%" ) & " of reports went out within 7 business days. " & FORMAT ( [Enh Responses Overdue], "#,0" ) & " mine responses are late right now."
		displayFolder: Enhanced
		lineageTag: 174b8fd5-4451-5c64-892f-8b0dd606d6ac

	measure 'Enh H4 Sub' = "Last year " & FORMAT ( [Enh Reports On Time LY %], "0%" ) & " of reports went out within 7 business days. Half of mine responses arrive within " & FORMAT ( [Enh Median Days to Response], "#,0" ) & " days of the inspection."
		displayFolder: Enhanced
		lineageTag: 73d78e38-8bfa-5ed6-a61f-df705512f8e5

	measure 'Enh Short Version' = SWITCH ( [Enh Current Fiscal Month], 1, "One month", 2, "Two months", 3, "Three months", 4, "Four months", 5, "Five months", 6, "Six months", 7, "Seven months", 8, "Eight months", 9, "Nine months", 10, "Ten months", 11, "Eleven months", "Twelve months" ) & " into the fiscal year, we're " & IF ( [Enh Pace Status] = "On track", "on track for ", LOWER ( [Enh Pace Status] ) & " the pace for " ) & FORMAT ( [Enh Target], "#,0" ) & ". " & FORMAT ( [Enh Reports On Time %], "0%" ) & " of reports went out within 7 business days, and " & FORMAT ( [Enh Regional Share], "0%" ) & " of inspections were at regional sites."
		displayFolder: Enhanced
		lineageTag: 80e683dd-9268-503e-b603-0f1bec8f6527

	measure 'Enh S1' = [Enh Pace Status] & ". Heading for about " & FORMAT ( [Enh Projected Year End], "#,0" ) & "."
		displayFolder: Enhanced
		lineageTag: 039c5f4a-c909-56a3-93e3-b4bcfb7ab532

	measure 'Enh S2' = IF ( ISBLANK ( [Enh LY Published] ), "No published figure yet.", FORMAT ( ABS ( [Enh LY Published Gap] ), "#,0" ) & " off last year's published total." )
		displayFolder: Enhanced
		lineageTag: 8457364e-c0c9-573c-a0e1-46ac79d19e84

	measure 'Enh S3' = FORMAT ( [Enh Regional Share], "0%" ) & " of inspections at regional sites."
		displayFolder: Enhanced
		lineageTag: 6baa3687-2694-5882-828a-654cec9fedc1

	measure 'Enh S4' = FORMAT ( [Enh Responses Overdue], "#,0" ) & " mine responses are overdue."
		displayFolder: Enhanced
		lineageTag: a8c16636-92da-5ab7-a659-e98ea81d6ced

	/// Order items (Stop orders under the Mines Act) from inspections this fiscal year. Respects the category axis.
	measure 'Enh Orders FYTD' = VAR d = TODAY() VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fys = DATE ( fy, 4, 1 ) RETURN CALCULATE ( COUNTROWS ( fact_inspection_order ), fact_inspection_order[order_type] = "Stop", REMOVEFILTERS ( dim_date ), fact_inspection_order[inspection_date] >= fys, fact_inspection_order[inspection_date] < d + 1 ) + 0
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: eeb004e4-37b6-5898-8062-9f57474d3017

	measure 'Enh Orders Closed FYTD' = VAR d = TODAY() VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fys = DATE ( fy, 4, 1 ) RETURN CALCULATE ( COUNTROWS ( fact_inspection_order ), fact_inspection_order[order_type] = "Stop", REMOVEFILTERS ( dim_date ), fact_inspection_order[inspection_date] >= fys, fact_inspection_order[inspection_date] < d + 1, fact_inspection_order[stop_status] = "Closed" ) + 0
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: c195984b-98f5-5278-8f60-885be2ed38b6

	measure 'Enh Orders Open FYTD' = VAR d = TODAY() VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fys = DATE ( fy, 4, 1 ) RETURN CALCULATE ( COUNTROWS ( fact_inspection_order ), fact_inspection_order[order_type] = "Stop", REMOVEFILTERS ( dim_date ), fact_inspection_order[inspection_date] >= fys, fact_inspection_order[inspection_date] < d + 1, fact_inspection_order[stop_status] <> "Closed" ) + 0
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 4954ab88-ad18-5871-8d58-bf1659684364

	measure 'Enh Orders per Inspection' = DIVIDE ( [Enh Orders FYTD], [Enh FYTD] )
		formatString: 0.0
		displayFolder: Enhanced
		lineageTag: 78b6b3fc-f316-5407-8a9a-cc340393bc07

	/// Median days from the inspection to the mine's response, for orders from inspections this fiscal year.
	measure 'Enh Median Days to Response' = VAR d = TODAY() VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fys = DATE ( fy, 4, 1 ) RETURN CALCULATE ( MEDIAN ( fact_inspection_order[days_to_response] ), fact_inspection_order[order_type] = "Stop", REMOVEFILTERS ( dim_date ), fact_inspection_order[inspection_date] >= fys, fact_inspection_order[inspection_date] < d + 1 )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 94aa97a5-a5e4-5c1f-8c34-adfacc8e2766

	measure 'Enh Responses Due FYTD' = VAR d = TODAY() VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fys = DATE ( fy, 4, 1 ) RETURN CALCULATE ( COUNTROWS ( fact_inspection_order ), fact_inspection_order[order_type] = "Stop", REMOVEFILTERS ( dim_date ), fact_inspection_order[inspection_date] >= fys, fact_inspection_order[inspection_date] < d + 1, NOT ISBLANK ( fact_inspection_order[is_response_on_time] ) ) + 0
		formatString: #,0
		isHidden
		displayFolder: Enhanced
		lineageTag: cfc0b758-b963-510b-b265-7c7961527cba

	measure 'Enh Responses On Time FYTD' = VAR d = TODAY() VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fys = DATE ( fy, 4, 1 ) RETURN CALCULATE ( SUM ( fact_inspection_order[is_response_on_time] ), fact_inspection_order[order_type] = "Stop", REMOVEFILTERS ( dim_date ), fact_inspection_order[inspection_date] >= fys, fact_inspection_order[inspection_date] < d + 1 ) + 0
		formatString: #,0
		isHidden
		displayFolder: Enhanced
		lineageTag: 54055f73-1444-5f55-88f6-15b5b782e2f4

	/// Mine responses received on or before the order's due date, for orders from inspections this fiscal year.
	measure 'Enh Responses On Time %' = DIVIDE ( [Enh Responses On Time FYTD], [Enh Responses Due FYTD] )
		formatString: 0%
		displayFolder: Enhanced
		lineageTag: 93b8b36e-19cf-5515-9fd2-a0de430b8a93

	/// Open orders still waiting for a mine response past the due date, from inspections in the last 12 months.
	measure 'Enh Responses Overdue' = VAR d = TODAY() RETURN CALCULATE ( COUNTROWS ( fact_inspection_order ), fact_inspection_order[order_type] = "Stop", fact_inspection_order[is_response_overdue] = 1, REMOVEFILTERS ( dim_date ), fact_inspection_order[inspection_date] >= d - 365 ) + 0
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 2e86ca9b-e177-55a0-881b-06ac522795af

	measure 'Enh Oldest Overdue Days' = VAR d = TODAY() RETURN CALCULATE ( MAX ( fact_inspection_order[days_overdue] ), fact_inspection_order[order_type] = "Stop", fact_inspection_order[is_response_overdue] = 1, REMOVEFILTERS ( dim_date ), fact_inspection_order[inspection_date] >= d - 365 )
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 97b0f430-ed07-5066-9d04-bec33eac68f4

	measure 'Enh R2 Value' = FORMAT ( [Enh Responses On Time %], "0%" )
		displayFolder: Enhanced
		lineageTag: cf0a84ce-a482-55c1-afd8-282c833d7712

	measure 'Enh R2 Compare' = FORMAT ( [Enh Responses On Time FYTD], "#,0" ) & " of " & FORMAT ( [Enh Responses Due FYTD], "#,0" ) & " responses came in by the due date."
		displayFolder: Enhanced
		lineageTag: fa98e6ba-8aab-5106-9695-24cb4a855ae9

	measure 'Enh R3 Value' = FORMAT ( [Enh Responses Overdue], "#,0" )
		displayFolder: Enhanced
		lineageTag: b32db066-b3eb-5f8a-b3a4-0d12968d9dc8

	measure 'Enh R3 Compare' = IF ( [Enh Responses Overdue] = 0, "None overdue right now.", "Oldest is " & FORMAT ( [Enh Oldest Overdue Days], "#,0" ) & " days late." )
		displayFolder: Enhanced
		lineageTag: b89844e5-b80d-5b8a-aaa8-07354f5d6c26

	measure 'Enh Orders Subtitle' = FORMAT ( [Enh Orders FYTD], "#,0" ) & " order items from " & FORMAT ( [Enh FYTD], "#,0" ) & " inspections, about " & FORMAT ( [Enh Orders per Inspection], "0.0" ) & " per inspection"
		displayFolder: Enhanced
		lineageTag: a21631b6-1337-567d-aa1c-01b3a67ea080

	measure 'Enh Orders Closed Label' = FORMAT ( [Enh Orders Closed FYTD], "#,0" ) & " closed"
		displayFolder: Enhanced
		lineageTag: b69c7f05-23db-5ef2-b4fb-e8745f8bc2fd

	measure 'Enh Orders Open Label' = FORMAT ( [Enh Orders Open FYTD], "#,0" ) & " open"
		displayFolder: Enhanced
		lineageTag: bb3dceb4-bf99-51e3-90df-f79cbd334361

	measure 'Enh Median Days Label' = FORMAT ( [Enh Median Days to Response], "#,0" ) & " days"
		displayFolder: Enhanced
		lineageTag: 96a75b83-07b1-5d7c-8e1e-230daf28ab17

	/// Accompanied inspections (a First Nations attendee was recorded). Use with dim_date[fiscal_year_label].
	measure 'Enh Accompanied' = COUNTROWS ( fact_inspection_accompanied ) + 0
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: fd9047fa-7726-5f96-9129-32aa1027a82c

	measure 'Enh Accompanied FYTD' = VAR d = TODAY() VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fys = DATE ( fy, 4, 1 ) VAR s = DATE ( fy - 0, 4, 1 ) VAR e = IF ( 0 = 0, d + 1, DATE ( fy - 0 + 1, 4, 1 ) ) RETURN CALCULATE ( COUNTROWS ( fact_inspection_accompanied ), REMOVEFILTERS ( dim_date ), fact_inspection_accompanied[inspection_date] >= s, fact_inspection_accompanied[inspection_date] < e ) + 0
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 904a9587-e6e1-5a80-b2fc-9bb381ba3014

	measure 'Enh Accompanied LY' = VAR d = TODAY() VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fys = DATE ( fy, 4, 1 ) VAR s = DATE ( fy - 1, 4, 1 ) VAR e = IF ( 1 = 0, d + 1, DATE ( fy - 1 + 1, 4, 1 ) ) RETURN CALCULATE ( COUNTROWS ( fact_inspection_accompanied ), REMOVEFILTERS ( dim_date ), fact_inspection_accompanied[inspection_date] >= s, fact_inspection_accompanied[inspection_date] < e ) + 0
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: e925e463-187f-566e-805f-df7028ad2aba

	measure 'Enh Accompanied 2Y' = VAR d = TODAY() VAR fy = IF ( MONTH ( d ) >= 4, YEAR ( d ), YEAR ( d ) - 1 ) VAR fys = DATE ( fy, 4, 1 ) VAR s = DATE ( fy - 2, 4, 1 ) VAR e = IF ( 2 = 0, d + 1, DATE ( fy - 2 + 1, 4, 1 ) ) RETURN CALCULATE ( COUNTROWS ( fact_inspection_accompanied ), REMOVEFILTERS ( dim_date ), fact_inspection_accompanied[inspection_date] >= s, fact_inspection_accompanied[inspection_date] < e ) + 0
		formatString: #,0
		displayFolder: Enhanced
		lineageTag: 4e9c34ac-74a6-56ab-83bf-81949f75c950

	measure 'Enh Accompanied LY Share' = DIVIDE ( [Enh Accompanied LY], [Enh LY Total] )
		formatString: 0%
		displayFolder: Enhanced
		lineageTag: f9a66136-dd17-5ef0-be06-36b45036d43a

	measure 'Enh Is Last 4 FY' = VAR f = MAX ( dim_date[fiscal_year] ) VAR c = [Enh Current FY] RETURN IF ( f >= c - 3 && f <= c, 1, 0 )
		formatString: 0
		isHidden
		displayFolder: Enhanced
		lineageTag: 14314ced-9a36-51df-9c6b-e5ff68e94245

	measure 'Enh H5' = "Accompanied inspections went from " & FORMAT ( [Enh Accompanied 2Y], "#,0" ) & " two years ago to " & FORMAT ( [Enh Accompanied LY], "#,0" ) & " last year. We're at " & FORMAT ( [Enh Accompanied FYTD], "#,0" ) & " so far."
		displayFolder: Enhanced
		lineageTag: 69f1f943-9dfb-598a-89c2-fa64633ae889

	measure 'Enh H5 Sub' = "Last year that was " & FORMAT ( [Enh Accompanied LY], "#,0" ) & " of " & FORMAT ( [Enh LY Total], "#,0" ) & " inspections, about " & FORMAT ( [Enh Accompanied LY Share], "0%" ) & ". Shown by nation only where the agreement with that nation allows it."
		displayFolder: Enhanced
		lineageTag: 584345a1-9f29-5293-8686-a9096f1f4fa4

	measure 'Enh S5' = FORMAT ( [Enh Accompanied FYTD], "#,0" ) & " so far. It was " & FORMAT ( [Enh Accompanied 2Y], "#,0" ) & " two years ago."
		displayFolder: Enhanced
		lineageTag: 8ddf1fdb-eb7a-54f9-9eb8-364531005c68

