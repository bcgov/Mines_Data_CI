table ref_mmo_published
	lineageTag: 3d7e1092-24d6-4043-8793-581413a09867
	sourceLineageTag: [gold].[ref_mmo_published]

	/// Mines that actually produced, CIM & CPO 2024/25. Not in MDS.
	measure 'Pub Producing Mines' = CALCULATE ( SUM ( ref_mmo_published[value] ), KEEPFILTERS ( ref_mmo_published[metric_key] = "producing_mines" ) )
		formatString: #,##0
		displayFolder: Published (not in MDS)
		lineageTag: 5e3f5502-bc21-4d31-bce2-7439284835b6

	/// Card subtitle for producing mines.
	measure 'Pub Producing Split Label' = VAR m = CALCULATE ( SUM ( ref_mmo_published[value] ), ref_mmo_published[metric_key] = "producing_by_commodity", ref_mmo_published[category] = "Metal" ) VAR c = CALCULATE ( SUM ( ref_mmo_published[value] ), ref_mmo_published[metric_key] = "producing_by_commodity", ref_mmo_published[category] = "Coal" ) RETURN FORMAT ( m, "0" ) & " metal, " & FORMAT ( c, "0" ) & " coal · CIM & CPO 2024/25"
		displayFolder: Published (not in MDS)
		lineageTag: c2ea74ae-3aec-4545-a713-eb66310a497c

	/// Major projects approved in 2025/26, annual service plan report.
	measure 'Pub Projects Approved' = CALCULATE ( SUM ( ref_mmo_published[value] ), KEEPFILTERS ( ref_mmo_published[metric_key] = "projects_approved" ) )
		formatString: #,##0
		displayFolder: Published (not in MDS)
		lineageTag: 46779d2c-e9b5-4d8e-a5ea-6fba45f8beb8

	/// Major mine screening days, before vs now.
	measure 'Pub Approval Days' = CALCULATE ( SUM ( ref_mmo_published[value] ), KEEPFILTERS ( ref_mmo_published[metric_key] = "approval_days" ) )
		formatString: #,##0
		displayFolder: Published (not in MDS)
		lineageTag: c63138f5-2093-43a9-84ba-0ddda3555dff

	/// Assessment and permit months, separate vs coordinated.
	measure 'Pub Approval Months' = CALCULATE ( SUM ( ref_mmo_published[value] ), KEEPFILTERS ( ref_mmo_published[metric_key] = "approval_months" ) )
		formatString: #,##0
		displayFolder: Published (not in MDS)
		lineageTag: 07e8778a-0dc4-45e8-bee1-776e2d0445d1

	/// Inspections and reportable incidents, 2024/25, by major vs regional.
	measure 'Pub Count' = CALCULATE ( SUM ( ref_mmo_published[value] ), KEEPFILTERS ( ref_mmo_published[metric_key] IN { "inspections_share", "incidents_share" } ) )
		formatString: #,##0
		displayFolder: Published (not in MDS)
		lineageTag: cb709b0e-8a9d-44fc-9eef-56643e7be128

	/// Inspections at major mines by discipline, 2024/25.
	measure 'Pub Major Inspections by Discipline' = CALCULATE ( SUM ( ref_mmo_published[value] ), KEEPFILTERS ( ref_mmo_published[metric_key] = "major_insp_discipline" ) )
		formatString: #,##0
		displayFolder: Published (not in MDS)
		lineageTag: 0ebef2a9-708d-48c0-a41c-f6eed99105e4

	/// Share of all inspections at major mines, 2024/25.
	measure 'Pub Major Inspection Share' = DIVIDE ( CALCULATE ( SUM ( ref_mmo_published[value] ), ref_mmo_published[metric_key] = "inspections_share", ref_mmo_published[category] = "Major mines" ), CALCULATE ( SUM ( ref_mmo_published[value] ), ref_mmo_published[metric_key] = "inspections_share" ) )
		formatString: 0%
		displayFolder: Published (not in MDS)
		lineageTag: b5a79d0f-468a-4695-ac2d-5e060e9e6f9d

	/// Share of reportable incidents at major mines, 2024/25.
	measure 'Pub Major Incident Share' = DIVIDE ( CALCULATE ( SUM ( ref_mmo_published[value] ), ref_mmo_published[metric_key] = "incidents_share", ref_mmo_published[category] = "Major mines" ), CALCULATE ( SUM ( ref_mmo_published[value] ), ref_mmo_published[metric_key] = "incidents_share" ) )
		formatString: 0%
		displayFolder: Published (not in MDS)
		lineageTag: 46caa89e-b2c3-4821-af3e-21529e19b589

