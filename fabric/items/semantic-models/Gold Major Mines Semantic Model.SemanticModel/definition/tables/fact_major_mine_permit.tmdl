table fact_major_mine_permit
	lineageTag: 9a2fca9d-95b1-4c5e-ad39-294a02c8ba28
	sourceLineageTag: [gold].[fact_major_mine_permit]

	/// Metabase 3392 row count. Major Mine permit rows where the mine is Closed, Not Started or Operating. 205 on 7 Oct 2026.
	measure 'Major Mine Permits' = CALCULATE ( COUNTROWS ( fact_major_mine_permit ), fact_major_mine_permit[is_in_report_scope] = 1 )
		formatString: #,##0
		displayFolder: Major Mines KPIs
		lineageTag: 96dcc5ff-c319-492e-9680-1b1ce3be79be

	/// Distinct Major Mines in the 3392 scope (Closed, Not Started, Operating).
	measure 'Major Mines' = CALCULATE ( DISTINCTCOUNT ( fact_major_mine_permit[mine_guid] ), fact_major_mine_permit[is_in_report_scope] = 1 )
		formatString: #,##0
		displayFolder: Major Mines KPIs
		lineageTag: 205ffe68-b0eb-478d-9b01-d14223b5d203

	/// Distinct Major Mines with operation status Operating.
	measure 'Major Mines Operating' = CALCULATE ( DISTINCTCOUNT ( fact_major_mine_permit[mine_guid] ), fact_major_mine_permit[is_in_report_scope] = 1, fact_major_mine_permit[mine_operation_status_desc] = "Operating" )
		formatString: #,##0
		displayFolder: Major Mines KPIs
		lineageTag: 95ea46b2-6ecf-4bb1-8a68-7aaee35586e7

	/// Distinct Major Mines with operation status Closed.
	measure 'Major Mines Closed' = CALCULATE ( DISTINCTCOUNT ( fact_major_mine_permit[mine_guid] ), fact_major_mine_permit[is_in_report_scope] = 1, fact_major_mine_permit[mine_operation_status_desc] = "Closed" )
		formatString: #,##0
		displayFolder: Major Mines KPIs
		lineageTag: be736d8f-64e8-4256-9e22-7ccc470002dd

	/// Distinct Major Mines with operation status Not Started.
	measure 'Major Mines Not Started' = CALCULATE ( DISTINCTCOUNT ( fact_major_mine_permit[mine_guid] ), fact_major_mine_permit[is_in_report_scope] = 1, fact_major_mine_permit[mine_operation_status_desc] = "Not Started" )
		formatString: #,##0
		displayFolder: Major Mines KPIs
		lineageTag: a31f2a75-5d4b-43e4-8e0c-800c91108b1c

	/// Major Mine permit rows in scope with permit status Open.
	measure 'Major Mine Permits Open' = CALCULATE ( COUNTROWS ( fact_major_mine_permit ), fact_major_mine_permit[is_in_report_scope] = 1, fact_major_mine_permit[permit_status_code] = "O" )
		formatString: #,##0
		displayFolder: Major Mines KPIs
		lineageTag: cb5f7bd9-f419-453a-80b7-43354c6388cb

	/// Major Mine permit rows in scope with permit status Closed.
	measure 'Major Mine Permits Closed' = CALCULATE ( COUNTROWS ( fact_major_mine_permit ), fact_major_mine_permit[is_in_report_scope] = 1, fact_major_mine_permit[permit_status_code] = "C" )
		formatString: #,##0
		displayFolder: Major Mines KPIs
		lineageTag: 19063341-6056-496e-84d4-7110a4f84488


	/// Producing major mines (published, CIM & CPO 2024/25).
	measure 'Producing' = [Pub Producing Mines]
		formatString: #,##0
		displayFolder: Life stage
		lineageTag: 7dd5a1b7-f374-4131-b7c0-62345fd15d6b

	/// Status Operating in MDS but not counted as producing: construction, seasonal, industrial sites.
	measure 'Operating in MDS, not producing' = [Major Mines Operating] - [Pub Producing Mines]
		formatString: #,##0
		displayFolder: Life stage
		lineageTag: 654fbc57-c710-43df-b87f-d46328e962d9

	/// Major mines with status Not Started.
	measure 'Not started' = [Major Mines Not Started]
		formatString: #,##0
		displayFolder: Life stage
		lineageTag: ed527c86-d8e7-4012-9622-cd7ed9a651c1

	/// Closed major mines in care and maintenance.
	measure 'Could Restart (Care & Maintenance)' = CALCULATE ( [Major Mines Closed], KEEPFILTERS ( CONTAINSSTRING ( dim_mine[mine_life_stage], "Care" ) ) )
		formatString: #,##0
		displayFolder: Life stage
		lineageTag: d67adc60-c830-426d-8bcc-b7492ac38326

