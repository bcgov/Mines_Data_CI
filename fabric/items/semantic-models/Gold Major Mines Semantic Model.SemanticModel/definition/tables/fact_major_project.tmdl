table fact_major_project
	lineageTag: 9597bc03-b3d8-4091-bdd6-3fb2e963f9b3
	sourceLineageTag: [gold].[fact_major_project]

	/// Metabase 3387. Every project in project_summary, counted once. 107 on 2 Oct 2026.
	measure 'Total Major Projects' = DISTINCTCOUNT ( fact_major_project[project_summary_id] )
		formatString: #,##0
		displayFolder: Project KPIs
		lineageTag: 3efb820a-78ad-412f-998b-a12fa2a7131a

	/// Metabase 3388. Projects authorized under the Mines Act and not the EMA. 33 on 2 Oct 2026.
	measure 'Projects Mines Act Only' = CALCULATE ( DISTINCTCOUNT ( fact_major_project[project_summary_id] ), fact_major_project[act_group] = "Mines Act only" )
		formatString: #,##0
		displayFolder: Project KPIs
		lineageTag: 661af7b8-69d5-43c6-81f6-1b6400e56a12

	/// Metabase 3389. Projects authorized under the Environmental Management Act and not the Mines Act. 33 on 2 Oct 2026.
	measure 'Projects EMA Only' = CALCULATE ( DISTINCTCOUNT ( fact_major_project[project_summary_id] ), fact_major_project[act_group] = "EMA only" )
		formatString: #,##0
		displayFolder: Project KPIs
		lineageTag: e3e4cbaa-1658-4c64-b058-b98744966b89

	/// Metabase 3390. Projects authorized under both the Mines Act and the EMA. 24 on 2 Oct 2026.
	measure 'Projects Both Acts' = CALCULATE ( DISTINCTCOUNT ( fact_major_project[project_summary_id] ), fact_major_project[act_group] = "Both" )
		formatString: #,##0
		displayFolder: Project KPIs
		lineageTag: daf7c553-4da2-4676-aa37-03515504214d

	/// Metabase 3391. Projects under neither Act. 17 on 2 Oct 2026. The four buckets sum to Total Major Projects.
	measure 'Projects Other Acts' = CALCULATE ( DISTINCTCOUNT ( fact_major_project[project_summary_id] ), fact_major_project[act_group] = "Other" )
		formatString: #,##0
		displayFolder: Project KPIs
		lineageTag: 40b9518a-20fa-424e-b479-7dc4a4900b37

	/// Projects under the Mines Act, the EMA, or both. The base for the 3 and 6 month cards (Raj, 5 Oct 2026).
	measure 'Projects MA or EMA' = CALCULATE ( DISTINCTCOUNT ( fact_major_project[project_summary_id] ), fact_major_project[is_ma_or_ema] = 1 )
		formatString: #,##0
		displayFolder: Project KPIs
		lineageTag: a07c314b-7f76-465b-befb-cf9c71ff1c29

	/// MA or EMA projects submitted in the last 3 months, rolling from today on submission_date. Raj, 5 Oct 2026.
	measure 'Projects Last 3 Months' = VAR d = TODAY() RETURN CALCULATE ( DISTINCTCOUNT ( fact_major_project[project_summary_id] ), fact_major_project[is_ma_or_ema] = 1, fact_major_project[submission_date] > EDATE ( d, -3 ), fact_major_project[submission_date] <= d )
		formatString: #,##0
		displayFolder: Project KPIs
		lineageTag: e4e95b46-4da9-4188-b2ff-22bfac87915f

	/// MA or EMA projects submitted in the last 6 months, rolling from today on submission_date. Raj, 5 Oct 2026.
	measure 'Projects Last 6 Months' = VAR d = TODAY() RETURN CALCULATE ( DISTINCTCOUNT ( fact_major_project[project_summary_id] ), fact_major_project[is_ma_or_ema] = 1, fact_major_project[submission_date] > EDATE ( d, -6 ), fact_major_project[submission_date] <= d )
		formatString: #,##0
		displayFolder: Project KPIs
		lineageTag: cdd78abb-9f98-4de8-9dfe-1f5fab7445a3

	/// The 3 months before the last 3, for the delta on the 3-month card.
	measure 'Projects Prior 3 Months' = VAR d = TODAY() RETURN CALCULATE ( DISTINCTCOUNT ( fact_major_project[project_summary_id] ), fact_major_project[is_ma_or_ema] = 1, fact_major_project[submission_date] > EDATE ( d, -6 ), fact_major_project[submission_date] <= EDATE ( d, -3 ) )
		formatString: #,##0
		displayFolder: Project KPIs
		lineageTag: c704969e-dd3d-4d47-8d16-a1b0ffc54615

	/// Last 3 months minus the 3 before that.
	measure 'Projects Last 3 Months Delta' = [Projects Last 3 Months] - [Projects Prior 3 Months]
		formatString: +#,##0;-#,##0;0
		displayFolder: Project KPIs
		lineageTag: 0e9df427-c986-40fc-b6d1-b860c0d8b6d2

	/// MA or EMA projects by submission month, trailing 24 months. Axis: dim_date[fiscal_month_label].
	measure 'Projects per Month' = VAR d = TODAY() RETURN CALCULATE ( DISTINCTCOUNT ( fact_major_project[project_summary_id] ), fact_major_project[is_ma_or_ema] = 1, fact_major_project[submission_date] >= DATE ( YEAR ( d ) - 2, MONTH ( d ), 1 ), fact_major_project[submission_date] <= d )
		formatString: #,##0
		displayFolder: Project Trend
		lineageTag: a16c544d-e862-43b5-ad8a-f41d9feba0a2

	/// Header strip. Latest submission date not in the future.
	measure 'Project Data As Of Label' = VAR latest = CALCULATE ( MAX ( fact_major_project[submission_date] ), fact_major_project[submission_date] <= TODAY() ) RETURN "Project data current through " & FORMAT ( latest, "d MMM yyyy" )
		displayFolder: Labels
		lineageTag: 1f0fb1fa-247d-4983-a922-b6bbc88a5fe7

	/// Card subtitle for the 3-month window.
	measure 'Last 3 Months Label' = VAR d = TODAY() RETURN "Projects submitted " & FORMAT ( EDATE ( d, -3 ) + 1, "d MMM" ) & " to " & FORMAT ( d, "d MMM yyyy" )
		displayFolder: Labels
		lineageTag: e059448e-102d-4d9e-b675-7eaa7fa52c4d

	/// Card subtitle for the 6-month window.
	measure 'Last 6 Months Label' = VAR d = TODAY() RETURN "Projects submitted " & FORMAT ( EDATE ( d, -6 ) + 1, "d MMM" ) & " to " & FORMAT ( d, "d MMM yyyy" )
		displayFolder: Labels
		lineageTag: 183b4612-5c7f-4ed2-8de7-944bf83bc5b6

	/// Hidden 1/0 flag for the trend axis: months within the trailing 24 months.
	measure 'Is Last 24 Months' = VAR d = TODAY() VAR firstDay = MIN ( dim_date[full_date] ) RETURN IF ( NOT ISBLANK ( firstDay ) && firstDay >= DATE ( YEAR ( d ) - 2, MONTH ( d ), 1 ) && firstDay <= d, 1, 0 )
		formatString: 0
		displayFolder: Filters
		lineageTag: 7a291ea9-fe2e-4a6b-94cc-2352e376713f


	/// Projects that need a Mines Act permit: Mines Act only plus both Acts.
	measure 'Projects Need Mines Act' = [Projects Mines Act Only] + [Projects Both Acts]
		formatString: #,##0
		displayFolder: Project KPIs
		lineageTag: 31be6270-c868-4ee5-84eb-73eafc375378

	/// Projects not complete and not withdrawn (proxy stage). Overview card and stage bar.
	measure 'Enh Open Projects' = CALCULATE ( DISTINCTCOUNT ( fact_major_project[project_summary_id] ), fact_major_project[is_open] = 1, fact_major_project[deleted_ind] = FALSE )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 4c139ed9-4f3f-40ce-bde3-2d287c700983

	/// Mines with at least one open project.
	measure 'Enh Open Mines' = CALCULATE ( DISTINCTCOUNT ( fact_major_project[Mine_SK] ), fact_major_project[is_open] = 1, fact_major_project[deleted_ind] = FALSE, NOT ISBLANK ( fact_major_project[Mine_SK] ) )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: de2e9031-101f-4996-97fe-ea4293a31320

	/// Projects whose major mine application reached Complete, counted in the year it completed (dim_date[year] on the axis). Core has no decision date, so application complete is the proxy.
	measure 'Enh Completed' = VAR yrs = VALUES ( dim_date[year] ) RETURN CALCULATE ( DISTINCTCOUNT ( fact_major_project[project_summary_id] ), REMOVEFILTERS ( dim_date ), fact_major_project[deleted_ind] = FALSE, FILTER ( ALL ( fact_major_project[application_complete_date] ), NOT ISBLANK ( fact_major_project[application_complete_date] ) && YEAR ( fact_major_project[application_complete_date] ) IN yrs ) )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 9e993dd0-a0cb-4133-801e-baf70b24af45

	/// Applications completed this calendar year.
	measure 'Enh Completed This Year' = CALCULATE ( [Enh Completed], dim_date[year] = YEAR ( TODAY () ) )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 360bdcef-2839-47b6-bf75-0ca1cf582089

	/// Median days from project submission to application complete, for projects completed in the year(s) in context.
	measure 'Enh Median Days To Complete' = VAR yrs = VALUES ( dim_date[year] ) VAR t = CALCULATETABLE ( FILTER ( fact_major_project, NOT ISBLANK ( fact_major_project[application_complete_date] ) && NOT ISBLANK ( fact_major_project[submission_date] ) && fact_major_project[application_complete_date] >= fact_major_project[submission_date] && YEAR ( fact_major_project[application_complete_date] ) IN yrs ), REMOVEFILTERS ( dim_date ), fact_major_project[deleted_ind] = FALSE ) RETURN MEDIANX ( t, DATEDIFF ( fact_major_project[submission_date], fact_major_project[application_complete_date], DAY ) )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: c9bc1ceb-9fd0-4982-b9cd-4ff6cdf17a5f

	/// Open projects in application review, submitted more than a year ago.
	measure 'Enh Reviews Over A Year' = CALCULATE ( DISTINCTCOUNT ( fact_major_project[project_summary_id] ), fact_major_project[is_open] = 1, fact_major_project[deleted_ind] = FALSE, fact_major_project[proxy_stage] = "Application review", fact_major_project[days_since_submission] > 365 )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: f431ee2a-3037-46f6-b48c-382608ec1354

	/// Open projects submitted more than a year ago, any stage.
	measure 'Enh Open Over A Year' = CALCULATE ( DISTINCTCOUNT ( fact_major_project[project_summary_id] ), fact_major_project[is_open] = 1, fact_major_project[deleted_ind] = FALSE, fact_major_project[days_since_submission] > 365 )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: a8a7ccca-b67c-483f-8d93-ec0871534530

	/// Open projects with no project lead assigned in Core.
	measure 'Enh Open No Lead' = CALCULATE ( DISTINCTCOUNT ( fact_major_project[project_summary_id] ), fact_major_project[is_open] = 1, fact_major_project[deleted_ind] = FALSE, ISBLANK ( fact_major_project[project_lead_name] ) )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: c6dc3f44-d37c-4f32-8092-cff843525af7

	/// Open projects with no submission date, so days open cannot be counted (mostly drafts).
	measure 'Enh Open No Submission Date' = CALCULATE ( DISTINCTCOUNT ( fact_major_project[project_summary_id] ), fact_major_project[is_open] = 1, fact_major_project[deleted_ind] = FALSE, ISBLANK ( fact_major_project[submission_date] ) )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 88be936a-e125-4c1c-95e6-5f249f41d250

	/// Days since submission for the row (open projects only).
	measure 'Enh Days Open' = MAX ( fact_major_project[days_since_submission] )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: a6e6e39a-f9ce-4097-bf26-411844214ec0

	/// Mine and days of the longest-open project.
	measure 'Enh Longest Open Label' = VAR t = CALCULATETABLE ( fact_major_project, fact_major_project[is_open] = 1, fact_major_project[deleted_ind] = FALSE, NOT ISBLANK ( fact_major_project[days_since_submission] ) ) VAR top1 = TOPN ( 1, t, fact_major_project[days_since_submission], DESC ) VAR d = MAXX ( top1, fact_major_project[days_since_submission] ) VAR m = MAXX ( top1, RELATED ( dim_mine[mine_name] ) ) RETURN IF ( ISBLANK ( d ), "", m & ", at " & FORMAT ( d, "#,##0" ) & " days" )
		displayFolder: Enhanced
		lineageTag: 46dec41c-b439-452e-9935-26adfd8dceb9

	/// Overview page headline sentence.
	measure 'Enh Overview Headline' = VAR o = [Enh Open Projects] VAR m = [Enh Open Mines] VAR c = [Enh Completed This Year] VAR d = CALCULATE ( [Enh Median Days To Complete], dim_date[year] = YEAR ( TODAY () ) ) RETURN FORMAT ( o, "#,##0" ) & " projects are open across " & FORMAT ( m, "#,##0" ) & " mines. " & FORMAT ( c, "#,##0" ) & " applications were completed in " & YEAR ( TODAY () ) & IF ( ISBLANK ( d ), ".", ", at a median of " & FORMAT ( d, "#,##0" ) & " days from submission." )
		displayFolder: Enhanced
		lineageTag: eab2a31a-0406-4c4f-bd18-62ec2e688388

	/// Open projects page headline sentence.
	measure 'Enh Open Headline' = VAR n = [Enh Open Over A Year] RETURN FORMAT ( n, "#,##0" ) & " open projects were submitted over a year ago. The longest is " & [Enh Longest Open Label] & "."
		displayFolder: Enhanced
		lineageTag: ba85f42b-8b31-40bd-bdbd-3d50a7a9ecc1

	/// Subtitle for the completed card.
	measure 'Enh Completed Card Note' = VAR y = YEAR ( TODAY () ) VAR p = CALCULATE ( [Enh Completed], dim_date[year] = y - 1 ) RETURN "Application marked complete. " & FORMAT ( p, "#,##0" ) & " in " & ( y - 1 ) & "."
		displayFolder: Enhanced
		lineageTag: 2838242c-fa11-42ce-b56e-a31416eac506

	/// Data gap panel text on the Open projects page.
	measure 'Enh Data Gap Note' = "Core records the current stage only, not when a project entered it. Days count from the project's submission date. " & FORMAT ( [Enh Open No Submission Date], "#,##0" ) & " open projects have no submission date and " & FORMAT ( [Enh Open No Lead], "#,##0" ) & " have no lead. " & ( VAR bad = CALCULATE ( COUNTROWS ( fact_major_project ), fact_major_project[deleted_ind] = FALSE, FILTER ( ALL ( fact_major_project[submission_date], fact_major_project[application_complete_date] ), NOT ISBLANK ( fact_major_project[application_complete_date] ) && fact_major_project[application_complete_date] < fact_major_project[submission_date] ) ) RETURN IF ( bad > 0, FORMAT ( bad, "#,##0" ) & " project has an application dated before its submission date and is left out of the median.", "" ) )
		displayFolder: Enhanced
		lineageTag: 95eb7aac-0b02-48d5-894c-5de9ecd1733b

	/// Hidden 1/0 flag: years from the first completed application to this year. Chart filter.
	measure 'Enh Project Year In Range' = VAR y = MAX ( dim_date[year] ) VAR f = YEAR ( CALCULATE ( MIN ( fact_major_project[application_complete_date] ), REMOVEFILTERS ( dim_date ), fact_major_project[deleted_ind] = FALSE ) ) RETURN IF ( NOT ISBLANK ( f ) && y >= f && y <= YEAR ( TODAY () ), 1, 0 )
		formatString: 0
		displayFolder: Enhanced
		lineageTag: 9941d063-e38e-4021-95b0-7c3af8c9c62f

	/// Disclaimer text (Nhung, 10 Nov 2026).
	measure 'Enh Disclaimer' = "Not in Core yet, so not shown: decision date, fee level, project director, initiated by, stage dates and review rounds. 'Complete' means the major mine application is marked complete in Core. Days open count from the project's submission date."
		displayFolder: Enhanced
		lineageTag: 47b2a5d0-46b1-4eeb-8169-ae2af830c052

	/// Subtitle for the open projects card.
	measure 'Enh Open Note' = "Across " & FORMAT ( [Enh Open Mines], "#,##0" ) & " mines, from draft to application review"
		displayFolder: Enhanced
		lineageTag: 931c2a0c-c197-4396-91be-52bff0c00cb7

	/// Median days submission to application complete, for applications completed this year.
	measure 'Enh Median Days This Year' = CALCULATE ( [Enh Median Days To Complete], dim_date[year] = YEAR ( TODAY () ) )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 51bc3c82-cad1-4cb2-8e71-e254047543de

	/// Subtitle for the median card.
	measure 'Enh Median Note' = VAR y = YEAR ( TODAY () ) VAR p = CALCULATE ( [Enh Median Days To Complete], dim_date[year] = y - 1 ) RETURN "Submission to application complete. " & IF ( ISBLANK ( p ), "", FORMAT ( p, "#,##0" ) & " days in " & ( y - 1 ) & "." )
		displayFolder: Enhanced
		lineageTag: 3d5439df-4c07-4861-bec1-b2c436268bd0

	/// Subtitle for the over-a-year card.
	measure 'Enh Longest Note' = "Longest: " & [Enh Longest Open Label]
		displayFolder: Enhanced
		lineageTag: e6856f56-ddec-4997-9495-dea1130da707

	/// Title for the completed card.
	measure 'Enh Completed Title' = "APPLICATIONS COMPLETE IN " & YEAR ( TODAY () )
		displayFolder: Enhanced
		lineageTag: c0fdc22f-b902-4bb3-a48c-60292f0c4007

