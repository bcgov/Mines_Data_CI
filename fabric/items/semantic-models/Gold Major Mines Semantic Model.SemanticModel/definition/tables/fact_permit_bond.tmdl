table fact_permit_bond
	lineageTag: cf367fa5-e4a6-43a1-bb49-ba37ef004603
	sourceLineageTag: [gold].[fact_permit_bond]

	/// All coal and mineral permits (permit numbers not P, PM, G, Q, MX or CX).
	measure 'C/M Permits' = DISTINCTCOUNT ( fact_permit_bond[permit_id] )
		formatString: #,##0
		displayFolder: Permit KPIs
		lineageTag: 7d9c1e29-dba9-4575-a881-c707f024c89a

	/// Metabase 2868 row count. C/M permits that have at least one active bond. 96 on 2 Oct 2026.
	measure 'C/M Permits With Active Bond' = CALCULATE ( DISTINCTCOUNT ( fact_permit_bond[permit_id] ), fact_permit_bond[has_active_bond] = 1 )
		formatString: #,##0
		displayFolder: Permit KPIs
		lineageTag: 3db4c25d-54ee-4302-81f9-b8ae331412dc

	/// Sum of active bonds (bond_status_code = 'ACT') across C/M permits. Matches the Metabase bond_amount column.
	measure 'Active Bond Amount' = CALCULATE ( SUM ( fact_permit_bond[active_bond_amount] ), fact_permit_bond[has_active_bond] = 1 )
		formatString: \$#,##0
		displayFolder: Permit KPIs
		lineageTag: 9f1bd499-78ab-4cee-9635-6bd212a63bc7

	/// Liability adjustment from the LATEST amendment per permit (Raj, 5 Oct 2026). Differs from Metabase, which sums all amendments.
	measure 'Latest Liability Adjustment' = CALCULATE ( SUM ( fact_permit_bond[latest_liability_adjustment] ), fact_permit_bond[has_active_bond] = 1 )
		formatString: \$#,##0
		displayFolder: Permit KPIs
		lineageTag: daee50ee-8c5d-4a0e-9479-61aaef9322f0

	/// Sum of liability adjustment over ALL amendments. Kept only to tie out with Metabase 2868; not for the report.
	measure 'Liability Adjustment Total (Metabase)' = CALCULATE ( SUM ( fact_permit_bond[liability_adjustment_total] ), fact_permit_bond[has_active_bond] = 1 )
		formatString: \$#,##0
		displayFolder: Permit KPIs
		lineageTag: b9a9898e-6c67-45e0-8db7-696b0d25d9a3

	/// C/M permits with an active bond whose permit status is Open.
	measure 'Permits Open' = CALCULATE ( DISTINCTCOUNT ( fact_permit_bond[permit_id] ), fact_permit_bond[has_active_bond] = 1, fact_permit_bond[permit_status_code] = "O" )
		formatString: #,##0
		displayFolder: Permit KPIs
		lineageTag: 9892fe6d-1404-4e4f-b44a-9643235f4e86

	/// C/M permits with an active bond whose permit status is Closed.
	measure 'Permits Closed' = CALCULATE ( DISTINCTCOUNT ( fact_permit_bond[permit_id] ), fact_permit_bond[has_active_bond] = 1, fact_permit_bond[permit_status_code] = "C" )
		formatString: #,##0
		displayFolder: Permit KPIs
		lineageTag: dc12e0a3-df5c-446d-9797-83dd016945d8

	/// Header strip. Latest bond issue date not in the future.
	measure 'Bond Data As Of Label' = VAR latest = CALCULATE ( MAX ( fact_permit_bond[latest_bond_issue_date] ), fact_permit_bond[latest_bond_issue_date] <= TODAY() ) RETURN "Bond data current through " & FORMAT ( latest, "d MMM yyyy" )
		displayFolder: Labels
		lineageTag: db731631-e506-4f7d-847a-2539433beaa7


