table fact_notice_of_departure
	lineageTag: 1c6d4aca-20bf-4851-87b3-2b699d5019ae
	sourceLineageTag: [gold].[fact_notice_of_departure]

	/// Notices of departure received (by submission date on the date axis).
	measure 'Enh Notices' = CALCULATE ( COUNTROWS ( fact_notice_of_departure ), fact_notice_of_departure[deleted_ind] = FALSE )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: f2349740-946e-48e3-8dcf-4cc903170690

	/// Notices determined, counted in the year decided. Decision date = last update when the status is a determination (Core has no decision date).
	measure 'Enh Notices Decided' = VAR yrs = VALUES ( dim_date[year] ) RETURN CALCULATE ( COUNTROWS ( fact_notice_of_departure ), REMOVEFILTERS ( dim_date ), fact_notice_of_departure[deleted_ind] = FALSE, fact_notice_of_departure[is_decided] = 1, FILTER ( ALL ( fact_notice_of_departure[decision_date] ), YEAR ( fact_notice_of_departure[decision_date] ) IN yrs ) )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: d3f6af62-883e-4768-a7b3-1589022d0a74

	/// Median days from submission to determination.
	measure 'Enh Notices Median Days' = CALCULATE ( MEDIAN ( fact_notice_of_departure[days_to_decision] ), fact_notice_of_departure[deleted_ind] = FALSE, fact_notice_of_departure[is_decided] = 1 )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 745f1cf4-66dd-4ee3-b316-f73604233a03

	/// Share of determined notices found non-substantial (determined or self-determined).
	measure 'Enh Notices Non Substantial %' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_notice_of_departure ), fact_notice_of_departure[deleted_ind] = FALSE, fact_notice_of_departure[is_decided] = 1, fact_notice_of_departure[nod_status] <> "determined_substantial" ), CALCULATE ( COUNTROWS ( fact_notice_of_departure ), fact_notice_of_departure[deleted_ind] = FALSE, fact_notice_of_departure[is_decided] = 1 ) )
		formatString: 0%
		displayFolder: Enhanced
		lineageTag: 57e6dbc7-e017-4ae5-a875-4552fca45ca8

	/// Notices determined substantial (need a permit amendment).
	measure 'Enh Notices Substantial' = CALCULATE ( COUNTROWS ( fact_notice_of_departure ), fact_notice_of_departure[deleted_ind] = FALSE, fact_notice_of_departure[nod_status] = "determined_substantial" )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: c0d88d9c-a6a7-47ad-9e17-fe827e8371f8

	/// Notices not determined and not withdrawn.
	measure 'Enh Notices Open' = CALCULATE ( COUNTROWS ( fact_notice_of_departure ), fact_notice_of_departure[deleted_ind] = FALSE, fact_notice_of_departure[is_open] = 1 )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 42bbc748-b9d1-490f-bf5e-1f11bdff543c

	/// Open notices received more than a year ago.
	measure 'Enh Notices Open Over A Year' = CALCULATE ( COUNTROWS ( fact_notice_of_departure ), fact_notice_of_departure[deleted_ind] = FALSE, fact_notice_of_departure[is_open] = 1, fact_notice_of_departure[days_open] > 365 )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: c8c21898-5250-40a4-9fb7-f96a5ce79258

	/// Days open for the row.
	measure 'Enh Notices Days Open' = MAX ( fact_notice_of_departure[days_open] )
		formatString: #,##0
		displayFolder: Enhanced
		lineageTag: 35f64690-abca-449c-9f73-c177dfb5ef21

	/// First year with a notice.
	measure 'Enh Notices First Year' = YEAR ( CALCULATE ( MIN ( fact_notice_of_departure[submission_date] ), fact_notice_of_departure[deleted_ind] = FALSE, REMOVEFILTERS ( dim_date ) ) )
		formatString: 0
		displayFolder: Enhanced
		lineageTag: 3c2ece90-98e4-437a-92ff-765103b34b83

	/// Notices page headline sentence.
	measure 'Enh Notices Headline' = FORMAT ( [Enh Notices], "#,##0" ) & " notices tracked, " & FORMAT ( [Enh Notices Median Days], "#,##0" ) & " days to decide at the median. " & FORMAT ( [Enh Notices Open], "#,##0" ) & " are still open, " & FORMAT ( [Enh Notices Open Over A Year], "#,##0" ) & " for over a year."
		displayFolder: Enhanced
		lineageTag: 4ecce9e5-06bd-48be-8d93-78cce3f225b7

	/// Subtitle for the % card.
	measure 'Enh Notices Split Note' = FORMAT ( CALCULATE ( COUNTROWS ( fact_notice_of_departure ), fact_notice_of_departure[deleted_ind] = FALSE, fact_notice_of_departure[is_decided] = 1, fact_notice_of_departure[nod_status] <> "determined_substantial" ), "#,##0" ) & " non-substantial, " & FORMAT ( [Enh Notices Substantial], "#,##0" ) & " substantial"
		displayFolder: Enhanced
		lineageTag: 63babe63-6466-4b1b-8d08-fb06ca7293c6

	/// Subtitle for the still-open card.
	measure 'Enh Notices Open Note' = FORMAT ( [Enh Notices Open Over A Year], "#,##0" ) & " of them for more than a year"
		displayFolder: Enhanced
		lineageTag: 7150974a-f51d-43f6-8bde-20e72e9df72e

	/// Subtitle for the tracked card.
	measure 'Enh Notices Since Note' = "Since " & [Enh Notices First Year]
		displayFolder: Enhanced
		lineageTag: 0797e779-445c-4b2f-9eea-277a84d2f12a

	/// Subtitle for the median card.
	measure 'Enh Notices Decided Note' = "For the " & FORMAT ( CALCULATE ( COUNTROWS ( fact_notice_of_departure ), fact_notice_of_departure[deleted_ind] = FALSE, fact_notice_of_departure[is_decided] = 1 ), "#,##0" ) & " determined notices"
		displayFolder: Enhanced
		lineageTag: 5a59ccd1-b12b-4a7f-b39c-6202fe8427d7

	/// Hidden 1/0 flag: years from the first notice to this year. Chart filter.
	measure 'Enh NoD Year In Range' = VAR y = MAX ( dim_date[year] ) VAR f = [Enh Notices First Year] RETURN IF ( NOT ISBLANK ( f ) && y >= f && y <= YEAR ( TODAY () ), 1, 0 )
		formatString: 0
		displayFolder: Enhanced
		lineageTag: eadabde9-371e-43d6-9311-76aa363326f5

