{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "mines-fabric-adf01"
        },
        "LS_POSTGRES_MINES_password": {
            "type": "secureString",
            "metadata": "Secure string for 'password' of 'LS_POSTGRES_MINES'"
        },
        "ls_AZSQL_connectionString": {
            "type": "secureString",
            "metadata": "Secure string for 'connectionString' of 'ls_AZSQL'",
            "defaultValue": "Integrated Security=False;Encrypt=True;Connection Timeout=30;Data Source=@{linkedService().server},1433;Initial Catalog=@{linkedService().database}"
        },
        "ls_sql_server_connectionString": {
            "type": "secureString",
            "metadata": "Secure string for 'connectionString' of 'ls_sql_server'",
            "defaultValue": "integrated security=False;Data Source=@{linkedService().server};Initial Catalog=@{linkedService().database};User ID="
        },
        "LS_POSTGRES_MINES_properties_typeProperties_connectionString_secretName": {
            "type": "string",
            "defaultValue": "mines-fabric-kv01"
        },
        "fabric-kv01_properties_typeProperties_baseUrl": {
            "type": "string",
            "defaultValue": "https://mines-fabric-kv01.vault.azure.net/"
        },
        "ls_api_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "@{linkedService().base_URL}"
        },
        "ls_azure_gen2_storage_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "@{linkedService().storage_account_endpoint}"
        },
        "ls_fabric_warehouse_properties_typeProperties_endpoint": {
            "type": "string",
            "defaultValue": "abjnw3ynhwfevmbw2nuf4nm23q-rahtrd7fltiurh5f7o734jufua.datawarehouse.fabric.microsoft.com"
        },
        "ls_fabric_warehouse_properties_typeProperties_tenant": {
            "type": "string",
            "defaultValue": "$[globalParameters.ARM_TENANT_ID]"
        },
        "ls_fabric_warehouse_properties_typeProperties_servicePrincipalId": {
            "type": "object",
            "defaultValue": {
                "type": "AzureKeyVaultSecret",
                "store": {
                    "referenceName": "ls_keyvault",
                    "type": "LinkedServiceReference"
                },
                "secretName": "sp-client-id"
            }
        },
        "ls_keyvault_properties_typeProperties_baseUrl": {
            "type": "string",
            "defaultValue": "https://mines-fabric-kv01.vault.azure.net/"
        },
        "ls_s3_properties_typeProperties_accessKeyId": {
            "type": "string",
            "defaultValue": "@{linkedService().s3accesskey}"
        },
        "containerUri": {
            "type": "string",
            "metadata": "URI to storage account containing linked ARM templates"
        },
        "containerSasToken": {
            "type": "string",
            "metadata": "Sas token to storage account containing linked ARM templates"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "mines-fabric-adf01_ArmTemplate_0",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    },
                    "LS_POSTGRES_MINES_password": {
                        "value": "[parameters('LS_POSTGRES_MINES_password')]"
                    },
                    "ls_AZSQL_connectionString": {
                        "value": "[parameters('ls_AZSQL_connectionString')]"
                    },
                    "ls_sql_server_connectionString": {
                        "value": "[parameters('ls_sql_server_connectionString')]"
                    },
                    "LS_POSTGRES_MINES_properties_typeProperties_connectionString_secretName": {
                        "value": "[parameters('LS_POSTGRES_MINES_properties_typeProperties_connectionString_secretName')]"
                    },
                    "fabric-kv01_properties_typeProperties_baseUrl": {
                        "value": "[parameters('fabric-kv01_properties_typeProperties_baseUrl')]"
                    },
                    "ls_azure_gen2_storage_properties_typeProperties_url": {
                        "value": "[parameters('ls_azure_gen2_storage_properties_typeProperties_url')]"
                    },
                    "ls_keyvault_properties_typeProperties_baseUrl": {
                        "value": "[parameters('ls_keyvault_properties_typeProperties_baseUrl')]"
                    },
                    "ls_api_properties_typeProperties_url": {
                        "value": "[parameters('ls_api_properties_typeProperties_url')]"
                    },
                    "ls_fabric_warehouse_properties_typeProperties_endpoint": {
                        "value": "[parameters('ls_fabric_warehouse_properties_typeProperties_endpoint')]"
                    },
                    "ls_fabric_warehouse_properties_typeProperties_tenant": {
                        "value": "[parameters('ls_fabric_warehouse_properties_typeProperties_tenant')]"
                    },
                    "ls_fabric_warehouse_properties_typeProperties_servicePrincipalId": {
                        "value": "[parameters('ls_fabric_warehouse_properties_typeProperties_servicePrincipalId')]"
                    },
                    "ls_s3_properties_typeProperties_accessKeyId": {
                        "value": "[parameters('ls_s3_properties_typeProperties_accessKeyId')]"
                    }
                }
            },
            "dependsOn": []
        },
        {
            "name": "mines-fabric-adf01_ArmTemplate_1",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    }
                }
            },
            "dependsOn": [
                "[resourceId('Microsoft.Resources/deployments', 'mines-fabric-adf01_ArmTemplate_0')]"
            ]
        }
    ]
}