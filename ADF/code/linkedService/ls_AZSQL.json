{
    "name": "ls_AZSQL",
    "type": "Microsoft.DataFactory/factories/linkedservices",
    "properties": {
        "description": "Parameterised linked service for Azure SQL Database. Pass server and database at runtime; password pulled from Key Vault.",
        "parameters": {
            "server": {
                "type": "String",
                "defaultValue": ""
            },
            "database": {
                "type": "String",
                "defaultValue": ""
            }
        },
        "annotations": [],
        "type": "AzureSqlDatabase",
        "typeProperties": {
            "connectionString": "Data Source=@{linkedService().server},1433;Initial Catalog=@{linkedService().database};",
            "password": {
                "type": "AzureKeyVaultSecret",
                "store": {
                    "referenceName": "ls_keyvault",
                    "type": "LinkedServiceReference"
                },
                "secretName": "azsql-password"
            }
        }
    }
}
