{
	"name": "ls_databricks",
	"type": "Microsoft.DataFactory/factories/linkedservices",
	"properties": {
		"parameters": {
			"Databricks_Workspace": {
				"type": "string",
				"defaultValue": "https://adb-123345678910.11.azuredatabricks.net/"
			},
			"ADB_Workspace_Resource_Id": {
				"type": "string",
				"defaultValue": "/subscriptions/12345-1234-1234-1234-1234567890/resourceGroups/cdd-rg-01/providers/Microsoft.Databricks/workspaces/cdd-adb-02"
			}
		},
		"annotations": [],
		"type": "AzureDatabricks",
		"typeProperties": {
			"domain": "@linkedService().Databricks_Workspace",
			"authentication": "MSI",
			"workspaceResourceId": "@replace('/subscriptions/12345-1234-1234-1234-1234567890/resourceGroups/cdd-rg-01/providers/Microsoft.Databricks/workspaces/cdd-adb-01','/subscriptions/12345-1234-1234-1234-1234567890/resourceGroups/cdd-rg-01/providers/Microsoft.Databricks/workspaces/cdd-adb-01',linkedService().ADB_Workspace_Resource_Id)",
			"newClusterNodeType": "Standard_DS3_v2",
			"newClusterNumOfWorker": "1:3",
			"newClusterSparkEnvVars": {
				"PYSPARK_PYTHON": "/databricks/python3/bin/python3"
			},
			"newClusterVersion": "14.3.x-scala2.12",
			"clusterOption": "Autoscaling",
			"newClusterInitScripts": []
		}
	}
}