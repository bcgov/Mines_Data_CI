{
    "name": "ls_sql_server",
    "type": "Microsoft.DataFactory/factories/linkedservices",
    "properties": {
        "description": "Parameterised SQL Server linked service via Self-Hosted IR (ShareRT). Server and database passed at runtime; password from Key Vault.",
        "parameters": {
            "server": {
                "type": "String",
                "defaultValue": ""
            },
            "database": {
                "type": "String",
                "defaultValue": ""
            }
        },
        "annotations": [],
        "type": "SqlServer",
        "typeProperties": {
            "connectionString": "integrated security=False;data source=@{linkedService().server};initial catalog=@{linkedService().database};",
            "password": {
                "type": "AzureKeyVaultSecret",
                "store": {
                    "referenceName": "ls_keyvault",
                    "type": "LinkedServiceReference"
                },
                "secretName": "sql-server-password"
            }
        },
        "connectVia": {
            "referenceName": "ShareRT",
            "type": "IntegrationRuntimeReference"
        }
    }
}
