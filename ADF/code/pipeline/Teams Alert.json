{
    "name": "Teams Alert",
    "properties": {
        "description": "Sends alert notification to Teams Channel ###",
        "activities": [
            {
                "name": "Set Message schema",
                "description": "Set the schema you want for the message to teams",
                "type": "SetVariable",
                "dependsOn": [],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "messageCard",
                    "value": {
                        "value": "{\n    \"$schema\": \"http://adaptivecards.io/schemas/adaptive-card.json\",\n    \"type\": \"AdaptiveCard\",\n    \"version\": \"1.6\",\n    \"body\": [\n        {\n            \"type\": \"TextBlock\",\n            \"size\": \"Large\",\n            \"weight\": \"Bolder\",\n            \"text\": \"ADF Pipeline Failure\",\n            \"style\": \"heading\",\n            \"color\": \"Attention\",\n            \"fontType\": \"Default\",\n            \"separator\": true,\n            \"wrap\": true,\n            \"isSubtle\": true\n        },\n        {\n            \"type\": \"ColumnSet\",\n            \"columns\": [\n                {\n                    \"type\": \"Column\",\n                    \"items\": [\n                        {\n                            \"type\": \"Image\",\n                            \"style\": \"Person\",\n                            \"url\": \"data:image/png;base64,\",\n                            \"altText\": \"Matt Hidinger\",\n                            \"size\": \"Small\"\n                        }\n                    ],\n                    \"width\": \"auto\"\n                },\n                {\n                    \"type\": \"Column\",\n                    \"items\": [\n                        {\n                            \"type\": \"TextBlock\",\n                            \"weight\": \"Bolder\",\n                            \"text\": \"Notification Bot\",\n                            \"wrap\": true\n                        },\n                        {\n                            \"type\": \"TextBlock\",\n                            \"spacing\": \"None\",\n                            \"text\": \"@{utcnow()}\",\n                            \"isSubtle\": true,\n                            \"wrap\": true\n                        }\n                    ],\n                    \"width\": \"stretch\"\n                }\n            ]\n        },\n        {\n            \"type\": \"TextBlock\",\n            \"size\": \"Medium\",\n            \"weight\": \"Bolder\",\n            \"text\": \"Pipeline Execution Alert\",\n            \"wrap\": true\n        },\n        {\n            \"type\": \"FactSet\",\n            \"facts\": [\n                {\n                    \"title\": \"Data Factory Name:\",\n                    \"value\": \"@{pipeline().DataFactory}\"\n                },\n                {\n                    \"title\": \"Pipeline Name:\",\n                    \"value\": \"@{pipeline().parameters.Pipeline}\"\n                },\n                {\n                    \"title\": \"Pipeline Status:\",\n                    \"value\": \"@{pipeline().parameters.status}\"\n                },\n                {\n                    \"title\": \"Execution Start Time (UTC):\",\n                    \"value\": \"@{pipeline().TriggerTime}\"\n                },\n                {\n                    \"title\": \"Execution Finish Time (UTC):\",\n                    \"value\": \"@{utcnow()}\"\n                },\n                {\n                    \"title\": \"Message:\",\n                    \"value\": \"@{replace(replace(string(pipeline().parameters.message), '\\\"', ' '), '/', '')}\"\n                }\n            ]\n        }\n    ],\n    \"actions\": [\n        {\n            \"type\": \"Action.OpenUrl\",\n            \"title\": \"View Pipeline Run\",\n            \"url\": \"@{concat('https://adf.azure.com/monitoring/pipelineruns/',pipeline().parameters.runId,'?factory=/subscriptions/',pipeline().parameters.subscription,'/resourceGroups/',pipeline().parameters.resourceGroup,'/providers/Microsoft.DataFactory/factories/',pipeline().DataFactory)}\",\n            \"style\": \"positive\"\n        }\n    ]\n}\n",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "Invoke Teams Web Call",
                "type": "WebActivity",
                "dependsOn": [
                    {
                        "activity": "Set Message schema",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:05:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "POST",
                    "url": {
                        "value": "@pipeline().parameters.teamWebhookUrl",
                        "type": "Expression"
                    },
                    "body": {
                        "value": "@json(variables('messageCard'))",
                        "type": "Expression"
                    }
                }
            }
        ],
        "parameters": {
            "subscription": {
                "type": "string",
                "defaultValue": "@pipeline().globalParameters.TeamAlert_SubscriptionID"
            },
            "resourceGroup": {
                "type": "string",
                "defaultValue": "@pipeline().globalParameters.TeamAlert_ResourceGroup"
            },
            "status": {
                "type": "string",
                "defaultValue": "@activity('Specify name of the calling pipeline').Status"
            },
            "message": {
                "type": "string",
                "defaultValue": "@activity('Specify name of the calling pipeline').Error['message']"
            },
            "teamWebhookUrl": {
                "type": "string",
                "defaultValue": "@pipeline().globalParameters.TeamAlert_TeamWebhookURL"
            },
            "runId": {
                "type": "string",
                "defaultValue": "@pipeline().runId"
            },
            "Pipeline": {
                "type": "string",
                "defaultValue": "@pipeline().Pipeline"
            },
            "alert_color": {
                "type": "string",
                "defaultValue": "7C292A"
            }
        },
        "variables": {
            "messageCard": {
                "type": "String"
            }
        },
        "folder": {
            "name": "Common"
        },
        "annotations": [],
        "lastPublishTime": "2024-12-04T15:35:13Z"
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}