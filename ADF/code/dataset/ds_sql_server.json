{
    "name": "ds_sql_server",
    "type": "Microsoft.DataFactory/factories/datasets",
    "properties": {
        "description": "Generic parameterised SQL Server dataset. Pass server, database, schema and table_name at runtime.",
        "linkedServiceName": {
            "referenceName": "ls_sql_server",
            "type": "LinkedServiceReference",
            "parameters": {
                "server": {
                    "value": "@dataset().server",
                    "type": "Expression"
                },
                "database": {
                    "value": "@dataset().database",
                    "type": "Expression"
                }
            }
        },
        "parameters": {
            "schema": {
                "type": "String",
                "defaultValue": "dbo"
            },
            "table_name": {
                "type": "String",
                "defaultValue": ""
            },
            "server": {
                "type": "String",
                "defaultValue": ""
            },
            "database": {
                "type": "String",
                "defaultValue": ""
            }
        },
        "folder": {
            "name": "SQL_Server"
        },
        "annotations": [],
        "type": "SqlServerTable",
        "schema": [],
        "typeProperties": {
            "schema": {
                "value": "@dataset().schema",
                "type": "Expression"
            },
            "table": {
                "value": "@dataset().table_name",
                "type": "Expression"
            }
        }
    }
}
