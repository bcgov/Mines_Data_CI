table FactInspectionTarget
	lineageTag: a1eff69a-3985-4f57-80f4-724643dce874

	/// Calculates the total inspection target for the fiscal year. This measure sums the overall inspection target across all dates, ensuring it is not affected by date filters. Formula: _FY_Inspection_Target_Overall = CALCULATE(SUM(FactInspectionTarget[TargetOverall]), ALL(DimDate))
	measure _FY_Inspection_Target_Overall =
			CALCULATE(
			    SUM(FactInspectionTarget[TargetOverall]),
			    ALL(DimDate)  // This line may not be necessary depending on other context filters.
			)
		formatString: #,0
		lineageTag: 8daefdd9-02b9-491c-a3eb-fcdb5a9bf007

	/// Calculates the percentage of fiscal year-to-date inspections achieved relative to the overall fiscal year target. This measure helps track progress toward annual inspection goals. Formula: _FY_Inspection_Percentage_Achieved = DIVIDE(FactInspection[_FYTD_Inspections], FactInspectionTarget[_FY_Inspection_Target_Overall], 0)
	measure _FY_Inspection_Percentage_Achieved = ```
			DIVIDE(
			    FactInspection[_FYTD_Inspections],
			 FactInspectionTarget[_FY_Inspection_Target_Overall],    0
			) 
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ac2a060c-46fe-4ed5-8c9d-fa5aa2033609

	/// Calculates the variance between actual and targeted inspections for the fiscal year. This measure shows the difference between completed inspections and the overall fiscal year target. Formula: _FY_Inspection_Variance_Overall = FactInspection[_FY_Inspection_Count] - FactInspectionTarget[_FY_Inspection_Target_Overall]
	measure _FY_Inspection_Variance_Overall = ```
			FactInspection[_FY_Inspection_Count] - FActInspectionTarget[_FY_Inspection_Target_Overall]
			
			```
		formatString: #,0
		lineageTag: de703aa5-dc1b-448d-9330-e489efb23b10

	/// Calculates the percentage variance between actual and targeted inspections for the fiscal year. This measure shows the percentage difference between completed inspections and the overall fiscal year target. Formula: _FY_Inspection_Variance_Percentage = DIVIDE(FactInspection[_FY_Inspection_Count] - FactInspectionTarget[_FY_Inspection_Target_Overall], FactInspectionTarget[_FY_Inspection_Target_Overall], 0)
	measure _FY_Inspection_Variance_Percentage =
			DIVIDE(
			    FactInspection[_FY_Inspection_Count] - FactInspectionTarget[_FY_Inspection_Target_Overall],
			    FactInspectionTarget[_FY_Inspection_Target_Overall],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 076fafb2-d1d2-42ba-afb7-45ab3bd150e2

