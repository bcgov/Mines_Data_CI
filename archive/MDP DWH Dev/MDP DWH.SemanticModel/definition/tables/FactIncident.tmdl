table FactIncident
	lineageTag: a5cd74bb-bd1c-4716-b597-f4b80c8641d2

	measure _CountOfIncidentsByHour = COUNTROWS(FactIncident)
		formatString: 0
		lineageTag: 3459ad61-1a68-4dc6-ab1d-e0387772d299

	measure _AverageIncidentsPerHour =
			
			DIVIDE(
			    COUNTROWS(FactIncident),
			    DISTINCTCOUNT(FactIncident[_IncidentHour]),
			    0
			)
		lineageTag: d8b06539-ba83-4e85-8ebd-0cc571619a8a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total number of incidents recorded in the system
	/// # Total_Incidents = COUNT(FactIncident[IncidentPK])
	/// 
	measure '# Total_Incidents' = COUNT(FactIncident[IncidentPK])
		formatString: #,0
		lineageTag: 6a2cee3f-9aae-4b0e-b6a4-7cdadc2c78f1

	/// Total incidents recorded in the same period last year.
	/// # Incidents_LY = 
	/// CALCULATE(
	///     [# Total_Incidents], 
	///     SAMEPERIODLASTYEAR(DimIncidentDate[Date])
	/// )
	measure '# Incidents_LY' = ```
			
			CALCULATE(
			    [# Total_Incidents], 
			    SAMEPERIODLASTYEAR(DimIncidentDate[Date])
			)
			```
		formatString: #,0
		lineageTag: 0b635ce0-8add-4991-9789-a7c93280f71b

	/// Total incidents recorded in the previous month.
	/// 
	/// # Incidents_PM = 
	/// CALCULATE(
	///     [# Total_Incidents], 
	///     PREVIOUSMONTH(DimIncidentDate[Date])
	/// )
	measure '# Incidents_PM' = ```
			
			CALCULATE(
			    [# Total_Incidents], 
			    PREVIOUSMONTH(DimIncidentDate[Date])
			)
			```
		formatString: #,0
		lineageTag: dee1ae45-058d-42e1-9055-79c0c7488424

	/// Total number of fatalities recorded across all incidents
	/// # Total_Fatalities = SUM(FactIncident[NumberOfFatalities])
	measure '# Total_Fatalities' = SUM(FactIncident[NumberOfFatalities])
		formatString: #,0
		lineageTag: c03cf210-b45c-42ab-a3ff-8c990a28dade

	/// Total number of injuries recorded across all incidents
	/// # Total_Injuries = SUM(FactIncident[NumberOfInjuries])
	measure '# Total_Injuries' = SUM(FactIncident[NumberOfInjuries])
		formatString: #,0
		lineageTag: d8c37fed-df3c-44df-a6ef-dfa6fd3865f2

	/// Total incidents recorded in the same period last year.
	/// # Incidents_YTY = 
	/// CALCULATE(
	///     [# Total_Incidents], 
	///     SAMEPERIODLASTYEAR(DimIncidentDate[Date])
	/// )
	measure '# Incidents_YTY' = ```
			
			CALCULATE(
			    [# Total_Incidents], 
			    SAMEPERIODLASTYEAR(DimIncidentDate[Date])
			)
			```
		formatString: #,0
		lineageTag: f18cd429-b297-4607-9191-a35217071632

	/// Total incidents recorded in the previous month.
	/// # Incidents_MTM = 
	/// CALCULATE(
	///     [# Total_Incidents], 
	///     PREVIOUSMONTH(DimIncidentDate[Date])
	/// )
	measure '# Incidents_MTM' = ```
			
			CALCULATE(
			    [# Total_Incidents], 
			    PREVIOUSMONTH(DimIncidentDate[Date])
			)
			```
		formatString: #,0
		lineageTag: 2d6a409f-6889-4dbb-bda9-eb559a9ecdab

	/// Year-over-Year (YoY) growth percentage in total incidents.
	/// % Incidents_YTY_Growth = 
	/// DIVIDE(
	///     [# Total_Incidents] - [# Incidents_YTY], 
	///     [# Incidents_YTY], 
	///     0
	/// )
	measure '% Incidents_YTY_Growth' = ```
			
			DIVIDE(
			    [# Total_Incidents] - [# Incidents_YTY], 
			    [# Incidents_YTY], 
			    0
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8659ce7d-a754-40cc-a5c3-590f5efa2004

	/// Month-over-Month (MoM) growth percentage in total incidents.
	/// % Incidents_MTM_Growth = 
	/// DIVIDE(
	///     [# Total_Incidents] - [# Incidents_MTM], 
	///     [# Incidents_MTM], 
	///     0
	/// )
	measure '% Incidents_MTM_Growth' = ```
			
			DIVIDE(
			    [# Total_Incidents] - [# Incidents_MTM], 
			    [# Incidents_MTM], 
			    0
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e89ef2d3-646f-49fe-9959-24433c41b133

	/// Total incidents recorded in the last 3 months.
	/// # Rolling_3M_Incidents = 
	/// CALCULATE(
	///     [# Total_Incidents], 
	///     DATESINPERIOD(DimIncidentDate[Date], MAX(DimIncidentDate[Date]), -3, MONTH)
	/// )
	measure '# Rolling_3M_Incidents' = ```
			
			CALCULATE(
			    [# Total_Incidents], 
			    DATESINPERIOD(DimIncidentDate[Date], MAX(DimIncidentDate[Date]), -3, MONTH)
			)
			```
		formatString: #,0
		lineageTag: f8d3c42f-a403-4dd7-8004-919aba3ad3f2

	/// Total incidents recorded in the last 12 months.
	/// # Rolling_12M_Incidents = 
	/// CALCULATE(
	///     [# Total_Incidents], 
	///     DATESINPERIOD(DimIncidentDate[Date], MAX(DimIncidentDate[Date]), -12, MONTH)
	/// )
	measure '# Rolling_12M_Incidents' = ```
			
			CALCULATE(
			    [# Total_Incidents], 
			    DATESINPERIOD(DimIncidentDate[Date], MAX(DimIncidentDate[Date]), -12, MONTH)
			)
			```
		formatString: #,0
		lineageTag: d64a106f-bbec-4efe-a1c2-6bcf7a45f211

	/// Total number of incidents reported since the beginning of the year.
	/// # Cumulative_Incidents_YTD = 
	/// CALCULATE(
	///     [# Total_Incidents], 
	///     DATESYTD(DimIncidentDate[Date])
	/// )
	measure '# Cumulative_Incidents_YTD' = ```
			
			CALCULATE(
			    [# Total_Incidents], 
			    DATESYTD(DimIncidentDate[Date])
			)
			```
		formatString: #,0
		lineageTag: 3c47cd75-a58f-40bf-b2bb-2f84bfb06baf

	/// Total number of incidents reported since tracking began.
	/// # Cumulative_Incidents_AllTime = 
	/// CALCULATE(
	///     [# Total_Incidents], 
	///     FILTER(ALL(DimDate), DimDate[Date] <= MAX(DimIncidentDate[Date]))
	/// )
	/// 
	measure '# Cumulative_Incidents_AllTime' = ```
			
			CALCULATE(
			    [# Total_Incidents], 
			    FILTER(ALL(DimDate), DimDate[Date] <= MAX(DimIncidentDate[Date]))
			)
			```
		formatString: #,0
		lineageTag: ec1cb6c8-0961-4e6c-90cb-0187b1553ca4

	/// Counts all valid incidents from FactIncident that are marked as “Closed” (Incident_Status_Code = "CLD").
	/// CALCULATE( [Total Incidents], KEEPFILTERS( 'DimIncidentStatus'[Incident_Status_Code] = "CLD" ) )
	measure '# Total_Closed_Incidents' =
			
			CALCULATE( [# Total_Incidents], KEEPFILTERS( 'DimIncidentStatus'[Incident_Status_Code] = "CLD" ) )
		formatString: #,0
		lineageTag: b164458d-ff05-4be9-841d-506ba3e89e1d

	/// Calculates the total closed incidents from the beginning of the current year up to the current date.
	/// # Closed_Incidents_YTD =
	/// CALCULATE( [# Total_Closed_Incidents], DATESYTD('DimIncidentDate'[Date]) )
	measure '# Closed_Incidents_YTD' =
			
			CALCULATE( [# Total_Closed_Incidents], DATESYTD('DimIncidentDate'[Date]) )
		formatString: #,0
		lineageTag: 915baa30-2481-4601-af99-30d71681b630

	/// Calculates the total closed incidents from the start of the current month through the selected date.
	/// # Closed_Incidents_MTD =
	/// CALCULATE( [# Total_Closed_Incidents], DATESMTD('CALCULATE( [# Total_Closed_Incidents], DATESMTD('DimIncidentDate'[Date]) ) 
	/// '[Date]) ) 
	measure '# Closed_Incidents_MTD' = ```
			
			CALCULATE( [# Total_Closed_Incidents], DATESMTD('DimIncidentDate'[Date]) ) 
			```
		formatString: #,0
		lineageTag: 768eec28-429c-4a7f-b5e9-bf4277db8edd

	/// Calculates the total closed incidents for the same period in the previous year.
	/// # Closed_Incidents_LY =
	/// CALCULATE( [# Total_Closed_Incidents], SAMEPERIODLASTYEAR('CALCULATE( [# Total_Closed_Incidents], SAMEPERIODLASTYEAR('DimIncidentDate'[Date]) )
	/// '[Date]) )
	measure '# Closed_Incidents_LY' =
			
			CALCULATE( [# Total_Closed_Incidents], SAMEPERIODLASTYEAR('DimIncidentDate'[Date]) )
		formatString: #,0
		lineageTag: df723f37-4cc0-4049-8fce-3b797452c42f

	/// Computes the percentage change in closed incidents versus the same period last year.
	/// %_Change_Closed_Incidents_vs_LY = 
	/// DIVIDE( [# Total_Closed_Incidents] - [# Closed_Incidents_LY], [# Closed_Incidents_LY] )
	measure %_Change_Closed_Incidents_vs_LY =
			
			DIVIDE( [# Total_Closed_Incidents] - [# Closed_Incidents_LY], [# Closed_Incidents_LY] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4849f567-aade-485f-9a94-95034dfef8be

