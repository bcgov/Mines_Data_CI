table FactApplication
	lineageTag: ee0b1585-4b08-4585-ae04-b131f62a1258

	/// Counts the total number of applications in the FactApplication table.
	/// # Applications = COUNTROWS(FactApplication)
	measure '# Applications' = COUNTROWS(FactApplication)
		formatString: #,0
		lineageTag: a9d820fd-66d5-4f3c-a39f-4954c26a5bca

	/// Counts the total number of applications with the "Approved" status in the DimApplicationStatus table.
	/// # Approved_Applications = 
	/// CALCULATE(
	///    COUNTROWS(FactApplication),
	///    Counts the total number of applications with the "Approved" status in the DimApplicationStatus table.DimApplicationStatus[ApplicationStatusCode] = "Approved"
	/// )
	measure '# Approved_Applications' =
			
			CALCULATE(
			   COUNTROWS(FactApplication),
			   DimApplicationStatus[ApplicationStatusCode] = "AIA"
			)
		formatString: #,0
		lineageTag: a21a7ad7-0555-42b0-949a-564d83583b26

	/// Counts the total number of applications with the "Pending" status in the DimApplicationStatus table
	/// # Pending_Applications = 
	/// CALCULATE(
	///    COUNTROWS(FactApplication),
	///    DimApplicationStatus[ApplicationStatusCode] = "Pending"
	/// )
	measure '# Pending_Applications' =
			
			CALCULATE(
			   COUNTROWS(FactApplication),
			   DimApplicationStatus[ApplicationStatusCode] = "PEV"
			)
		formatString: #,0
		lineageTag: 65fbfbc3-cba5-44c3-a7e3-fbe53d55e434

	/// # Rejected_Applications = 
	/// CALCULATE(
	///    COUNTROWS(FactApplication),
	///    Counts the total number of applications with the "Rejected" status in the DimApplicationStatus table
	/// DimApplicationStatus[ApplicationStatusCode] = "Rejected"
	/// )
	measure '# Rejected_Applications' =
			
			CALCULATE(
			   COUNTROWS(FactApplication),
			   DimApplicationStatus[ApplicationStatusCode] = "REC"
			)
		formatString: #,0
		lineageTag: 09ac266e-d9f5-4df6-8b83-44e198c1e580

	/// Calculates the percentage of applications in progress out of the total number of applications.
	/// # InProgress_Applications = 
	/// CALCULATE(
	///    COUNTROWS(FactApplication),
	/// Counts the total number of applications with the "InProgress" status in the DimApplicationStatus table
	///    DimApplicationStatus[ApplicationStatusCode] = "InProgress"
	/// )
	measure '# Delayed_Applications' =
			
			CALCULATE(
			   COUNTROWS(FactApplication),
			   DimApplicationStatus[ApplicationStatusCode] = "CDI"
			)
		formatString: #,0
		lineageTag: 8bf7b340-26f3-4938-87c7-323c3f83a789

	/// Calculates the percentage of approved applications out of the total number of applications.
	/// % Approved Applications = 
	/// DIVIDE(
	///    [# Approved_Applications],
	///    [# Applications],
	///    0
	/// )
	measure '% Approved Applications' =
			
			DIVIDE(
			   [# Approved_Applications],
			   [# Applications],
			   0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6e4d5490-014e-4ead-979c-671d682c51e3

	/// Calculates the percentage of pending applications out of the total number of applications.
	/// % Pending Applications = 
	/// DIVIDE(
	///    [# Pending_Applications],
	///    [# Applications],
	///    0
	/// )
	measure '% Pending Applications' =
			
			DIVIDE(
			   [# Pending_Applications],
			   [# Applications],
			   0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1682c439-429c-4948-8052-35a5eec6ef3d

	/// Calculates the percentage of rejected applications out of the total number of applications
	/// % Rejected Applications = 
	/// DIVIDE(
	///    [# Rejected_Applications],
	///    [# Applications],
	///    0
	/// )
	/// 
	measure '% Rejected Applications' =
			
			DIVIDE(
			   [# Rejected_Applications],
			   [# Applications],
			   0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ddf966cb-7f9e-4c0d-aa6c-f6ce1a548f55

	/// Calculates the percentage of approved applications within the last 30 days.
	/// % Applications Approved in Last 30 Days = 
	/// CALCULATE(
	///    DIVIDE(
	///       [# Approved_Applications],
	///       [# Applications],
	///       0
	///    ),
	///    DimDate[Date] > TODAY() - 30
	/// )
	measure '% Applications Approved in Last 30 Days' =
			
			CALCULATE(
			   DIVIDE(
			      [# Approved_Applications],
			      [# Applications],
			      0
			   ),
			   DimDate[Date] > TODAY() - 30
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e1e31c89-a9f6-4402-b6df-6dbe752c6afd

	/// Counts the total number of approved applications year-to-date.
	/// # Applications Approved YTD = 
	/// CALCULATE(
	///    COUNTROWS(FactApplication),
	///    DimApplicationStatus[ApplicationStatusCode] = "Approved",
	///    YEAR(DimDate[Date]) = YEAR(TODAY())
	/// )
	measure '# Applications Approved YTD' = ```
			
			CALCULATE(
			    COUNTROWS(FactApplication),
			    DimApplicationStatus[ApplicationStatusCode] = "AIA",
			    FILTER(
			        VALUES(DimDate[Date]),
			        DimDate[Date] <= TODAY()
			    )
			)
			
			```
		formatString: #,0
		lineageTag: 29019b29-e982-4860-9a85-7540e2554e05

	/// Calculates the percentage of approved applications year-to-date out of the total applications.
	/// % Applications Approved YTD = 
	/// DIVIDE(
	///    [# Applications Approved YTD],
	///    [# Applications],
	///    0
	/// )
	measure '% Applications Approved YTD' =
			
			DIVIDE(
			   [# Applications Approved YTD],
			   [# Applications],
			   0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ba6198db-8b8c-48b5-abeb-e620f35b6994

	/// Calculates the running total of applications submitted up to the current date.
	/// 
	/// # Cumulative Applications = 
	/// CALCULATE(
	///    COUNTROWS(FactApplication),
	///    FILTER(
	///       ALL(DimDate),
	///       DimDate[Date] <= MAX(DimDate[Date])
	///    )
	measure '# Cumulative Applications' =
			
			CALCULATE(
			   COUNTROWS(FactApplication),
			   FILTER(
			      ALL(DimDate),
			      DimDate[Date] <= MAX(DimDate[Date])
			   )
			)
		formatString: #,0
		lineageTag: 1d940806-57ad-45bf-8843-a66e6eb7bd81

	/// Calculates the percentage of applications in progress out of the total number of applications.
	/// % InProgress Applications = 
	/// DIVIDE(
	///    [# InProgress_Applications],
	///    [# Applications],
	///    0
	/// )
	measure '% Delayed Applications' = ```
			
			DIVIDE(
			   [# Delayed_Applications],
			   [# Applications],
			   0
			) 
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1fa1e1c2-f941-455d-a78a-b21e4ffd09ad

	measure '# Withdrawn_Applications' =
			
			CALCULATE(
			   COUNTROWS(FactApplication),
			   DimApplicationStatus[ApplicationStatusCode] = "WDN"
			)
		formatString: 0
		lineageTag: 8670d24f-9306-4070-ba49-44b4aaf99f95

	measure '# Referred_Applications' =
			
			CALCULATE(
			   COUNTROWS(FactApplication),
			   DimApplicationStatus[ApplicationStatusCode] = "REF"
			)
		formatString: 0
		lineageTag: 572cfe5d-2d90-4751-84e7-ec3b440b9ad5

	measure '# Gov.ActionRequired_Applications' =
			
			CALCULATE(
			   COUNTROWS(FactApplication),
			   DimApplicationStatus[ApplicationStatusCode] = "GVD"
			)
		formatString: 0
		lineageTag: 61d624c3-a0b9-41a2-8f0b-1fce8dada111

	measure '# Referral Complete_Applications' =
			
			CALCULATE(
			   COUNTROWS(FactApplication),
			   DimApplicationStatus[ApplicationStatusCode] = "RCO"
			)
		formatString: 0
		lineageTag: dc3ed71f-bdbd-42d2-aefb-1151490a48a0

	measure '# NoPermit Required_Applications' =
			
			CALCULATE(
			   COUNTROWS(FactApplication),
			   DimApplicationStatus[ApplicationStatusCode] = "NPR"
			)
		formatString: 0
		lineageTag: d5b9fee1-306c-44e8-8a58-315e8ee35190

	/// Fiscal Year-to-Date (FYTD)
	/// CALCULATE(
	///     [# Applications],
	///     FILTER(
	///         ALL(DimDate),
	///         DimDate[FiscalYear] = MAX(DimDate[FiscalYear]) &&
	///         DimDate[Date] <= MAX(DimDate[Date])
	///     )
	/// )
	measure '# Applications FYTD' =
			
			CALCULATE(
			    [# Applications],
			    FILTER(
			        ALL(DimDate),
			        DimDate[FiscalYear] = MAX(DimDate[FiscalYear]) &&
			        DimDate[Date] <= MAX(DimDate[Date])
			    )
			)
		formatString: #,0
		lineageTag: a2a3de86-4111-4068-91ae-ac7b3194b5cf

	/// Fiscal Last Year-to-Date (FLYTD)
	/// CALCULATE(
	///     [# Applications],
	///     FILTER(
	///         ALL(DimDate),
	///         DimDate[FiscalYear] = MAX(DimDate[FiscalYear]) - 1 &&
	///         DimDate[Date] <= EDATE(MAX(DimDate[Date]), -12)
	///     )
	/// )
	measure '# Applications FLYTD' = ```
			
			CALCULATE(
			    [# Applications],
			    FILTER(
			        ALL(DimDate),
			        DimDate[FiscalYear] = MAX(DimDate[FiscalYear]) - 1 &&
			        DimDate[Date] <= EDATE(MAX(DimDate[Date]), -12)
			    )
			)
			
			```
		formatString: 0
		lineageTag: 7f62299d-cb75-433e-b02c-1f1e6d166762

	/// Fiscal MTD
	/// CALCULATE(
	///     [# Applications],
	///     FILTER(
	///         ALL(DimDate),
	///         DimDate[FiscalYear] = MAX(DimDate[FiscalYear]) &&
	///         DimDate[FiscalMonth] = MAX(DimDate[FiscalMonth])
	///     )
	/// )
	measure '# Applications FMTD' = ```
			
			CALCULATE(
			    [# Applications],
			    FILTER(
			        ALL(DimDate),
			        DimDate[FiscalYear] = MAX(DimDate[FiscalYear]) &&
			        DimDate[FiscalMonth] = MAX(DimDate[FiscalMonth])
			    )
			)
			
			```
		formatString: 0
		lineageTag: f17e2e24-e6ae-4c8c-9808-5782587941d8

	///  Fiscal YTD % Change
	/// DIVIDE([# Applications FYTD] - [# Applications FLYTD], [# Applications FLYTD])
	measure '% Applications FYTD Change' = ```
			
			DIVIDE([# Applications FYTD] - [# Applications FLYTD], [# Applications FLYTD])
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f864f79c-fdc6-4500-b4b1-3144344d699e

