table FactOrderStopDetail
	lineageTag: 27050a08-2900-4636-902b-66bd2992e840

	/// # Closed Orders: Counts the total number of orders with a "Closed" status in the DimOrderStopStatus table.
	/// # Closed_Orders = CALCULATE(     COUNTROWS(FactOrderStopDetail), DimOrderStopStatus[StopStatus] = "Closed" )
	measure '# Closed_Orders' = CALCULATE(     COUNTROWS(FactOrderStopDetail), DimOrderStopStatus[StopStatus] = "Closed" )
		formatString: #,0
		lineageTag: 8c9e7214-f867-4d20-bd38-a4b86449b63e

	/// # Open Orders: Counts the total number of orders with an "Open" status in the DimOrderStopStatus table.
	/// # Open_Orders = 
	/// CALCULATE(
	///     COUNTROWS(FactOrderStopDetail),
	///     DimOrderStopStatus[StopStatus] = "Open"
	/// )
	measure '# Open_Orders' =
			
			CALCULATE(
			    COUNTROWS(FactOrderStopDetail),
			    DimOrderStopStatus[StopStatus] = "Open"
			)
		formatString: #,0
		lineageTag: 11871b20-0dc7-4e20-9911-7a62c98ab781

	/// # Escalated Orders: Counts the total number of orders with an "Escalated" status in the DimOrderStopStatus table.
	/// # Escalated_Orders = 
	/// CALCULATE(
	///     COUNTROWS(FactOrderStopDetail),
	///     DimOrderStopStatus[StopStatus] = "Escalated")
	measure '# Escalated_Orders' =
			
			CALCULATE(
			    COUNTROWS(FactOrderStopDetail),
			    DimOrderStopStatus[StopStatus] = "Escalated")
		formatString: #,0
		lineageTag: fda9b3e2-54cc-43db-a1a7-618d06579da7

	/// # Overdue Orders: Counts the total number of orders that are "Open" and have a CompletionDateTime earlier than the current date and time, indicating they are overdue.
	/// # Overdue_Orders = 
	/// CALCULATE(
	///     COUNTROWS(FactOrderStopDetail),
	///     DimOrderStopStatus[StopStatus] = "Open",
	///     FactOrderStopDetail[CompletionDateTime] < NOW()
	/// )
	measure '# Overdue_Orders' =
			
			CALCULATE(
			    COUNTROWS(FactOrderStopDetail),
			    DimOrderStopStatus[StopStatus] = "Open",
			    FactOrderStopDetail[CompletionDateTime] < NOW()
			)
		formatString: #,0
		lineageTag: dd1f6aab-3f89-48ab-bef5-45006091cbf2

	/// # Orders: Counts the total number of all orders in the FactOrderStopDetail table, regardless of status.
	/// # Orders = 
	/// COUNTROWS(FactOrderStopDetail)
	measure '# Orders' =
			
			DISTINCTCOUNT(FactOrderStopDetail[order_stop_detail_id])
		formatString: #,0
		lineageTag: 34dfe30e-a8f6-4095-a051-bc2aa3f76dec

	/// # Unknown Orders: Counts the total number of orders with an "Unknown" status in the DimOrderStopStatus table.
	/// # Unknown_Orders = 
	/// CALCULATE(
	///     COUNTROWS(FactOrderStopDetail),
	///     DimOrderStopStatus[StopStatus] = "Unknown"
	/// )
	measure '# Unknown_Orders' = ```
			
			CALCULATE(
			    COUNTROWS(FactOrderStopDetail),
			    DimOrderStopStatus[StopStatus] = "Unknown"
			)
			
			```
		formatString: #,0
		lineageTag: 64fa391a-b05a-41cf-a6cf-b74a1b7f9dc9

	/// % Closed Orders: Calculates the percentage of closed orders relative to the total number of orders, returned as a decimal.
	/// % Closed Orders = 
	/// DIVIDE(FactOrderStopDetail[# Closed_Orders], [# Orders], 0)
	measure '% Closed Orders' =
			
			DIVIDE(FactOrderStopDetail[# Closed_Orders], [# Orders], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4fc64c90-71ff-4db7-8a21-9ae492e908b7

	/// % Escalated Orders: Calculates the percentage of escalated orders relative to the total number of orders, returned as a decimal.
	/// % Escalated Orders = 
	/// DIVIDE(FactOrderStopDetail[# Escalated_Orders], [# Orders], 0)
	measure '% Escalated Orders' =
			
			DIVIDE(FactOrderStopDetail[# Escalated_Orders], [# Orders], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 813377b7-8072-433e-b7ff-5c72bde99b13

	/// % Open Orders: Calculates the percentage of open orders relative to the total number of orders, returned as a decimal.
	/// % Open Orders = 
	/// DIVIDE(FactOrderStopDetail[# Open_Orders], [# Orders], 0)
	measure '% Open Orders' =
			
			DIVIDE(FactOrderStopDetail[# Open_Orders], [# Orders], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9399865b-01f9-4b15-bf91-3e37b28e4b56

	/// % Overdue Orders: Calculates the percentage of overdue orders relative to the total number of orders, returned as a decimal.
	/// % Overdue Orders = 
	/// DIVIDE(FactOrderStopDetail[# Overdue_Orders], [# Orders], 0)
	measure '% Overdue Orders' =
			
			DIVIDE(FactOrderStopDetail[# Overdue_Orders], [# Orders], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f015bc71-29b1-404f-bf09-82306e70df09

	/// % Unknown Orders: Calculates the percentage of unknown orders relative to the total number of orders, returned as a decimal.
	/// % Unknown Orders = 
	/// DIVIDE(FactOrderStopDetail[# Unknown_Orders], [# Orders], 0)
	measure '% Unknown Orders' =
			
			DIVIDE(FactOrderStopDetail[# Unknown_Orders], [# Orders], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bcb22cef-1f45-4051-b1c1-7bd8bd42ef2f

	///  Fiscal Year-to-Date (FYTD)
	/// CALCULATE(
	///     [# Orders],
	///     FILTER(
	///         ALL(DimDate),
	///         DimDate[FiscalYear] = MAX(DimDate[FiscalYear]) &&
	///         DimDate[Date] <= MAX(DimDate[Date])
	///     )
	/// )
	measure '# Orders FYTD' =
			CALCULATE(
			    [# Orders],
			    FILTER(
			        ALL(DimDate),
			        DimDate[FiscalYear] = MAX(DimDate[FiscalYear]) &&
			        DimDate[Date] <= MAX(DimDate[Date])
			    )
			)
		formatString: #,0
		lineageTag: 314357b2-d6e6-41cf-bf73-42cf4b93f483

	///  Fiscal MTD 
	///  Fiscal MTD 
	/// 
	measure '# Orders FMTD' =
			
			CALCULATE(
			    [# Orders],
			    FILTER(
			        ALL(DimDate),
			        DimDate[FiscalYear] = MAX(DimDate[FiscalYear]) &&
			        DimDate[FiscalMonth] = MAX(DimDate[FiscalMonth])
			    )
			)
		formatString: #,0
		lineageTag: 4961836b-821d-4ccb-bb54-b691c021052f

	/// Fiscal YTD % Change
	/// DIVIDE([# Orders FYTD] - [# Orders FLYTD], [# Orders FLYTD])
	measure '% Orders FYTD Change' =
			
			DIVIDE([# Orders FYTD] - [# Orders FLYTD], [# Orders FLYTD])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b497354a-5e2d-4575-9561-47df764b6e79

	/// Fiscal Last Year-to-Date (FLYTD)
	/// # Orders FLYTD = 
	/// CALCULATE(
	///     [# Orders],
	///     FILTER(
	///         ALL(DimDate),
	///         DimDate[FiscalYear] = MAX(DimDate[FiscalYear]) - 1 &&
	///         DimDate[Date] <= EDATE(MAX(DimDate[Date]), -12)
	///     )
	/// )
	measure '# Orders FLYTD' =
			
			CALCULATE(
			    [# Orders],
			    FILTER(
			        ALL(DimDate),
			        DimDate[FiscalYear] = MAX(DimDate[FiscalYear]) - 1 &&
			        DimDate[Date] <= EDATE(MAX(DimDate[Date]), -12)
			    )
			)
		formatString: #,0
		lineageTag: 29a4fa8c-c031-4628-9510-29255a35ea26

	measure 'Filter by Selected Inspection' = ```
			
			VAR sel = SELECTEDVALUE( DimInspection[inspection_id] )
			RETURN
			IF (
			    ISBLANK(sel),
			    1,
			    CALCULATE (
			        1,
			        USERELATIONSHIP(
			            DimInspection[inspection_id],
			            FactOrderStopDetail[inspection_id]
			        ),
			        KEEPFILTERS( DimInspection[inspection_id] = sel )
			    )
			)
			
			```
		formatString: 0
		lineageTag: ab580113-1be9-43b3-932d-5f21988c9a4b

	measure 'Keep Selected Inspection' = ```
			
			VAR SelectedId = SELECTEDVALUE( DimInspection[inspection_id] )
			VAR RowId      = SELECTEDVALUE( FactOrderStopDetail[inspection_id] )
			RETURN
			IF (
			    ISBLANK(SelectedId),
			    1,                 -- page opened directly (no drill) → show all
			    IF ( RowId = SelectedId, 1, 0 )
			)
			
			```
		formatString: 0
		lineageTag: 044f568b-435d-4408-b103-d61f4fda74ca

	measure '# Orders (by Inspection only)' = ```
			
			VAR _selInsp =
			    VALUES ( DimInspection[inspection_id] )   -- what the drill-through provides
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( FactOrderStopDetail[order_stop_detail_id] ),
			    TREATAS ( _selInsp, FactOrderStopDetail[inspection_id] )  -- force filter to the fact
			)
			
			
			```
		formatString: 0
		lineageTag: e7548f01-36dd-4bc2-8ada-9372b15a5c01

