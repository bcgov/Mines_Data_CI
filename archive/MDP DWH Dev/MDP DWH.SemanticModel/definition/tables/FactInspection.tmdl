table FactInspection
	lineageTag: 08851f76-163c-4ee7-9b4a-de1dd28adc5a

	/// Calculates the total number of inspections conducted since the beginning of the calendar year up to today. This measure offers a cumulative snapshot of inspection activity for the current year. Formula: _YTD_Inspections = TOTALYTD(COUNTROWS(FactInspection), DimDate[Date])
	measure _YTD_Inspections = ```
			TOTALYTD(
			    COUNTROWS(FactInspection),
			    DimDate[Date]
			)
			
			```
		formatString: #,0
		lineageTag: 65ca6e57-ad08-4535-b94b-6a0e4d978dd9

	/// Calculates the total inspections conducted Month-To-Date. This measure provides a snapshot of inspection activity from the start of the current month up to today's date. Formula: _MTD_Inspections = TOTALMTD(COUNTROWS(FactInspection), DimDate[Date])
	measure _MTD_Inspections = ```
			TOTALMTD(
			    COUNTROWS(FactInspection),
			    DimDate[Date]
			)
			
			```
		formatString: #,0
		lineageTag: 0007b0c0-f385-4a90-90af-4724f6b8dc5c

	/// Calculates Year-To-Date inspections for the previous calendar year. This measure provides a cumulative count of inspections from January 1st to the same date last year. Formula: _YTD_Inspections_Last_Year = CALCULATE(TOTALYTD(COUNTROWS(FactInspection), DimDate[Date]), SAMEPERIODLASTYEAR(DimDate[Date]))
	measure _YTD_Inspections_Last_Year =
			CALCULATE(
			    TOTALYTD(
			        COUNTROWS(FactInspection),
			        DimDate[Date]
			    ),
			    SAMEPERIODLASTYEAR(DimDate[Date])
			)
		formatString: #,0
		lineageTag: ee003b79-852a-4279-b42c-a861a7eadba3

	/// Calculates the total inspections conducted Month-To-Date for the previous month. This measure reflects inspection activity from the start of the last month up to the end of that month, adjusted daily. Formula: _MTD_Inspections_Last_Month = CALCULATE(TOTALMTD(COUNTROWS(FactInspection), DimDate[Date]), DATEADD(DimDate[Date], -1, MONTH))
	measure _MTD_Inspections_Last_Month =
			CALCULATE(
			    TOTALMTD(
			        COUNTROWS(FactInspection),
			        DimDate[Date]
			    ),
			    DATEADD(DimDate[Date], -1, MONTH)
			)
		formatString: #,0
		lineageTag: 852163b8-1910-4c4e-bd53-9e19057418ba

	measure _YTD_Percentage_Change =
			DIVIDE(
			    [_YTD_Inspections] - [_YTD_Inspections_Last_Year],
			    [_YTD_Inspections_Last_Year],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: eb3e2066-ed7f-4f0a-95ac-193dfe7b9749

	/// Calculates the percentage change in inspections from the current month to the previous month. This measure offers insights into monthly trends and variations in inspection activity. Formula: _MTD_Percentage_Change = DIVIDE([_MTD_Inspections] - [_MTD_Inspections_Last_Month], [_MTD_Inspections_Last_Month], 0)
	measure _MTD_Percentage_Change =
			DIVIDE(
			    [_MTD_Inspections] - [_MTD_Inspections_Last_Month],
			    [_MTD_Inspections_Last_Month],
			    0
			)
		formatString: #,0.00
		lineageTag: c8452132-fad7-47da-b291-902b984437e9

	/// Calculates the current year's inspections YTD starting from April 1. This measure totals all inspections recorded from the beginning of the fiscal year up to today's date, providing a snapshot of inspection activity. Formula: _FYTD_Inspections = TOTALYTD(COUNTROWS(FactInspection), DimDate[Date], '4/1')
	/// 
	measure _FYTD_Inspections =
			TOTALYTD(
			    COUNTROWS(FactInspection),
			    DimDate[Date],
			    "4/1"  // Adjust this date to match the start of your fiscal year
			)
		formatString: #,0
		lineageTag: 40054947-58a4-4fb0-aa57-ade373d6c251

	/// Calculates last year's inspections YTD from April 1. This measure counts inspections from the start of the previous fiscal year up to the same date last year, starting each fiscal year on April 1st. Formula: _FYTD_Inspections_Last_Year = CALCULATE(TOTALYTD(COUNTROWS(FactInspection), DimDate[Date], "4/1"), DATEADD(DimDate[Date], -1, YEAR))
	/// 
	measure _FYTD_Inspections_Last_Year = ```
			CALCULATE(
			    TOTALYTD(
			        COUNTROWS(FactInspection),
			        DimDate[Date],
			        "4/1"  // Start of the fiscal year
			    ),
			    DATEADD(DimDate[Date], -1, YEAR)  // Shift to the last fiscal year
			)
			
			```
		formatString: #,0
		lineageTag: a0566e2a-73eb-4e40-b36f-ab6a59d998c3

	/// Calculates the percentage change in fiscal year-to-date inspections compared to the previous year. This measure helps assess trends in inspection activity over time. Formula: _FYTD_Percentage_Change = DIVIDE([_FYTD_Inspections] - [_FYTD_Inspections_Last_Year], [_FYTD_Inspections_Last_Year], 0)
	/// 
	/// 
	measure _FYTD_Percentage_Change = ```
			DIVIDE(
			    [_FYTD_Inspections] - [_FYTD_Inspections_Last_Year],
			    [_FYTD_Inspections_Last_Year],
			    0
			)
			
			```
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 99e1915f-c30f-493c-ad3e-bcd253c03ab7

	/// Counts fiscal annual inspections. Formula: _FY_Inspection_Count = CALCULATE(COUNTROWS(FactInspection))
	measure _FY_Inspection_Count =
			CALCULATE(
			    COUNTROWS(FactInspection))
		formatString: #,0
		lineageTag: 57d6ed8b-26d9-43f1-b3bf-c4cc559fab69

	measure '# Inspections' =
			
			COUNTROWS(FactInspection)
		formatString: #,0
		lineageTag: e43108cb-1891-4b0f-bbfd-8ba243015de3

	/// Counts the number of inspections in the same date range from the previous year.
	/// Uses the currently selected period in DimDate[Date] (from slicers or filters), shifts it back one year using DATEADD, and counts distinct rows in FactInspection.
	/// Formula:
	/// _PP_Inspections_Prev_Year = 
	/// CALCULATE (
	///     COUNTROWS ( FactInspection ),
	///     DATEADD ( DimDate[Date], -1, YEAR )
	/// )
	/// 
	measure _PP_Inspections_Prev_Year =
			
			CALCULATE (
			    COUNTROWS ( FactInspection ),
			    DATEADD ( DimDate[Date], -1, YEAR )
			)
		formatString: #,0
		lineageTag: 57853fcb-0839-4b7c-8340-77f02118d3ae

	/// Calculates the absolute difference in the number of inspections compared to the same period in the previous year.
	/// Positive values indicate an increase in inspections, negative values indicate a decrease. 
	/// Formula:
	/// Calculates the percentage change in the number of inspections compared to the same period in the previous year.
	/// Uses # Inspections for the current selected period and _PP_Inspections_Prev_Year for the equivalent period last year. Returns 0 if the previous year value is blank or zero. Format as a percentage.
	/// Formula:
	/// _PP_Inspections_Percentage_Change_Prev_Year = 
	/// DIVIDE (
	///     [# Inspections] - [_PP_Inspections_Prev_Year],
	///     [_PP_Inspections_Prev_Year],
	///     0
	/// )
	measure _PP_Inspections_Percentage_Change_Prev_Year = ```
			
			DIVIDE (
			    [# Inspections] - [_PP_Inspections_Prev_Year],
			    [_PP_Inspections_Prev_Year],
			    0
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4b16c371-731c-42de-aea8-d3a94912359c

	/// Calculates the absolute difference in the number of inspections compared to the same period in the previous year.
	/// Positive values indicate an increase in inspections, negative values indicate a decrease. Formula:
	/// _PP_Inspections_Change_Prev_Year =
	/// [# Inspections] - [_PP_Inspections_Prev_Year]
	/// 
	measure _PP_Inspections_Change_Prev_Year =
			
			[# Inspections] - [_PP_Inspections_Prev_Year]
		formatString: #,0
		lineageTag: d19477f8-06df-44f1-a6bd-f45148fdff31

