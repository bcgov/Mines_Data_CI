table ViewsRanking

	column OwnerTenantGuid
		dataType: string
		isHidden
		sourceProviderType: varchar
		sourceColumn: OwnerTenantGuid

	column OwnerUserGuid
		dataType: string
		isHidden
		sourceProviderType: varchar
		sourceColumn: OwnerUserGuid

	column OwnerGroupGuid
		dataType: string
		isHidden
		sourceProviderType: varchar
		sourceColumn: OwnerGroupGuid

	column ReportGuid
		dataType: string
		sourceProviderType: varchar
		sourceColumn: ReportGuid

	column ViewsRank
		dataType: int64
		formatString: 0
		sourceProviderType: bigint
		sourceColumn: Rank

	partition Usage_ReportViewsRanking_V1 = query
		dataView: full
		source
			query =
				SELECT [Viewers].[Usage_ReportViewsRanking_V1].*
				FROM [Viewers].[Usage_ReportViewsRanking_V1]
				WHERE [Viewers].[Usage_ReportViewsRanking_V1].[OwnerTenantGuid] = '6fdb5200-3d0d-4a8a-b036-d3685e359adc' AND ([Viewers].[Usage_ReportViewsRanking_V1].[OwnerGroupGuid] = 'dc216c1a-9a6a-4df9-b5ab-2bd690c68432' OR [Viewers].[Usage_ReportViewsRanking_V1].[OwnerUserGuid] = '')
			dataSource: bd7c0be5-4f36-44e9-bc91-20679d41615b

