		    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "startdate", each if [Custom] = false then null 
		                else List.Min([combinedDates])),
		    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "enddate", each if [Custom] = false then null 
		                else List.Max([combinedDates])),
		
		    //Step 3 For those overlapping records, use min start and max end
