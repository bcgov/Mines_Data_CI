expression 'NoW Application Delay - NEW (2)' = ```
		let
		    Source = Value.NativeQuery(PostgreSQL.Database("mds-reporting-pg13-live.postgres.database.azure.com", "mds"), "select naid.now_application_guid, nad.now_application_delay_id as Delay_id#(lf)#(tab)  ,nad.delay_type_code, nadt.description#(lf)#(tab)  ,start_date as startdate, end_date as enddate#(lf)#(tab)  ,lead(start_date,1) over (PARTITION BY naid.now_application_guid order by naid.now_application_guid, start_date) next_startdate#(lf)#(tab)  ,lead(end_date,1) over (PARTITION BY naid.now_application_guid order by naid.now_application_guid, start_date) next_enddate#(lf)#(tab)  ,start_comment#(lf)from now_application_delay nad#(lf)left join now_application_identity naid on naid.now_application_guid = nad.now_application_guid#(lf)left join now_application na on na.now_application_id = naid.now_application_id#(lf)left join now_application_delay_type nadt on nadt.delay_type_code = nad.delay_type_code#(lf)order by now_application_guid, startdate", null, [EnableFolding=false]),
		    #"Changed Type" = Table.TransformColumnTypes(Source,{{"startdate", type date}, {"enddate", type date}, {"next_startdate", type date}, {"next_enddate", type date}}),
		    //preprocessing， if a delay only one day and that date already existed in another record then remove that delay
		    #"Added Custom4" = Table.AddColumn(#"Changed Type", "Single Existed Date Flag", each if [enddate] = null then false 
		else[enddate] = [next_startdate] and Duration.Days([enddate]-[startdate]) = 0),
		    #"Filtered Rows1" = Table.SelectRows(#"Added Custom4", each ([Single Existed Date Flag] = false)),
		    #"Removed Columns1" = Table.RemoveColumns(#"Filtered Rows1",{"Single Existed Date Flag", "next_startdate", "next_enddate"}),
