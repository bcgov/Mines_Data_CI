		           Duration.Days([enddate]-[startdate])+1,
		           #duration(1,0,0,0)
		           )),
		    #"Grouped Rows" = Table.Group(#"Added Custom", {"now_application_guid"}, {{"All", each _, type table [now_application_guid=nullable text, delay_id=nullable number, delay_type_code=nullable text, description=nullable text, startdate=nullable date, enddate=nullable date, start_comment=nullable text, dateList=list]}, {"delay_id", each List.Max([delay_id]), type nullable number}, {"delay_type_code", each List.Max([delay_type_code]), type nullable text},
		    {"combinedDates", each List.Distinct(List.Combine([dateList])), type list}, 
