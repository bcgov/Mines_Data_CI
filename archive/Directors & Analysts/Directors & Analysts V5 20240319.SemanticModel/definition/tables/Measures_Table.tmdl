table Measures_Table
	lineageTag: b8d2c38b-3e07-4cce-96db-ac5d293059a9

	measure ApplicationCount_NE =
			CALCULATE(
			    DISTINCTCOUNT('NoW All'[now_application_guid]),Mines[Mine Region]="NE")
		formatString: 0
		lineageTag: c8e874a6-a557-47b8-9b88-28537e0eae9b

	measure ApplicationCount_NW =
			CALCULATE(
			    DISTINCTCOUNT('NoW All'[now_application_guid]),Mines[Mine Region]="NW")
		formatString: 0
		lineageTag: 20df3694-fe81-4dc1-92cd-ea6bc1047a42

	measure ApplicationCount_SE =
			CALCULATE(
			    DISTINCTCOUNT('NoW All'[now_application_guid]),Mines[Mine Region]="SE")
		formatString: 0
		isHidden
		lineageTag: bd50888b-3f40-4459-a18a-06f889fec6b9

		changedProperty = IsHidden

	measure ApplicationCount_SC =
			CALCULATE(
			    DISTINCTCOUNT('NoW All'[now_application_guid]),Mines[Mine Region]="SC")
