		formatString: 0
		lineageTag: b43a5485-05e3-449a-ac0c-3b03490dcc5e

	measure 'Count Last Year' = CALCULATE(count('NoW All'[now_application_guid]),SAMEPERIODLASTYEAR(SubmitDates[Date].[Date]))
		formatString: 0
		lineageTag: 0d10fcc2-ce36-4bca-b5cf-8bb264aa6a3c

	measure 'Total Count' = DISTINCTCOUNT('NoW All'[now_application_guid])
		formatString: 0
		lineageTag: b5526b12-d824-4c93-8f94-7452131894b2

	measure 'YoY % change' = DIVIDE([Total Count],[Count Last Year],0)-1
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0a4dccca-b652-4c8f-b323-8fba5724ecc3

	measure 'Report Title' = COMBINEVALUES(" ", "Inspector Report - ", [Selected Name])
		lineageTag: 94b4e06f-bc26-4173-a997-9c95e0297933

	measure 'Average Consultation Days' = "30-45"
		lineageTag: d5022e9b-ec8c-4faa-9a9c-ae3232562359

	measure 'Average Technical Days' = "5"
		lineageTag: 086e406f-f86f-4260-a565-0b2deb5059c8

	measure Decision_Target = 5
		formatString: 0
		lineageTag: 7a784b2e-b0a4-4f70-afee-7fe099fd9c1c

	measure Draft_Target = 5
		formatString: 0
		lineageTag: 6951569e-23c0-4f31-9f86-626acbf21418

	measure DraftGuage =
			
			SWITCH(
			    TRUE(),
			    MAX('Processing Dates'[draftpermitdurationnum]) <= 5, "#234075",
			    MAX('Processing Dates'[draftpermitdurationnum]) > 5, "#e3a82b")
		lineageTag: 125f15a7-f90b-4788-bac7-2a30abd86347

	measure Intake_Target = 7
		formatString: 0
		lineageTag: 9c9229d8-30b9-41eb-b056-15c3431e8c0c

	measure MaxDraftDuration = [Draft_Target] + 90
		formatString: 0
		lineageTag: 8582eaf7-7b0c-435d-be83-f8fd549a9c86

	measure MaxRefConsDuration = [RefCons_Target] + 90
		lineageTag: 4609d9fb-110c-48a9-a37e-a6d874650bf6

	measure MaxTechReviewDuration = [TechReview_Target] + 90
		lineageTag: aa8c0579-7b65-4cf6-ab2e-8d80d5213478

	measure RefCons_Target = 45
		formatString: 0
		lineageTag: f8bb9291-cbc8-475c-a771-7bae3c03b775

	measure RefConsGuage =
			
			SWITCH(
			    TRUE(),
			    MAX('Processing Dates'[consultationduration_num]) <= 45, "#234075",
			    MAX('Processing Dates'[consultationduration_num]) > 45, "#e3a82b")
		lineageTag: 91419cf4-c09a-44c5-b5a1-a617ea23be19

	measure StageCount = ```
			
			VAR _SelectedOrder = SELECTEDVALUE('Processing Dates'[now_number])
			RETURN 
			IF ( NOT ISBLANK ( _SelectedOrder ),
			COUNTROWS('Processing Dates'))
			```
		formatString: 0
		lineageTag: c1613d98-5a74-4a72-928b-62c8f3d5b1c4

	measure TechRevGuage =
			
			SWITCH(
			    TRUE(),
			    MAX('Processing Dates'[techreviewduration_num]) <= 5, "#234075",
			    MAX('Processing Dates'[techreviewduration_num]) > 5, "#e3a82b")
		lineageTag: 93cfa47e-a23f-4dc3-bbf5-e9049c9bf041

	measure TechReview_Target = 5
		formatString: 0
		lineageTag: 377a0bed-ff3d-47fa-b4af-d43849038e5b

	measure 'Calculated Item' = SELECTEDMEASURE()
		lineageTag: cd6e8891-ed7e-485d-96b4-23eed2769bae

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% of Total' =
			DIVIDE(
			    SELECTEDMEASURE(),CALCULATE(
			        SELECTEDMEASURE()))
		lineageTag: 81e4e53c-91a0-4e88-8228-144eadf6ee90

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure total_app_count = CALCULATE(DISTINCTCOUNT('NoW All'[now_application_guid]),all(Mines[Mine Region]))
		formatString: 0
		lineageTag: f68d8ae9-6951-414e-8a0a-9fa00ed94e50

	measure 'Decision Made Applications' =
			
			VAR DM_APPS = FILTER('NoW Applications NEW', 'NoW Applications NEW'[now_application_status_code] in {"REJ", "NPR", "AIA", "WDN"} && YEAR('NoW Applications NEW'[status_updated_date]) = YEAR(MAX('Calendar'[Date])))
			VAR RESULT = calculate(DISTINCTCOUNT('NoW Applications NEW'[now_application_guid]), DM_APPS)
			RETURN RESULT
		formatString: 0
		lineageTag: 9b82d6da-2da2-46c4-bafc-7a26bbb59822

	measure 'Decision Made Avg Turnaround' =
			
			VAR DM_APPS = FILTER('NoW Applications NEW', 'NoW Applications NEW'[now_application_status_code] in {"REJ", "NPR", "AIA", "WDN"} && YEAR('NoW Applications NEW'[status_updated_date]) = YEAR(MAX('Calendar'[Date])))
			VAR RESULT = AVERAGEX(DM_APPS, 'NoW Applications NEW'[Turnaround])
			RETURN RESULT
		lineageTag: 3f984626-6a3a-4a20-9787-c0f452f113c2

	measure 'Turnaround Diff with Target' = AVERAGE('NoW Applications NEW'[Turnaround]) - Measures_Table[Turnaround Target]
		lineageTag: 5fb40669-9d51-4142-b675-3dcc34773ac4

	measure 'Turnaround Target' = CALCULATE(AVERAGE('Turnaround Target'[Target]),'Turnaround Target'[Year] = YEAR(TODAY()))
		lineageTag: d698c5df-7133-4edc-b120-3f75a93ea207

	measure 'Turnaround Sum' = SUM('NoW Applications NEW'[Turnaround])
		formatString: 0
		lineageTag: cb7ff924-ab7b-49c0-a75c-af1d4f876553

	measure 'Turnaround KPI Title' = ```
			"Current Mineral Turnaround KPI, 
			Target: " & [Turnaround Target]
			```
		lineageTag: 7fb16db2-26a2-4512-b2dc-97caeb269e40

	measure 'Turnaround Dynamic' =
			
			VAR TEMP = SUMMARIZE('NoW Applications NEW','NoW Applications NEW'[now_application_guid],
			                    "Submitted Date", MIN('NoW Applications NEW'[submitted_date]),
			                    "Status", MIN('NoW Applications NEW'[now_application_status_code]),
			                    "Turnaournd", IF(MIN('NoW Applications NEW'[submitted_date]) >= MAX('Calendar'[WeekStartDate]), 0 ,
			                                IF(MIN('NoW Applications NEW'[now_application_status_code]) in {"REJ", "NPR", "AIA", "WDN"}
			                                    && MIN('NoW Applications NEW'[status_updated_date]) <= MAX('Calendar'[WeekStartDate]),
			                                    DATEDIFF(MIN('NoW Applications NEW'[submitted_date]), MIN('NoW Applications NEW'[status_updated_date]),DAY),
			                                    DATEDIFF(MIN('NoW Applications NEW'[submitted_date]), MAX('Calendar'[WeekStartDate]),DAY))
			                                    )
			)
			VAR SUBDATE = MAXX(ALLSELECTED('NoW Applications NEW'), 'NoW Applications NEW'[submitted_date])
			VAR TEST = IF(MIN('NoW Applications NEW'[submitted_date]) <= MAX('Calendar'[WeekStartDate]), 0 , 1)
			VAR RESULT = AVERAGEX(TEMP, [Turnaournd])
			RETURN RESULT
		lineageTag: abd1d060-8339-47cc-8ab9-9e542bb5ed7b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

