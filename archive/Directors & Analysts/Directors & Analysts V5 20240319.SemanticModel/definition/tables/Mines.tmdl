	partition Mines-5d0fd379-bf8a-44de-a93d-4ab6c3be9bdf = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("mds-reporting-pg13-live.postgres.database.azure.com", "mds", [CreateNavigationProperties=false]), "with cte_mine as #(lf)(select row_number() over (partition by m.mine_guid order by mt.update_timestamp desc) rn,#(lf)m.mine_guid, m.mine_no ,m.mine_name , m.mine_region ,m.latitude ,#(lf)case #(lf)#(tab)when latitude<1 then latitude *100 #(lf)#(tab)when latitude<10 then latitude *10#(lf)#(tab)else latitude #(lf)end as ""latitude_cleaned"",#(lf) m.longitude ,m.legacy_mms_mine_status #(lf),mrc.description,mt.mine_tenure_type_code,mttc.description as ""Site_Description""#(lf)from mine m #(lf)left join public.mine_region_code mrc on m.mine_region =mrc.mine_region_code#(lf)left join mine_type mt on mt.mine_guid=m.mine_guid#(lf)left join mine_tenure_type_code mttc on mttc.mine_tenure_type_code=mt.mine_tenure_type_code#(lf))#(lf)select  * from cte_mine where rn=1  ", null, [EnableFolding=false]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"mine_name", "Mine Name"}, {"mine_region", "Mine Region"}, {"mine_no", "Mine No"}, {"mine_tenure_type_code", "Mine_Type"}}),
				    #"Calculated Absolute Value" = Table.TransformColumns(#"Renamed Columns",{{"latitude", Number.Abs, type number}, {"longitude", Number.Abs, type number}}),
				    #"Multiplied Column" = Table.TransformColumns(#"Calculated Absolute Value", {{"longitude", each _ * -1, type number}}),
				    #"Absolute Value: Latitude_Cleaned" = Table.TransformColumns(#"Multiplied Column",{{"latitude_cleaned", Number.Abs, type number}})
				in
				    #"Absolute Value: Latitude_Cleaned"

	annotation PBI_ResultType = Table

