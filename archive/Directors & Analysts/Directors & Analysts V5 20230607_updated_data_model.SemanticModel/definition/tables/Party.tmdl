	partition Party-212f2e14-a0d9-4bee-88d2-005d7f876aa2 = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("mds-reporting-pg13-live.postgres.database.azure.com", "mds"), "select p.party_guid , p.first_name, p.party_name,concat_ws(' '::text, p.first_name, p.party_name) as ""permittee"",p.party_type_code from public.party p #(lf)#(tab)left join public.party_type_code ptc on p.party_type_code = ptc.party_type_code #(lf)#(tab)   ", null, [EnableFolding=false])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

