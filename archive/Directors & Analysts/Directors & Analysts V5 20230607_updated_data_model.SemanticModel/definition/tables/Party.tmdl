table Party
	lineageTag: 7171a8d4-3755-4b3d-8c39-a9bce60b3870

	measure 'Selected Name' = SELECTEDVALUE(Party[permittee],"All")
		displayFolder: Titles
		lineageTag: d9d4af31-82e5-40b2-b4ee-1537085e1dc0

	measure SupervisorReportTitle = COMBINEVALUES(" ",[Supervisor Name],"  ",[Selected Region])
		lineageTag: 0719c038-19e4-40f2-88d8-843d38906faa

	measure 'Selected Region' = SELECTEDVALUE('SupervisorRegion-old'[ mine_region_code])
		lineageTag: 803bf8cf-bdee-41b4-9c13-561f64a76ecc

	measure 'Supervisor Name' = SELECTEDVALUE('SupervisorRegion-old'[ full_name])
		lineageTag: fbaa00e8-00c7-4c8d-9b57-90f93f7a71d9

