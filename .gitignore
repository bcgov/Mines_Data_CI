# Local environment variables - never commit
.env
*.env
.env.*

# Terraform state backups (state files themselves ARE committed per env branch
# by the CD workflow: build/artifacts/terraform-<env>.tfstate)
*.tfstate.backup

# Terraform directories
**/.terraform/
.terraform/

# Terraform lock file (optional: some teams commit this)
# .terraform.lock.hcl

# Terraform plan output
tfplan
*.tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files with sensitive values
*.tfvars.local
secrets.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json


# Misc
terraform-docs-*.tar.gz*
